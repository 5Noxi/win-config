            EMIT_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO = 0x00004000, ""            
            BUILD_RAYTRACING_ACCELERATION_STRUCTURE               = 0x00800000, ""
            COPY_RAYTRACING_ACCELERATION_STRUCTURE                = 0x01000000, ""
            SPLIT                                                 = 0x80000000, ""            
        END_ENUM_LIST
    Default:            0x81807fff
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_DEFERRAL_BARRIER_ACCESS_TYPES
    DefinedWhen:        1
    BinaryID:           0x195789
    RemappedName:       D3D_18976427
    Type:               dword
    Documentation:      "Enable barrier deferral for these barrier access types"
