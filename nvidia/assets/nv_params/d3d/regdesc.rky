            ON,  1, TRUE,  ENABLED   = 1, ""
        END_ENUM_LIST
    Default:        OFF
END_KEY

BEGIN_KEY SCG_D3D12_SMSCG_CONTROL_FLAGS_STATIC
    DefinedWhen:     1
    BinaryID:        0x0b08ec
    RemappedName:    D3D_0x2d2a0f
    Type:            dword
    Documentation:   "Controls SMSCG enable/disable static heuristic"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ENABLE_SMSCG_WITH_DXR                            = 0x1, "Enable SMSCG, even with DXR workloads"
            ENABLE_SMSCG_WITH_META_COMMANDS                  = 0x2, "Enable SMSCG, even with DX meta commands"
            ENABLE_SMSCG_DEFERRED_INIT                       = 0x4, "Wait until async compute queue is used to enable SMSCG"
            ENABLE_SMSCG_FOR_DRIVER_SCG                      = 0x8, "Enable SMSCG on first use of driver SCG (only applies when deferred init is enabled)."
        END_ENUM_LIST
END_KEY

BEGIN_KEY SCG_D3D12_SMSCG_CONTROL_FLAGS_DYNAMIC
    DefinedWhen:     1
    BinaryID:        0x0cc8ec
    RemappedName:    D3D_0x1d3a0f
    Type:            dword
    Documentation:   "Controls SMSCG enable/disable static heuristic"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_SMSCG_BUILD_BVH_COMPUTE                     = 0x00001, "Disable SMSCG for compute command buffers that do BVH build"
            DISABLE_SMSCG_DISPATCH_RAYS_COMPUTE                 = 0x00002, "Disable SMSCG for compute command buffers that do Dispatch Rays"
            DISABLE_SMSCG_EMIT_BVH_INFO_COMPUTE                 = 0x00004, "Disable SMSCG for compute command buffers that do emit BVH info"
            DISABLE_SMSCG_COPY_BVH_COMPUTE                      = 0x00008, "Disable SMSCG for compute command buffers that do copy BVH"
            DISABLE_SMSCG_SET_PIPELINE_STATE_COMPUTE            = 0x00010, "Disable SMSCG for compute command buffers that set DXR pipeline state"
            DISABLE_SMSCG_INIT_META_COMMAND_COMPUTE             = 0x00020, "Disable SMSCG for compute command buffers that init meta commands"
            DISABLE_SMSCG_EXECUTE_META_COMMAND_COMPUTE          = 0x00040, "Disable SMSCG for compute command buffers that execute meta commands"
            DISABLE_SMSCG_LAUNCH_CUBIN_COMPUTE                  = 0x00080, "Disable SMSCG for compute command buffers that execute meta commands"
            DISABLE_SMSCG_COMPUTE_MASK                          = 0x000FF, "Mask of all compute flags"
            DISABLE_SMSCG_BUILD_BVH_DIRECT                      = 0x00100, "Disable SMSCG for direct command buffers that do BVH build"
            DISABLE_SMSCG_DISPATCH_RAYS_DIRECT                  = 0x00200, "Disable SMSCG for direct command buffers that do Dispatch Rays"
            DISABLE_SMSCG_EMIT_BVH_INFO_DIRECT                  = 0x00400, "Disable SMSCG for direct command buffers that do emit BVH info"
            DISABLE_SMSCG_COPY_BVH_DIRECT                       = 0x00800, "Disable SMSCG for direct command buffers that do copy BVH"
            DISABLE_SMSCG_SET_PIPELINE_STATE_DIRECT             = 0x01000, "Disable SMSCG for direct command buffers that set DXR pipeline state"
            DISABLE_SMSCG_INIT_META_COMMAND_DIRECT              = 0x02000, "Disable SMSCG for direct command buffers that init meta commands"
            DISABLE_SMSCG_EXECUTE_META_COMMAND_DIRECT           = 0x04000, "Disable SMSCG for direct command buffers that execute meta commands"
            DISABLE_SMSCG_LAUNCH_CUBIN_DIRECT                   = 0x08000, "Disable SMSCG for direct command buffers that execute meta commands"
            DISABLE_SMSCG_DIRECT_MASK                           = 0x0FF00, "Mask of all direct flags"
            DISABLE_SMSCG_DEFAULT_COMPUTE                       = 0x10000, "Flag disables SMSCG on compute command buffers that do not use DXR or Meta Commands"
            DISABLE_SMSCG_DEFAULT_DIRECT                        = 0x20000, "Flag disables SMSCG on direct command buffers that do not use DXR or Meta Commands"
        END_ENUM_LIST
    Default:        0
END_KEY

