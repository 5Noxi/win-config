    RemappedName:       D3D_0x0e3595
    Type:               bool
    Documentation:      "Control TTU usage in DXR (if TTU HW support exists)"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED, DONOTUSETTU     = 0, "Force DXR to not use the TTU"
            ON,  1, TRUE,  ENABLED,  USETTU          = 1, "Default behavior. Use TTU when available"
        END_ENUM_LIST
    Default: ON
END_KEY

BEGIN_KEY DXR_BVH_BUILD_BATCHING
    DefinedWhen:     1
    BinaryID:        0x72ca18
    RemappedName:    D3D_0x72ca18
    Type:            bool
    Documentation:   "Enable Batching of BVH builds"
    AppProfile
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x00000000, ""
            ON,  1, TRUE,  ENABLED   = 0x00000001, ""
        END_ENUM_LIST
	Default: ON
END_KEY

BEGIN_KEY DXR_BVH_BUILD_BATCHING_FLAGS
    DefinedWhen:     1
    BinaryID:        0x225c2b
    RemappedName:    D3D_0x225c2b
    Type:            dword
    Documentation:   "BVH build batching options"
    AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                                         = 0x00000000, "No Flags"
            HAZARD_CHECK_ALL_TRANSITIONS                 = 0x00000001, "All resource transitions trigger a hazard check"
            HAZARD_CHECK_ALL_BARRIERS                    = 0x00000002, "All barrier types trigger a hazard check"
            VALIDATE_SCRATCH_AND_RTAS_MEM                = 0x00000004, "Check for missed scratch and RTAS hazards before every build and issue additional barriers as needed"
            UNUSED                                       = 0x00000008, "Unused Flag"
            FLUSH_ON_COPY                                = 0x00000010, "Flush bvh builds on every copyRTAS call"
            FLUSH_ON_EMIT                                = 0x00000020, "Flush bvh builds on every emitRTAS call"
            FLUSH_ON_DISPATCHRAYS                        = 0x00000040, "Flush bvh builds on every dispatchRays call"
            FLUSH_ON_BARRIER, IGNORE_VA_RANGES           = 0x00000080, "Flush bvh builds whenever a barrier is issued"
            ALWAYS_FLUSH_AFTER_BATCH, FORCE_SINGLE_BATCH = 0x80000000, "Forces a flush immediately after batching. Effectively forces batch size of 1"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_BVH_BUILD_FLAG_FORCE_DISABLE_MASK
    DefinedWhen:     1
    BinaryID:        0x4208bd
    RemappedName:    D3D_0x4208bd
    Type:            dword
    Documentation:   "Clear specific BVH build flags. Applied before DXR_BVH_BUILD_FLAG_FORCE_ENABLE_MASK."
    AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                       = 0x00000000, "No flags"
            ALLOW_UPDATE               = 0x00000001, "BVH may be updated"
            ALLOW_COMPACTION           = 0x00000002, "BVH may be compacted"
            PREFER_FAST_TRACE          = 0x00000004, "Prefer trace over build performance"
            PREFER_FAST_BUILD          = 0x00000008, "Prefer build over trace performance"
            MINIMIZE_MEMORY            = 0x00000010, "Minimize memory usage, possibly at the cost of build and/or trace performance"
            PERFORM_UPDATE             = 0x00000020, "Perform update"
            MASK                       = 0x0000003F, "Mask of all flags"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_BVH_BUILD_FLAG_FORCE_ENABLE_MASK
    DefinedWhen:     1
    BinaryID:        0xf4ef16
    RemappedName:    D3D_0xf4ef16
    Type:            dword
    Documentation:   "Set specific BVH build flags. Applied after DXR_BVH_BUILD_FLAG_FORCE_DISABLE_MASK."
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                       = 0x00000000, "No flags"
            ALLOW_UPDATE               = 0x00000001, "BVH may be updated"
            ALLOW_COMPACTION           = 0x00000002, "BVH may be compacted"
            PREFER_FAST_TRACE          = 0x00000004, "Prefer trace over build performance"
            PREFER_FAST_BUILD          = 0x00000008, "Prefer build over trace performance"
            MINIMIZE_MEMORY            = 0x00000010, "Minimize memory usage, possibly at the cost of build and/or trace performance"
            PERFORM_UPDATE             = 0x00000020, "Perform update"
            MASK                       = 0x0000003F, "Mask of all flags"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_PIPELINE_TYPE
    DefinedWhen:     1
    BinaryID:        0x473934
    RemappedName:    D3D_0x473934
    Type:            dword
    Documentation:   "Override the default scheduler"
	AppProfile
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            MEGAKERNEL_SIMPLE = 0x00000000, "Straightforward megakernel scheduling." 
            BLOCKSYNC         = 0x00000001, "Megakernel scheduling with intra CTA synchonized."
        END_ENUM_LIST
    Default: MEGAKERNEL_SIMPLE
END_KEY

BEGIN_KEY DXR_PIPELINE_FLAGS
    DefinedWhen:     1
    BinaryID:        0x473935
    RemappedName:    D3D_0x473935
    Type:            dword
    Documentation:   "Extra flags passed to DXR shader compiles and pipeline creation"
  AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE              = 0x00000000, "No flags." 
            TRIANGLES_ONLY    = 0x00000200, "Cull custom primitives and optimize the pipeline for triangles."
            AABBS_ONLY        = 0x00000100, "Cull triangles and optimize the pipeline for custom primitives."
            DISABLED          = 0xFF000000, "Don't propagate flags from application."
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_PIPELINE_RECOMPILE_MODULE_THRESHOLD
    DefinedWhen:     1
    BinaryID:        0x5ec6ef
    RemappedName:    D3D_5ec6ef
    Type:            dword
    Documentation:   "Allow recompilation of modules at pipeline creation if there are at most this number of modules."
    Default:         0x14
    AppProfile
END_KEY

BEGIN_KEY DXR_RG_CONTINUATION_REGS
    DefinedWhen:        1
    BinaryID:           0x50a154
    RemappedName:       D3D_0x50a154
    Type:               dword
    Documentation:      "Number of registers to reserve for raygen continuation state"
    AppProfile
    Default:            0x0
END_KEY

BEGIN_KEY DXR_USE_FAST_LINKING
    DefinedWhen:        1
    BinaryID:           0x50a155
    RemappedName:       D3D_0x50a155
    Type:               dword
    Documentation:      "Allows to override the default linking behaviour in RTCore for pipeline creation."
    AppProfile
    Values: Bitfields
    BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "Disable fast linking and fallback to normal CUDA style linking."
            ON,  1, TRUE,  ENABLED                          = 0x00000001, "Use fast linking during compilation and pipeline creation." 
    END_ENUM_LIST
    Default: ENABLED
END_KEY

BEGIN_KEY DXR_BOOTSTRAP_USAGE
    DefinedWhen:        1
    BinaryID:           0xc08a4e
    RemappedName:       D3D_0xc08a4e
    Type:               bool
    Documentation:      "Control usage of bootstrap kernel"
    AppProfile
    Values: Bitfields
    BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "Never use bootstrap kernel (WARNING: DXR 1.1 and CFGPU depend on bootstrap kernel)"
            ON,  1, TRUE,  ENABLED                          = 0x00000001, "Always use bootstrap kernel"
    END_ENUM_LIST
    Default: ENABLED
END_KEY

BEGIN_KEY DXR_RAYGEN_SCHEDULER_OVERRIDE_PATTERNS
    DefinedWhen:    1
    BinaryID:       0x6ea049
    RemappedName:   D3D_0x6ea049
    Type:           wstring
    Documentation:  "Comma-separated list of raygen shader names for which to override the scheduler selection. Wildcards allowed. Corresponds to shader list in DXR_RAYGEN_SCHEDULER_OVERRIDE_TYPES."
    AppProfile
    Default:        L""
END_KEY

BEGIN_KEY DXR_RAYGEN_SCHEDULER_OVERRIDE_TYPES
    DefinedWhen:    1
    BinaryID:       0x1f0ede
    RemappedName:   D3D_0x1f0ede
    Type:           wstring
    Documentation:  "Comma-separated list of scheduler names, corrseponding to the list of shader names specified by DXR_RAYGEN_SCHEDULER_OVERRIDE_PATTERNS. If fewer elements than pattern list, last entry is used for remaining patterns."
    AppProfile
    Default:        L"BLOCKSYNC"
END_KEY

BEGIN_KEY DXR_ENABLE_COROUTINES
    DefinedWhen:        1
    BinaryID:           0x50a156
    RemappedName:       D3D_0x50a156
    Type:               dword
    Documentation:      "Use coroutines instead of shader splitting for trace calls."
    AppProfile
    Values: Bitfields
    BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "Use shader splitting for trace calls."
            ON,  1, TRUE,  ENABLED                          = 0x00000001, "Use coroutines for trace calls."
    END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY DXR_RG_INLINE_MODE
    DefinedWhen:     1
    BinaryID:        0x50a159
    RemappedName:    D3D_0x50a159
    Type:            dword
    Documentation:   "Mode for inlining other shaders into raygen shader when trace depth <= 1"
    AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED    = 0x00000000, "Disabled"
            AUTO        = 0x00000001, "Auto inline with rtcore heuristic"
            ALWAYS      = 0x00000002, "Always inline when the trace depth <= 1"
        END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY RAYQUERY_OR_FLAGS
    DefinedWhen:     1
    BinaryID:        0x50a157
    RemappedName:    D3D_0x50a157
    Type:            dword
    Documentation:   "Inline ray query template flags are bitwise ORed with this value"
