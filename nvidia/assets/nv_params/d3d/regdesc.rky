BEGIN_KEY HOPPER_TEXTURE_HEADER_VERSION
    DefinedWhen:        1
    BinaryID:           0x201030
    RemappedName:       D3D_0x20201030
    Type:               bool
    Documentation:      "Select whether to use the new Hopper texture headers (set to 1) or prior chip texture header (set to 0).  Temporary - only for the transition period to the new texture headers."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0 , "Use Maxwell-style Texture Headers"
            ON,  1, TRUE,  ENABLED   = 1 , "Use Hopper-style Texture Headers"
        END_ENUM_LIST
    Default:            1
END_KEY

BEGIN_KEY FORCE_GPUKERNEL_COP_ARCH
    DefinedWhen:        1
    BinaryID:           0xC09C09
    RemappedName:       D3D_C09C09
    Type:               dword
    Documentation:      "Override GPU kernel to use different SM that the default, most of the values are from copi_type.h COP_ARCH_VARIANTs"
    Values: Samples
        BEGIN_ENUM_LIST
            DEFAULT_GPU_KERNEL      = 0, "Use default GPUKernel"
            USE_AMPERE_SM8_2        = 0x7001, "Use Ampere SM 8.2"
            USE_AMPERE_SM8_6        = 0x7002, "Use Ampere SM 8.6"
            USE_ADA_SM8_9           = 0x7005, "Use Ada SM 8.9"
            USE_HOPPER_SM9_0        = 0x8000, "Use Hopper SM 9.0"
            USE_HOPPER_SM9_0_TRIM   = 0x80008000, "Use Hopper SM 9.0 built with different flags"
        END_ENUM_LIST
    Default:            DEFAULT_GPU_KERNEL
END_KEY

BEGIN_KEY ASSERT_ON_SHADER_FP64
    DefinedWhen:        1
    BinaryId:           0x220125
    RemappedName:       D3D_220125
    Type:               bool
    Documentation:      "Assert during shader compilation if a floating point double precision instruction is used."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "Normal operation"
            ON,  1, TRUE,  ENABLED   = 1, "Assert if using fp64 in a shader"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY HWS_ATOMIC_SUBMIT_WAR
    DefinedWhen:        1
    BinaryID:           0xfa505b
    RemappedName:       D3D_0xfa505b2a
    Type:               bool
    Documentation:      "Enable/Disable the HWS atomic submission WAR (https://nvbugs/3371068)"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "Force atomic hw queue submission off"
            ON,  1, TRUE,  ENABLED   = 1, "Enable atomic hw queue submission on HWS"
        END_ENUM_LIST
    Default:            TRUE
END_KEY

BEGIN_KEY DX12_COMMAND_ALLOCATOR_IGNORE_RESETS
