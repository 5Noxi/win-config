            BREAK_ON_D3DDDIERR_DEVICEREMOVED      = 0x0010, ""
            BREAK_ON_E_OUTOFMEMORY                = 0x0020, ""
            BREAK_ON_DXGI_DDI_ERR_NONEXCLUSIVE    = 0x0040, ""
            BREAK_ON_DXGI_DDI_ERR_WASSTILLDRAWING = 0x0080, ""
            BREAK_ON_DXGI_DDI_ERR_UNSUPPORTED     = 0x0100, ""
            BREAK_ON_E_INVALIDARG                 = 0x0200, ""
