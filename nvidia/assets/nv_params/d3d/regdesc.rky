BEGIN_KEY QMD_SM_DISABLE_MASK
    DefinedWhen:    1
    BinaryID:       0x15ba22
    RemappedName:   D3D_0x15ba22
    Type:           qword
    Documentation:  "The bits (0-63) of the SM Disable Mask. A 1 in any bit position means that SM (TPC in Volta+) will not run CTAs launched from the QMD"
    Default:        0
END_KEY          

BEGIN_KEY QMD_SM_DISABLE_MASK_FLAGS
    DefinedWhen:    1
    BinaryID:       0xc29b07
    RemappedName:   D3D_0xc29b07
    Type:           dword
    Documentation:  ""
    Values: Bitfields
        BEGIN_ENUM_LIST
            APPLY_MASK_TO_COD       = 0x00000001, "Apply SM_DISABLE_MASK to QMD's launched from the Compute Only Device"
            APPLY_MASK_TO_D3D       = 0x00000002, "Apply SM_DISABLE_MASK to QMD's launched from the D3D Device"
        END_ENUM_LIST
    Default:        0
END_KEY

BEGIN_KEY QMD_SM_DISABLE_MASK_ROTATE_MODE
    DefinedWhen:        1
    BinaryID:           0xbe4587
    RemappedName:       D3D_0xbe4587
    Type:               dword
    Documentation:      "Use affinity mask to only enable a fraction of the SMs (TPC in Volta+) for small dispatches, in order to cut down on task sync serialization"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF            = 0x0, "All SMs enabled"
            HALF           = 0x1, "Half SMs enabled"
            QUARTER        = 0x2, "Quarter SMs enabled" 
            MODE_MASK      = 0xFF,""

            DISALLOW_SYNC  = 0x40000000, "Disallow use of rotated mask for sync compute queues"
            DISALLOW_ASYNC = 0x80000000, "Disallow use of rotated mask for async compute queues"
        END_ENUM_LIST
    Default:            QUARTER
END_KEY

BEGIN_KEY QMD_SM_DISABLE_MASK_ROTATE_USER_LIMIT
    DefinedWhen:        1
    BinaryID:           0xbe6542
    RemappedName:       D3D_0xbe6542
    Type:               dword
    Documentation:      "Enable the affinity mask only for grids less or equal to this size. 0 means use heuristics"
    Default:            0x0
END_KEY

