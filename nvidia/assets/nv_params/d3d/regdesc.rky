            DUMP_HEX_SPH                                                        = 0x00000001, "Dump hex version of Shader Program Header"
            DELETE_EMPTY_DUMP_FILES                                             = 0x00000002, "If a psdbgXXX/statsXXX.txt file has no shaders associated with it, delete it (cruft reduction)."
