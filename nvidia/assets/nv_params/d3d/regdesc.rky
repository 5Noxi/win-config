        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                                     = 0, "Disable the failure injection shim"
            ON,  1, TRUE,  ENABLED                                      = 1, "Enable the failure injection shim"
        END_ENUM_LIST
    Default: OFF
END_KEY

