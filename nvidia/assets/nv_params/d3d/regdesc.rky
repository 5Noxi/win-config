//---------------------------------------------------------------------------
//
// DX key to force OCG to use phase ordering when compiling.
// 
//---------------------------------------------------------------------------

BEGIN_KEY D3D_OCGCONTROL_DRIVE_COMPILE
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe107d8
    RemappedName:       D3D_OCGCONTROL_DRIVE_COMPILE
    Type:               bool
    Documentation:      "Master on / off switch for OCG compiler driver."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x12542653, ""
            ON,  1, TRUE,  ENABLED   = 0x78260374, ""
        END_ENUM_LIST
    Default:            OFF
END_KEY
  
BEGIN_KEY D3D_OCGCONTROL_DRIVE_COMPILE_FLAGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe107d9
    RemappedName:       D3D_OCGCONTROL_DRIVE_COMPILE_FLAGS
    Type:               dword
    Documentation:      "Settings for OCG compilation steering."
    Values: Bitfields
        BEGIN_ENUM_LIST
            USE_ALWAYS      = 0x00000001, "" // Force OCG compilation steering
            RANDOM_ORDER    = 0x00000002, "" // Force random phase order
            VALIDATION      = 0x00000004, "" // Force input validation
            SPACE_SEARCH    = 0x00000008, "" // Enable interaction with external entity
            DEBUG_OUTPUT    = 0x00000010, "" // Enable tracing via debug dumps
            AGGRESSIVE      = 0x00000020, "" // Enable aggressive compilation (heuristics off)
            HASH_COPARGS    = 0x00000040, "" // Enable hashing of COP arguments
            TRIMMED_VECTORS = 0x00000080, "" // Spit out normalized opt sequences
        END_ENUM_LIST
    Default:            0
END_KEY

//---------------------------------------------------------------------------

BEGIN_KEY VOLTA_UAV_L1_CACHE_OCGCONTROL
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe07348
    RemappedName:       D3D_e07348
    Type:               dword
    Documentation:      "Enable control for L1 caching of surface instructions."
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_FOR_SULD   = 0x00000001, "force SYS scope (disables L1 caching) for SULD instructions of non-coherent UAVs"
            DISABLE_FOR_SUST   = 0x00000002, "force SYS scope (disables L1 caching) for SUST instructions of non-coherent UAVs"
            ALLOW_FOR_SUATOM   = 0x00000004, "force CTA scope (ENABLES L1 caching) for SUATOM/SURED instructions UAVs. This is generally disallowed by the DX spec"
        END_ENUM_LIST
    Default:            0
END_KEY


