            APPLY_TO_ALL_SHADERS               =  1, "Apply Compute CTA Throttling to all compute shaders"
            APPLY_TO_SPECIFIC_SHADERS          =  2, "Apply Compute CTA Throttling to only shaders selected as per PS_COMPUTE_SHADER_HASH"
