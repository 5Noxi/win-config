            DIVERGENT_ONLY      = 0x01, "Only translate divergent, dynamically-indexed LDCs"
            ALL_DYNAMIC_INDEXED = 0x02, "Translate all dynamically-indexed LDCs"
            ALL                 = 0x03, "Translate ALL LDCs"
        END_ENUM_LIST
    Default:         DISABLED
