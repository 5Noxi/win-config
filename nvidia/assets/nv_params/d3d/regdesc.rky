BEGIN_KEY SHARPEN_ALLOW
DefinedWhen:        1
    BinaryID:           0x598949
    RemappedName:       D3D_598949
    Type:               dword
    Documentation:      "Empowers an app profile to opt in or opt out of the Sharpen filter.  Default for OpenGL is to be allowed.  Default for dx9/dx11/dx12 is to disable sharpening.  If Optimus Profile designates the current app, to run on the discrete GPU, then sharpen will be allowed."
    UserVisible
    UserVisibleName:    "NVIDIA Predefined Sharpen Usage"
    NvInternalSetting
    OverInstallBehavior: MERGE
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DISALLOWED,        0, OFF, DISABLED = 0, "Sharpen is not allowed"
            OPENGL_ALLOWED = 0x1,   "Sharpen is allowed for OpenGL, value fits in one bit"
            DX9_ALLOWED    = 0x2,   "Sharpen is allowed for DX9"
            DX11_ALLOWED   = 0x4,   "Sharpen is allowed for DX11"
            DX12_ALLOWED   = 0x8,   "Sharpen is allowed for DX12"
            ALLOWED        = 0xF, "Sharpen is allowed for DX9, DX11, DX12, and OPENGL"
        END_ENUM_LIST
        Default: OPENGL_ALLOWED               
END_KEY

