            FORCE_WFI                    = 1, "Use WFI (non-SCG default)"
            FORCE_SEMAPHORE              = 2, "Use semaphores"
            MODE_CONTROL_MASK            = 0xFF, "The mask for the field representing above modes"

            FORCE_HOST_WAIT              = 0x100, "A flag to force WFI path using host waits instead of WFI invalidates"
        END_ENUM_LIST
    Default:        DRIVER_CONTROLLED
