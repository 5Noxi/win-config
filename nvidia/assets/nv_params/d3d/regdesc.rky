    Documentation:   "Control command list promotion behavior"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            ENABLE_WITH_DDI_SHIMS                   = 0x01, "Enable command list promotion in the presence of DDI shims (can be dangerous)"
            ENABLE_FOR_MULTIPLE_DIRECT_QUEUES_ONLY  = 0x02, "Only enable when we have multiple direct command queues"
            ENABLE_COPY_PROMOTION                   = 0x04, "Enable single copy only promotion"
            ENABLE_BARRIER_PROMOTION                = 0x08, "Enable barrier only promotion"
            ENABLE_DXR_PROMOTION                    = 0x10, "Enable DXR only promotion"
            ENABLE_COMPUTE_PROMOTION                = 0x20, "Enable promotion for all compute work"
        END_ENUM_LIST
    Default:        ENABLE_BARRIER_PROMOTION|ENABLE_DXR_PROMOTION
END_KEY

BEGIN_KEY D3D12_ENHANCED_BARRIER_SUPPORT
    DefinedWhen:    1
    BinaryID:       0xba41e3
    RemappedName:   D3D_0xba41e3
    Type:           bool
    Documentation:  "Controls reporting of D3D12DDI_D3D12_OPTIONS_DATA_0089::EnhancedBarriersSupported - used to avoid runtime barrier promotion or API support for them"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, ""
            ON,  1, TRUE,  ENABLED   = 1, ""
        END_ENUM_LIST
    Default:        ON
END_KEY

BEGIN_KEY D3D12_RESOURCE_BARRIER_TO_ENHANCED_BARRIER_PROMOTION
    DefinedWhen:     1
    BinaryID:        0xba41e4
    RemappedName:    D3D_0xba41e4
    Type:            dword
    Documentation:   "Control D3D12's legacy resource barrier to enhanced barrier promotion"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            ENABLE_TRANSITION       = 0x01, "Promote transition barriers"
            ENABLE_UAV              = 0x02, "Promote UAV hazard barrier"
            ENABLE_ALIASING         = 0x04, "Promote tiled resource aliasing hazards"
            ENABLE_RANGED           = 0x08, "Promote ranged barriers"
            ENABLE_GENERAL          = 0x10, "Promote all barriers"
            ENABLE_COMPUTE_ONLY     = 0x20, "Promote only compute barriers"
        END_ENUM_LIST
    Default:        ENABLE_TRANSITION|ENABLE_UAV|ENABLE_ALIASING|ENABLE_RANGED|ENABLE_GENERAL|ENABLE_COMPUTE_ONLY
END_KEY 

BEGIN_KEY SHADER_HEAP_WDDM2_MULTIBLOCK_RESERVE_VA_SIZE
    DefinedWhen:    1
    BinaryID:       0x1abc0f
    RemappedName:   D3D_0x1abc0f
    Type:           dword
    Documentation:  "Sets the amount of VA space in bytes reserved for the shader heap (must be in multiple of 64kb). This is only on Win10+ for Dx1X & Dx12 ( Dx1X requires SHADER_HEAP_MULTIBLOCK_ENABLE ). There are separate default enums for DX11 and DX12 (DX12 requires additional space for DXR shaders) which should be selected at runtime"
    Values: Samples
        BEGIN_ENUM_LIST
            DEFAULT_DX11 = 0x10000000, "DX11 Default Size (256MB)"
            DEFAULT_DX12 = 0x20000000, "DX12 Default Size (512MB)"
        END_ENUM_LIST
    Default: DEFAULT_DX11
END_KEY

BEGIN_KEY SHADER_HEAP_WDDM2_DX1X_MULTIBLOCK_ENABLE
    DefinedWhen:    defined(DEBUG) || defined(DEVELOP)
    BinaryID:       0x1adc01
    RemappedName:   D3D_0x1adc01
    Type:           bool
    Documentation:  "to use the shader heap multiblock allocation with reserved VA. This will affect Dx1x on Win10+ (Dx12 is hardcoded enabled). When this is set to OFF it fallbacks to resize/grow ShaderHeap (used on win7/8), Will work only on debug & develop drivers. This is designed for Volta since Volta require shader VA unlike offset in older chips and older ShaderHeap resize/grow would preserve offset but change VA. If you want to avoid multiple allocation ( Dx11 / Dx12 ) use big enough size of ShaderHeap so grow can be avoided. (FERMI_SHADER_HEAP_SIZE)"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, " "
            ON,  1, TRUE,  ENABLED   = 1, "Use default"
        END_ENUM_LIST
    Default:        ON
END_KEY

BEGIN_KEY DX12_HW_ROOT_TABLE_FLAGS
    DefinedWhen:    PERF_STRATEGY_REGKEYS
    BinaryID:       0x1bbb11
    RemappedName:   D3D_0x1bbb11
    Type:           dword
    Documentation:  "Turing adds a new type of constant buffer which is more deeply versioned and has lower latency than traditional constant buffer."
    Values: Bitfields
        BEGIN_ENUM_LIST
            REORDER_AND_GROUP_PARAMETERS         = 0x00000001, "if set, splits parameters into Pixel Shader visible & not visible groups (multiple of 32DWORD hw supported granularity). And reorder even sized parameters to have even VA/offset in root table. That will make OCG generate ULDC.64 instead of two ULDC.32"
        END_ENUM_LIST
    Default:        REORDER_AND_GROUP_PARAMETERS
END_KEY

BEGIN_KEY TURING_MONITORED_FENCE_FLAGS
    DefinedWhen:    PERF_STRATEGY_REGKEYS
    BinaryID:       0x1bbbbb
    RemappedName:   D3D_0x1bbbbb
    Type:           dword
    Documentation:  "Turing adds monitored fence(conditional trap). This will be used for hw testing purpose only (http://nvbugs/200327547)."
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE                             = 0x00000000, "legacy behaviour, does not use turing conditional trap."
            ENABLE                              = 0x00000001, "if set uses monitored fence(conditional trap) for refCount hasReached."
            FORCE_COMPUTE_ON_3D                 = 0x00000040, "if set uses Compute monitored fence(conditional trap) for refCount instead of 3D."
            ENABLE_COMPUTE_DX1x_SCG             = 0x00000020, "if set uses Compute interrupt on helper channel for NvAPI SCG."
            FORCE_CE_ON_3D                      = 0x00000080, "if set uses Copy monitored fence(conditional trap) for refCount instead of 3D."
            IGNORE_CE_HW_WAR                    = 0x00000004, "if set ignores CE additional dummy fence write for CE HW WAR."
            IGNORE_HASHVA_RELEASE               = 0x00000002, "if set release 1 to hash VA skipped."
            ENABLE_LEGACY                       = 0x00000010, "if set uses unconditional interrupt on pre-Turing (can be used for Pascal)."
            ENABLE_DBG_PRINT                    = 0x00000100, "if set prints debug traces with GPU/CPU VA and methods push."
        END_ENUM_LIST
    Default:        DISABLE
END_KEY

BEGIN_KEY DISABLE_64_BIT_REFERENCE_COUNT
    DefinedWhen:    1
    BinaryID:       0x190410
    RemappedName:   D3D_0x190410
    Type:           bool
    Documentation:  "Disable 64-bit reference counts; fallback to 32-bit reference counts.  Relevant on GA10x+."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED = 0x000000000, "GA10x+ uses 64-bit values for reference counts."
            ON,  1,  TRUE, ENABLED  = 0x000000001, "GA10x+ uses 32-bit values for reference counts"
        END_ENUM_LIST
    Default: OFF
END_KEY

