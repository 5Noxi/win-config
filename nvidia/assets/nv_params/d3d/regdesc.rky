//---------------------------------------------------------------------------
//
// Dx9, Dx10 keys to enable COP to bypass DAG IR and convert nvInst directly to internal IR
// 
// DO NOT change the values of the enums.  They currently match the enums used by OCG
//---------------------------------------------------------------------------

BEGIN_KEY D3D9_OCGCONTROL_DIRECT_NVIR
    DefinedWhen:    1
    RemappedName:   D3D_28549468
    BinaryID:       0xe107d3
    Type:           dword
    Documentation:  "Controls OCG support for processing nvInst shaders in Dx9.  Legacy support converts nvInst to a DAG; newer code converts it directly to NVIR (instruction list) form."
    Values:         Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DEFAULT       = 0x0, "Use driver default behavior"
            FORCE_ENABLE  = 0x1, "Enable direct nvInst->NVIR conversion, regardless of defaults"
            FORCE_DISABLE = 0x2, "Disable direct nvInst->NVIR conversion, regardless of defaults"
        END_ENUM_LIST
        Default:          DEFAULT
END_KEY

BEGIN_KEY D3D1X_OCGCONTROL_DIRECT_NVIR
    DefinedWhen:    1
    RemappedName:   D3D_78452826
    BinaryID:       0xe107d4
    Type:           dword
    Documentation:  "Controls OCG support for processing nvInst shaders in Dx1x.  Legacy support converts nvInst to a DAG; newer code converts it directly to NVIR (instruction list) form."
    Values:         Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DEFAULT       = 0x0, "Use driver default behavior"
            FORCE_ENABLE  = 0x1, "Enable direct nvInst->NVIR conversion, regardless of defaults"
            FORCE_DISABLE = 0x2, "Disable direct nvInst->NVIR conversion, regardless of defaults"
        END_ENUM_LIST
        Default:          DEFAULT
END_KEY


