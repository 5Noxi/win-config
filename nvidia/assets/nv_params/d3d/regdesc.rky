            DISABLED, OFF, FALSE = 0x0, "All Metacommands disabled"
            ENABLED_PREFERRED    = 0x1, "Enabled for preferred problem sizes."
            ENABLED_FORCED       = 0x2, "Enabled for all supported problem sizes."
        END_ENUM_LIST
