BEGIN_KEY SCGLOG_QUERY_MASK
    DefinedWhen:     PERF_STRATEGY_REGKEYS
    BinaryID:        0xa2efc7
    RemappedName:    D3D_0xa2efc7
    Type:            dword
    Documentation:   "controls which queries are dumped into SCGLOG"
    Values: Bitfields
        BEGIN_ENUM_LIST
            GRAPHICS_ACTIVE_CYCLES  = 0x001, "GraphicsActiveCycles, the total number of clocks where any graphics resource is occupied."
            COMPUTE_ACTIVE_CYCLES   = 0x002, "ComputeActiveCycles, the total number of clock where any compute resource is occupied."
            IDLE_CYCLES             = 0x004, "IdleCycles, the total number of clocks where no graphics or compute resource is occupied."
            GRAPHICS_OCCUPANCY      = 0x008, "GraphicsOccupancyWithIsbes, the graphics resource occupancy as a percentage, based on the usage of warp IDs, LRF, GFXTRAM, and ISBEs."
            UNUSED_0                = 0x010, "Not used."
            DEBUG_COUNTER           = 0x020, "Usage varies based on NV_PGRAPH_PRI_GPCS_TPCS_MPC_VTG_DEBUG bits[10:9]."
            COMPUTE_OCCUPANCY       = 0x040, "ComputeOccupancy, the compute resource occupancy as a percentage, based on the usage of warp IDs, LRF, shared memory, barrier and CTA IDs."
            UNUSED_1                = 0x080, "Not used."
        END_ENUM_LIST
    Default:         (GRAPHICS_ACTIVE_CYCLES | COMPUTE_ACTIVE_CYCLES | IDLE_CYCLES | GRAPHICS_OCCUPANCY | COMPUTE_OCCUPANCY | DEBUG_COUNTER)
END_KEY

