            FORCE_P2P_WRITES            = 0x00000001, "Use P2P Writes for resolve"
            FORCE_P2P_READS             = 0x00000002, "Use P2P Reads for resolve"
            FORCE_ENABLE_SW_SEMAPHORES  = 0x00000004, "Override SW semaphore disablement"
        END_ENUM_LIST
