    DefinedWhen:        1
    BinaryID:           0x0d53e5
    RemappedName:       D3D_A6489764
    Type:               dword
    Documentation:      "positively shift z to accomodate apps that give us slightly negative z"
    Values: Range
        BEGIN_ENUM_LIST
            MIN                                                             = 0, ""
            MAX                                                             = 10, ""
        END_ENUM_LIST
    Default:            MIN
END_KEY

BEGIN_KEY AA_QUAD_LINE_WIDTH
    DefinedWhen:        1
    BinaryID:           0x82d8cc
    RemappedName:       D3D_82d8cc
    Type:               float
    Documentation:      "Defines the line width used when rendering quadrilateral lines"
    Default:            1.0f
END_KEY

BEGIN_KEY RIDSHIM_SINGLE_FRAME_HOTKEY
    DefinedWhen:    1
    BinaryID:           0x21df13
    RemappedName:   D3D_34578957
    Type:           dword
    Documentation:  "Specify the hotkey for capturing a single frame in the RIDShim as an ascii value. For example, VK_F7 would be 76."
END_KEY

BEGIN_KEY RIDSHIM_TOGGLE_HOTKEY
    DefinedWhen:    1
    BinaryID:           0x9f9ef5
    RemappedName:   D3D_34578958
    Type:           dword
    Documentation:  "Specify the hotkey to be used for toggling the RIDShim device on and off. For example, VK_F7 would be 76."
END_KEY

BEGIN_KEY RIDSHIM_BASEDIR
    DefinedWhen:    1
    BinaryID:           0xf5f9df
    RemappedName:   D3D_34578955
    Type:           string
    Documentation:  "Sets the base directory for files and logs dumped by RIDShim - note that the path to this directory must already exist."
END_KEY

BEGIN_KEY RIDSHIM_FRAMES
    DefinedWhen:    1
    BinaryID:           0x102480
    RemappedName:   D3D_34578956
    Type:           string
    Documentation:  "A string specifying which frame numbers to generate images for. Example: To dump frame 0, frames 10 through 15, and all frames after frame 100 you would set this string to '0,10-15,100...'"
END_KEY

BEGIN_KEY RIDSHIM_IMAGE_FORMAT
    DefinedWhen:    1
    BinaryID:           0xbf6505
    RemappedName:   D3D_34578959
    Type:           string
    Documentation:  "The type of image format. Valid types are: BMP, PPM, PNG, DDS, EXR. EXR, PPM and DDS are uncompressed. EXR is for bit-accurate (>8 bit) formats but produces the largest files."
END_KEY

BEGIN_KEY RIDSHIM9_SINGLE_FRAME_HOTKEY
    DefinedWhen:        1
    BinaryID:           0x21df14
    RemappedName:   D3D_34578977
    Type:           dword
    Documentation:  "Specify the hotkey for capturing a single frame in the RIDShim as an ascii value. For example, VK_F7 would be 76."
END_KEY

BEGIN_KEY RIDSHIM9_TOGGLE_HOTKEY
    DefinedWhen:        1
    BinaryID:           0x9f9e95
    RemappedName:   D3D_34578978
    Type:           dword
    Documentation:  "Specify the hotkey to be used for toggling the RIDShim device on and off. For example, VK_F7 would be 76."
END_KEY

BEGIN_KEY RIDSHIM9_BASEDIR
    DefinedWhen:    1
    BinaryID:           0xf5fddf
    RemappedName:   D3D_34578945
    Type:           string
    Documentation:  "Sets the base directory for files and logs dumped by RIDShim - note that the path to this directory must already exist."
END_KEY

BEGIN_KEY RIDSHIM9_DRAW_RANGE
    DefinedWhen:        1
    BinaryID:           0x102380
    RemappedName:   D3D_34577956
    Type:           string
    Documentation:  "A string specifying which draw calls to generate images .For Example: To dump draw 0, draw 10 through 15, and all draw calls after draw 100 you would set this string to '0,10-15,100...'"
END_KEY

BEGIN_KEY RIDSHIM_DRAW_RANGE
    DefinedWhen:        1
    BinaryID:           0x202380
    RemappedName:   D3D_44577956
    Type:           string
    Documentation:  "A string specifying which draw calls to generate images .For Example: To dump draw 0, draw 10 through 15, and all draw calls after draw 100 you would set this string to '0,10-15,100...'"
END_KEY

BEGIN_KEY RIDSHIM9_PRESENT_RANGE
    DefinedWhen:        1
    BinaryID:           0x102381
    RemappedName:   D3D_34577957
    Type:           string
    Documentation:  "A string specifying which present calls to generate images .For Example: To dump present 0, present 10 through 15, and all present calls after present 100 you would set this string to '0,10-15,100...'"
END_KEY

BEGIN_KEY RIDSHIM9_DRAWPERFRAME_RANGE
    DefinedWhen:           1
    BinaryID:           0x102371
    RemappedName:   D3D_34574957
    Type:           string
    Documentation:  "A string specifying which draw calls to dump in a frame .For Example: To dump draw 0, draw 10 through 15, and all draw calls after draw 100 within a frame range you would set this string to '0,10-15,100...Also specify the frame range using RIDSHIM9_PRESENT_RANGE key'"
END_KEY

BEGIN_KEY RIDSHIM9_IMAGE_FORMAT
    DefinedWhen:         1
    BinaryID:           0xbf6515
    RemappedName:   D3D_34578979
    Type:           string
    Documentation:  "The type of image format. Valid types are: BMP, PPM, PNG, DDS, EXR. EXR, PPM and DDS are uncompressed. EXR is for bit-accurate (>8 bit) formats but produces the largest files."
END_KEY

BEGIN_KEY BREAK_ON_ENTRY
    DefinedWhen:    1
    BinaryID:           0xb0ae1d
    RemappedName:   D3D_83930258
    Type:           string
    Documentation:  "A semi-colon delineated set of strings. These strings are substrings of entry point function names to assert on."
END_KEY

BEGIN_KEY BREAK_ON_ENTRY_FRAMES
    DefinedWhen:    1
    BinaryID:           0x12a3cd
    RemappedName:   D3D_83930259
    Type:           string
    Documentation:  "A string to specify which frames to break on. The input should be two integer values separated by a space. For example, '2 5' will break on frames 2 through 5. If the two numbers are the same, the program will break on all frames after that number. So, '0 0' will break on all frames and '5 5' will break on all frames frame 5 and after."
END_KEY

BEGIN_KEY BREAK_ON_ENTRY_CALLS
    DefinedWhen:    1
    BinaryID:           0x6447ee
    RemappedName:   D3D_83930260
    Type:           string
    Documentation:  "A string to specify which (numerically ordered) occurrence of a function call to break on. The input should be two integer values separated by a space. For example, '2 5' will break on calls 2 through 5. If the two numbers are the same, the program will break on all calls after that number. So, '0 0' will break on all frames and '5 5' will break on all calls to function X after the 5th."
END_KEY


// DX9 Vista/Win7/Win8 dual-core (multithreaded driver) registry keys

BEGIN_KEY ASYNC9_ENABLE
    DefinedWhen:        1
    BinaryID:           0x92f4de
    RemappedName:       D3D_a392f4de
    Type:               dword
    Documentation:      "Enable DX9 Dual core optimization (multithreaded driver)"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            APP         = 0x37605835, "Enable AsyncDevice except in configs that do not work (some SLI, Optimus) or if the application requested to disable them"
            WHENSAFE    = 0x37605846, "Enable AsyncDevice except in configs that do not work (some SLI, Optimus)"
            OFF         = 0x53850673, "Disable AsyncDevice and MS dual core optimization"
            ON          = 0x42563729, "Enable AsyncDevice ignoring safety or application requests."
            ONIFQUADRO  = 0x42563730, "Enable AsyncDevice if a Quadro or GeForce SMB GPU is being used, otherwise disable AsyncDevice and MS dual core optimization"
            MICROSOFT   = 0x75328097, "Disable AsyncDevice but allow MS dual core optimization"
        END_ENUM_LIST
END_KEY

BEGIN_KEY ASYNC9_PRESENT_MODE
    DefinedWhen:        1
    BinaryID:           0x15f512
    RemappedName:       D3D_93527291
    Type:               dword
    Documentation:      "Enable or disable asynchronous presents when the multithreaded driver is used"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            SYNC= 0x53855200, "All DX9 presents will be synchronous"
            ASYNC           = 0x96184013, "All DX9 presents will be asynchronous if AllowFlipBatching is set"
            ASYNCFS         = 0x57236402, "Only full screen DX9 presents will be asynchronous if AllowFlipBatching is set"
            FORCEASYNC      = 0x89624578, "All DX9 presents will be asynchronous"
            FORCEASYNCFS    = 0x32469276, "Only full screen DX9 presents will be asynchronous"
        END_ENUM_LIST
END_KEY

/* Release mode flags, none for now!
BEGIN_KEY ASYNC9_FLAGS
    DefinedWhen:        1
    RemappedName:       D3D_44217569
    Type:               dword
    Documentation:      ""
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
        END_ENUM_LIST
END_KEY
*/

BEGIN_KEY ASYNC9_DEVFLAGS
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0x17e65d
    RemappedName:       D3D_44217570
    Type:               dword
    Documentation:      ""
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            DISPLAY_CPU_METER               = 0x00000002, "Display meters that show cpu activity."
            DISPLAY_FPS                     = 0x00000004, "Display frames per second counter."
            DISPLAY_ONLY_WHEN_HOT_KEY_DOWN  = 0x00000008, "Display history/meter only when the hot key is down."
            DUMP_STATISTICS                 = 0x00000010, "Output lots of statistics at device destroy time."
            INCLUDE_PER_FRAME_STATS         = 0x00000020, "Include per-frame times."
            INCLUDE_QUEUE_LENGTH_STATS      = 0x00000040, "Include async queue length statistics."
            INCLUDE_COMMUNICATION_STATS     = 0x00000080, "Measure overhead of communication protocols."
            RECORD_ONLY_WHEN_HOT_KEY_DOWN   = 0x00000100, "Record stats only when the hot key is down. Useful for ignoring start/stop frames."
            PAUSE_FOR_DEBUG_AT_CREATION     = 0x00000200, "Pops up a message box at device creation so that you can attach a user mode debugger to the app at that time."
            SET_ALLOWED_PROCESSOR           = 0x00001000, "Set the allowed processor for the client (app) thread to 0 and the server (driver) thread to 1."
            SET_IDEAL_PROCESSOR             = 0x00002000, "Set the ideal (preferred) processor for the client (app) thread to 0 and the server (driver) thread to 1."
            DISABLE_ASYNC_LOCKS             = 0x00010000, "Disable asynchronous locks."
            DISABLE_UM_STREAM0_OPT          = 0x00080000, "Disable conversion of UM stream 0 and indices to VB draws."
            DISABLE_UM_DRAW_WHILE_LOCKED    = 0x00100000, "Disable UM stream 0 vertex buffer draw while locked optimization."
            FORCE_DUAL_CORE                 = 0x20000000, "Force async device even if single core processor is detected."
        END_ENUM_LIST
END_KEY

BEGIN_KEY ASYNC9_HOT_KEYS
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0x18831a
    RemappedName:       D3D_03764542
    Type:               dword
    Documentation:      "Hotkey pair used to control some debug functions. First hotkey is in low WORD, second is in high WORD. Default is VK_SHIFT."
END_KEY

BEGIN_KEY ASYNC9_QUEUE_SIZE
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0x7ea977
    RemappedName:       D3D_86256344
    Type:               dword
    Documentation:      "Total size (bytes) of the queue used to pass operations to the device thread."
END_KEY

BEGIN_KEY ASYNC9_MAX_QUEUED_UPDATE_SIZE
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0xc6b2f6
    RemappedName:       D3D_00374528
    Type:               dword
    Documentation:      "Max size (bytes) of data that calls twill copy, otherwise a synchronous operation is performce."
END_KEY

BEGIN_KEY ASYNC9_SPIN_COUNT
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0x032647
    RemappedName:       D3D_33654839
    Type:               dword
    Documentation:      "Spin count for thread synchronization protocols. After spin count is reached, OS wait is performed."
END_KEY

BEGIN_KEY ASYNC9_STATS_FIRST_FRAME
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0xc96730
    RemappedName:       D3D_56382920
    Type:               dword
    Documentation:      "Dump detailed statistics about frames betwen first frame and last."
END_KEY

BEGIN_KEY ASYNC9_STATS_LAST_FRAME
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0x64f34e
    RemappedName:       D3D_03745629
    Type:               dword
    Documentation:      "Dump detailed statistics about frames betwen first frame and last."
END_KEY

BEGIN_KEY ASYNC9_STACK_SIZE
    DefinedWhen:        ASYNC9_REGKEYS
    BinaryID:           0xd26905
    RemappedName:       D3D_73539284
    Type:               dword
    Documentation:      "Size of stack for async device threads, default is 256KB."
END_KEY

BEGIN_KEY ASYNC9_AFFINITY
    DefinedWhen:        1
    BinaryID:           0x15f522
    RemappedName:       D3D_93527201
    Type:               dword
    Documentation:      "Control processor affinity for client and server threads."
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            AVOID_CLIENT_AFFINITY   = 0x000000, "Dynamically set affinities to avoid client ideal processor."
            DONT_CHANGE_AFFINITY    = 0x000001, "Don't change affinities."
            // These two setting are for debugging purposes, to explore how perf is affected by specific thread to processor assignments
            // and to check the perf cost of setting the affinities at every frame.
            FORCE_AFFINITY_ONCE     = 0x000002, "Set affinities once to the specific processor below (a perf debugging aid)."
            FORCE_AFFINITY          = 0x000003, "Set affinities at each frame to the specific processor below (a perf debugging aid)."

            AFFINITY_MASK           = 0x0000ff, "Mask for the commands above."
            CLIENT_PROCESSOR_MASK   = 0x00ff00, "Mask for client processor number (if FORCE_AFFINITY_ONCE or FORCE_AFFINITY)."
            SERVER_PROCESSOR_MASK   = 0xff0000, "Mask for server processor number (if FORCE_AFFINITY_ONCE or FORCE_AFFINITY)."
            CLIENT_PROCESSOR_SHIFT  = 8,        "Shift count for client processor number."
            SERVER_PROCESSOR_SHIFT  = 16,       "Shift count for server processor number."
        END_ENUM_LIST
END_KEY

BEGIN_KEY ASYNC9_THREAD_PRIORITY
    DefinedWhen:        1
    BinaryID:           0x088318
    RemappedName:       D3D_93764540
    Type:               dword
    Documentation:      "If set, the DX9 async device thread will set its thread priority to this value."
END_KEY

// DX10 Vista/Win7/Win8 dual-core (multithreaded driver) registry keys

BEGIN_KEY ASYNC10_ENABLE
    DefinedWhen:        1
    BinaryID:           0x05f511
    RemappedName:       D3D_83527290
    Type:               dword
    Documentation:      "Enable DX10 Dual core optimization (multithreaded driver)"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            APP  = 0x37605835, "Enable dual core optimizations unless the application requested to disable them"
            OFF  = 0x53850673, "Disable dual core optimizations"
            ON   = 0x42563729, "Enable dual core optimizations"
        END_ENUM_LIST
END_KEY

BEGIN_KEY ASYNC10_PRESENT_MODE
    DefinedWhen:        1
    BinaryID:           0x05f512
    RemappedName:       D3D_83527291
    Type:               dword
    Documentation:      "Force DX10 present to async or sync call "
    UserVisible
    UserVisibleName:    " "  
    NvInternalSetting    
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DEFAULT  = 0x96184013, "DX10 present will be in default mode"
            SYNC     = 0x53855200, "DX10 present will be sync call"
            ASYNC    = 0x89624578, "DX10 present will be async call"
            ASYNC_ALL= 0x89344578, "DX10 both fullscreen and windowed present will be async call"
        END_ENUM_LIST
    Default:            DEFAULT
END_KEY

BEGIN_KEY ASYNC10_PREFERRED_EFFICIENCY_CLASS_MASK
    DefinedWhen:        1
    BinaryID:           0x00effEDF
    RemappedName:       D3D_0562AEDF
    Type:               dword
    Documentation:      "Select what EfficiencyClass cores to target when running on a heterogeneous system"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ECORE       = 0x00000001, "The most power efficient core"
            PCORE       = 0x00000002, "The highest performing core"            
            ALL         = ECORE | PCORE, "Target all available cores"
        END_ENUM_LIST
    Default:            ALL
END_KEY

BEGIN_KEY LATENCY
    DefinedWhen:        1
    BinaryID:           0x05f543
    RemappedName:       D3D_05f543
    Type:               dword
    Documentation:      "Reduces latency by limiting the number of frames the CPU can prepare before the frames are processed by the GPU. It also determines how multiple CPU-cores are used by the driver "
    UserVisible
    UserVisibleName:    " "    
    NvInternalSetting
    OverInstallBehavior: MERGE
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            BEST_PERFORMANCE  = 0x0, "Fastest, smoothest gameplay at all frame-rates"
            LOW_LATENCY       = 0x1, "Useful if you experience a delay in response to i/p devices while playing games"
            LOWEST_LATENCY    = 0x2, "Tightens driver synchronization and may further reduce latency"
        END_ENUM_LIST
    Default:            BEST_PERFORMANCE
END_KEY

BEGIN_KEY ASYNC10_NVAPI_MODE
    DefinedWhen:        1
    BinaryID:           0x05f5a32
    RemappedName:       D3D_83527a31
    Type:               dword
    Documentation:      "Control NVAPI processing behaviour"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            ALLOW_NONBLOCKING_NVAPI    = 1, "generally allow some nvapi calls to not block async device"
            ALLOW_NOBLOCKING_SLISTATE  = 2, "Allow specific non-blocking optimizations for GetCurrentSliState NVAPI"
        END_ENUM_LIST
    Default: ALLOW_NONBLOCKING_NVAPI | ALLOW_NOBLOCKING_SLISTATE
END_KEY

BEGIN_KEY ASYNC10_QUERYGETDATA_GPUWAIT_COUNT
    DefinedWhen:        1
    BinaryID:           0x05f5a33
    RemappedName:       D3D_83527a33
    Type:               dword
    Documentation:      "How many query getData calls are allowed before we consider it a gpu wait"
    Default:            10
END_KEY

BEGIN_KEY ASYNC10_QUERYGETDATA_SLEEP_COUNT
    DefinedWhen:        1
    BinaryID:           0x05f5a34
    RemappedName:       D3D_83527a34
    Type:               dword
    Documentation:      "How many query getData calls are allowed before the client thread using Sleep()"
    Default:            1000
END_KEY

BEGIN_KEY ASYNC10_DEVFLAGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x07e65d
    RemappedName:       D3D_34217570
    Type:               dword
    Documentation:      ""
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            DISPLAY_HISTORY                 = 0x00000001, "Display history of async device enable for last 64 frames."
            DISPLAY_CPU_METER               = 0x00000002, "Display meters that show cpu activity."
            DISPLAY_FPS                     = 0x00000004, "Display frames per second counter."
            DISPLAY_ONLY_WHEN_HOT_KEY_DOWN  = 0x00000008, "Display history/meter only when the hot key is down."
            DUMP_STATISTICS                 = 0x00000010, "Output lots of statistics at device destroy time."
            INCLUDE_PER_FRAME_STATS         = 0x00000020, "Include per-frame times."
            INCLUDE_QUEUE_LENGTH_STATS      = 0x00000040, "Include async queue length statistics."
            INCLUDE_COMMUNICATION_STATS     = 0x00000080, "Measure overhead of communication protocols."
            RECORD_ONLY_WHEN_HOT_KEY_DOWN   = 0x00000100, "Record stats only when the hot key is down. Useful for ignoring start/stop frames."
            SET_ALLOWED_PROCESSOR           = 0x00001000, "Set the allowed processor for the client (app) thread to 0 and the server (driver) thread to 1."
            SET_IDEAL_PROCESSOR             = 0x00002000, "Set the ideal (preferred) processor for the client (app) thread to 0 and the server (driver) thread to 1."
            SET_IDEAL_PROCESSOR_AVOID_DPCS  = 0x00004000, "If setting ideal processor, query the KMD for cores which are serving DPCs and avoid those cores."
            DISABLE_REFCOUNT_PRESENTLIMIT   = 0x00080000, "Disable limiting the present limit via refcount."
            DISABLE_OS_THREADING_APIS       = 0x00100000, "Do not call GetProcessAffinityMask/SetThreadIdealProcessor/Thread32First/etc."
            ON_ONLY_WHEN_HOT_KEY_DOWN       = 0x04000000, "Enable async device only when the hot key is down."
            FORCE_DUAL_CORE                 = 0x20000000, "Force async device even if single core processor is detected."
        END_ENUM_LIST
END_KEY

