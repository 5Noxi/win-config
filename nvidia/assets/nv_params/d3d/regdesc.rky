BEGIN_KEY PS_AMPERE_SURF_TILE_MAP_HELPER_FLAGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xefb71f
    RemappedName:       D3D_efb71f
    Type:               dword
    Documentation:      "Various helper flags to control develop/debug functionality."
    Values: Bitfields
	   BEGIN_ENUM_LIST
            GATHER_GENERAL_STATS                        = 0x00000001, "Collect miscellaneous non-GPU stats"
            GATHER_PROFILE_DATA                         = 0x00000002, "Profile tilemap data in both construction kernel and consumer shader"
            CONSUMER_DYNAMIC_COUNTS                     = 0x00000004, "Track dynamic counts of clean and total lookups (could TDR due to atomic overhead). Otherwise, default is static count. Effective only when GATHER_PROFILE_DATA is set."
            CONSUMER_PMTRIGS                            = 0x00000008, "Enable pmtrigger generation in consumer to record dynamic lookup events (total and clean counts)"
            DISABLE_SLOT0                               = 0x00001000, "Disable slot 0 of static specification for debugging purposes."
            DISABLE_SLOT1                               = 0x00002000, "Disable slot 1 of static specification for debugging purposes."
            DISABLE_SLOT2                               = 0x00004000, "Disable slot 2 of static specification for debugging purposes."
            DISABLE_SLOT3                               = 0x00008000, "Disable slot 3 of static specification for debugging purposes."
            DISABLE_SLOT4                               = 0x00010000, "Disable slot 4 of static specification for debugging purposes."
            DISABLE_SLOT5                               = 0x00020000, "Disable slot 5 of static specification for debugging purposes."
            DISABLE_SLOT6                               = 0x00040000, "Disable slot 6 of static specification for debugging purposes."
	   END_ENUM_LIST
	   Default:  0
END_KEY

