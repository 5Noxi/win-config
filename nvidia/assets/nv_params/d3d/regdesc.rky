BEGIN_KEY ENABLE_UMD_MANAGED_GPFIFO
    DefinedWhen:        1
    BinaryID:           0xfab419
    RemappedName:       D3D_fab419
    Type:               bool
    Documentation:      "This key is the flag for enabling direct submission of gpfifo/command-buffers from UMD"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "disable UMD direct submission of gpfifo"
            ON,  1, TRUE,  ENABLED   = 1, "enable UMD direct submission of gpfifo"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY REUSE_FREE_SPACE_IN_UMD_MANAGED_GPFIFO
    DefinedWhen:        1
    BinaryID:           0xfad419
    RemappedName:       D3D_fad419
    Type:               bool
    Documentation:      "This key is the flag for deciding whether to reuse available space on a gpfifo allocation. Applicable for UMD managed gpfifo (HWS) alone."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "disable reuse of free gpfifo space"
            ON,  1, TRUE,  ENABLED   = 1, "enable reuse of free gpfifo space"
        END_ENUM_LIST
    Default:            1
END_KEY

BEGIN_KEY RESET_FREE_GPFIFO_ENTRIES_IN_UMD_MANAGED_GPFIFO
    DefinedWhen:        1
    BinaryID:           0xfac428
    RemappedName:       D3D_fac428
    Type:               bool
    Documentation:      "This key determines whether to reset unused/free gpfifo entries with NOPs, in case of UMD managed gpfifo. Applicable for HWS alone."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "don't reset unused gpfifo entries"
            ON,  1, TRUE,  ENABLED   = 1, "reset unused gpfifo entries with NOPs"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY DO_WAIT_BEFORE_GPFIFO_SWITCH_IN_UMD_MANAGED_GPFIFO
    DefinedWhen:        1
    BinaryID:           0xfac430
    RemappedName:       D3D_fac430
    Type:               bool
    Documentation:      "This flag determines whether to perform some wait before deciding to do gpfifo switch, in case of UMD managed gpfifo. Applicable for HWS alone."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "don't perform wait before deciding for gpfifo switch"
            ON,  1, TRUE,  ENABLED   = 1, "perform wait before gpfifo switch"
        END_ENUM_LIST
    Default:            1
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE
    DefinedWhen:        1
    BinaryID:           0xfab429
    RemappedName:       D3D_fab429
    Type:               DWORD
    Documentation:      "This key indicates how to determine capacity of a UMD managed gpfifo allocation."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            STATIC       = 0x0,       "Gpfifo allocation capacities are non-uniform and, currently, statically hardcoded in the driver"
            REGKEY_BASED = 0x1,       "Initial gpfifo allocation capacities are taken from regkeys, and then 2x or more scaling is done for further resizes"
        END_ENUM_LIST
    Default:            1
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_ASYNC_COPY_CHANNEL
    DefinedWhen:        1
    BinaryID:           0xfac427
    RemappedName:       D3D_fac427
    Type:               DWORD
    Documentation:      "This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation, for async-copy channel. Applicable for HWS alone. This should be a power of 2. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            4096
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_GRAPHICS_CHANNEL
    DefinedWhen:        1
    BinaryID:           0xfac419
    RemappedName:       D3D_fac419
    Type:               DWORD
    Documentation:      "This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation, for graphics channel. Applicable for HWS alone. This should be a power of 2. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            4096
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_SCG_ASYNC_COMPUTE_CHANNEL
    DefinedWhen:        1
    BinaryID:           0xfac420
    RemappedName:       D3D_fac420
    Type:               DWORD
    Documentation:      "This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation, for Auto SCG channel. Applicable for HWS alone. This should be a power of 2. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            4096
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_SCG_DRIVER_CHANNEL
    DefinedWhen:        1
    BinaryID:           0xfac424
    RemappedName:       D3D_fac424
    Type:               DWORD
    Documentation:      "This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation, for Driver SCG channel. Applicable for HWS alone. This should be a power of 2. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            4096
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_SCG_HELPER_CHANNEL
    DefinedWhen:        1
    BinaryID:           0xfac421
    RemappedName:       D3D_fac421
    Type:               DWORD
    Documentation:      "This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation, for SCG-helper channel. Applicable for HWS alone. This should be a power of 2. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            512
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_SUB_PB_MASK_FOR_GPFIFO_SWITCH_ALLOWED
    DefinedWhen:        1
    BinaryID:           0xfac422
    RemappedName:       D3D_fac422
    Type:               DWORD
    Documentation:      "This key indicates which PBDs are allowed to exercise gpfifo switch. Bit-0 is for main/gr PBD. Bit-1 for SCG-Async-Compute PBD. Bit-2 for SCG-Async-Copy PBD. Bit-3 for SCG-Driver PBD. Bit-4 for SCG-Helper PBD. Applicable for HWS alone."
    Default:            0xffffffff
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_MAX_CAPACITY
    DefinedWhen:        1
    BinaryID:           0xfac423
    RemappedName:       D3D_fac423
    Type:               DWORD
    Documentation:      "This key indicates the maximum allowed capacity for a UMD managed gpfifo allocation. This should be power of 2. Applicable for HWS alone. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            0x200000
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_GROWTH_FACTOR
    DefinedWhen:        1
    BinaryID:           0xfac425
    RemappedName:       D3D_fac425
    Type:               DWORD
    Documentation:      "This key indicates the growth factor used in determining size of next/new UMD managed gpfifo during gpfifo switch. Applicable for HWS alone. It is used when regkey based capacities are to be used as per UMD_MANAGED_GPFIFO_ALLOCATION_CAPACITY_SELECTION_MODE registry."
    Default:            0x2
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_HEAP_LOCATION
    DefinedWhen:        1
    BinaryID:           0xfac426
    RemappedName:       D3D_fac426
    Type:               DWORD
    Documentation:      "This key indicates the heap to be used for allocating a UMD managed gpfifo. Applicable for HWS alone."
    Values: Bitfields
        BEGIN_ENUM_LIST
            HOST  = 0x0, "place UMD gpfifo on HEAP_HOST"
            VID   = 0x1, "place UMD gpfifo on HEAP_VID"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY ENABLE_UMD_MANAGED_GPFIFO_DX9
    DefinedWhen:        1
    BinaryID:           0xfab519
    RemappedName:       D3D_fab519
    Type:               bool
    Documentation:      "This key is the flag for enabling direct submission of gpfifo/command-buffers from UMD"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "disable UMD direct submission of gpfifo in DX9"
            ON,  1, TRUE,  ENABLED   = 1, "enable UMD direct submission of gpfifo in DX9"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY ENABLE_UMD_MANAGED_GPFIFO_DX9_SLI
    DefinedWhen:        1
    BinaryID:           0xfab528
    RemappedName:       D3D_fab528
    Type:               bool
    Documentation:      "This key is the flag for on SLI, enabling direct submission of gpfifo/command-buffers from UMD"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "disable UMD direct submission of gpfifo in DX9 SLI"
            ON,  1, TRUE,  ENABLED   = 1, "enable UMD direct submission of gpfifo in DX9 SLI"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY UMD_MANAGED_GPFIFO_INITIAL_CAPACITY_DX9
    DefinedWhen:        1
    BinaryID:           0xfac520
    RemappedName:       D3D_fac520
    Type:               DWORD
    Documentation:      "DX9: This key indicates the number of GPFIFO entries in the initial UMD managed gpfifo allocation. Applicable for HWS alone. This should be a power of 2."
    Default:            4096        
END_KEY

BEGIN_KEY ENABLE_COMPRESS_ON_BIND
    DefinedWhen:        1
    BinaryID:           0x54fac9
    RemappedName:       D3D_54fac9
    Type:               bool
    UserVisible
    Documentation:      "Enable compress on bind functionality"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
END_KEY

BEGIN_KEY ENABLE_TRC_WITH_GENERIC_MEMORY
    DefinedWhen:        1
    BinaryID:           0x9daed0
    RemappedName:       D3D_0x9daed0
    Type:               bool
    UserVisible
    Documentation:      "Enable support for Tiled resource compression using Generic Memory kind - Specific to Turing Architecture only"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default:            ON
END_KEY

BEGIN_KEY ENABLE_RESOURCEHEAP_TIER2
    DefinedWhen:        1
    BinaryID:           0xacbcc0
    RemappedName:       D3D_0xacbcc0
    Type:               bool
    UserVisible
    Documentation:      "Enable support for Tier 2 resource heap - Make sure Generic Kind is supported -> Turing+ Architecture only"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default:            ON
END_KEY

BEGIN_KEY HEAP_TIER2_COMPRESSION_SUPPORT
    DefinedWhen:        1
    BinaryID:           0xacfcc0
    RemappedName:       D3D_0xacfcc0
    Type:               dword
    Documentation:      "Enable support for Compressing Heaps on TIER2 Turing+ Architecture only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            COMPRESS_ENTIRE_HEAP            = 0x00000000, "Allocate entire heap as compressed and let it remain compressed"
            COMPRESS_ON_ADDITIONAL_MAPPING  = 0x00000001, "Compress as and when resources are placed inside heap depending on CBC Heuristic"
        END_ENUM_LIST
    Default:            COMPRESS_ON_ADDITIONAL_MAPPING
END_KEY

BEGIN_KEY ENABLE_SYNC_CE_PIPELINED_DMA_COPY
    DefinedWhen:        1
    BinaryID:           0xfcacb0
    RemappedName:       D3D_0xfcecb0
    Type:               dword
    Documentation:      "Enable Pipelined Copy for Sync CE aka Pipelined + Flush_Enable = False , supports DX12 only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_PIPELINED_COPY  = 0x00000000, "Disable Pipelining of syncCE copy aka Data Transfer Type is non-pipelined and Flush_enable set to true"
            ENABLE_PIPELINED_COPY   = 0x00000001, "Enable Pipelined Copy for Sync CE aka Pipelined + Flush_Enable = False"
        END_ENUM_LIST
    Default:            DISABLE_PIPELINED_COPY
END_KEY

BEGIN_KEY DISCARDRESOURCE_HANDLING_FOR_TILEDRESOURCES
    DefinedWhen:        1
    BinaryID:           0xacbcc1
    RemappedName:       D3D_0xacbcc1
    Type:               dword
    Documentation:      "In what situations should we issue a clear for DiscardResource for the purposes of tiled resources and aliasing"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ONLY_CLEAR_ON_REQ_HW    = 0x00000000, "Only clear when we believe the HW requires it."
            CLEAR_ON_ALL_HW         = 0x00000001, "Clear on all HW - even HW that shouldn't need it."
            SKIP_CLEAR_ON_ALL_HW    = 0x00000002, "Don't do clears on HW that needs it or not."
            CLEAR_HW_MASK           = 0x0000000F, "Mask of the 3 HW selection modes."
            SKIP_CLEAR_RTVS         = 0x00000010, "Should RTV discards be ignored?"
            SKIP_CLEAR_DSVS         = 0x00000020, "Should DSV discards be ignored?"
        END_ENUM_LIST
    Default:            ONLY_CLEAR_ON_REQ_HW
END_KEY

BEGIN_KEY DX11_CB_BASE_OFFSET_BYTES
    DefinedWhen:        1
    BinaryID:           0xacbff1
    RemappedName:       D3D_0xacbff1
    Type:               dword
    UserVisible
    Documentation:      "For testing 64-byte aligned CBs for Turing+, this increases the size of CB allocations and adds the offset to the base offset.  Must be 64, 128, or 192 -> Turing+ Architectures only"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFFSET_0   =    0, "No offset"
            OFFSET_64  =   64, "64 byte offset"
            OFFSET_128 =  128, "128 byte offset"
            OFFSET_192 =  192, "192 byte offset"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY D3D12_VIEW_INSTANCING
    DefinedWhen:        1
    BinaryID:           0xacbdfe
    RemappedName:       D3D_0xacbdfe
    Type:               dword
    UserVisible
    Documentation:      "Sets maximum view instancing tier that can be reported through view instancing caps. If an architecture supports a tier which is less than the value set through regkey then regkey value will be discarded. i.e. setting tier to Tier-2/Tier-3 through regkey in kepler doesn't have any impact."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            MAX_TIER_0      = 0x0, "View instancing is disabled. Overrides arch specific reported tier."
            MAX_TIER_1      = 0x1, "Maximum allowed tier is Tier-1 a.k.a draw looping."
            MAX_TIER_2      = 0x2, "Maximum allowed tier is Tier-2." 
            MAX_TIER_3      = 0x3, "Maximum allowed tier is Tier-3."
        END_ENUM_LIST
    Default:            0x3
END_KEY

BEGIN_KEY PRIMARY_COMPRESSION
    DefinedWhen:        1
    BinaryID:           0xb21c03
    RemappedName:       D3D_0xb21c03
    Type:               dword
    UserVisible
    Documentation:      "Controls the use of memory compression for primaries."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            ENABLE_ALL          = 0x000000, "Compression will be used for any primary."
            DISABLE_SINGLE_GPU  = 0x000001, "Disable compression for primaries in single GPU." 
            DISABLE_SLI         = 0x000002, "Disable compression for primaries for SLI."
            DISABLE_SFR_WITH_CE = 0x000004, "Disable compression for primaries when SFR is in use and CE is used for present."
            DISABLE_DX12        = 0x000008, "Disable for DX12."
            DISABLE_DX11_SFR    = 0x000010, "Disable for DX11 if SFR is used."
            DISABLE_DX12_SFR    = 0x000020, "Disable for DX12 if SFR is used."
            DISABLE_ALL         = 0x00003F, "Disable compression for primaries in all modes."
            ALLOW_PRIMARY_GPU   = 0x010000, "Allow the allocation in the Primary GPU to use compression at all times"
            ALLOW_PRE_TURING    = 0x020000, "Allow primary compression on pre-Turing chips, moslty for testing purposes"
        END_ENUM_LIST
    Default: DISABLE_DX12_SFR
END_KEY

BEGIN_KEY AL_SIZE_12ON7
    DefinedWhen:        1
    BinaryID:           0xb21d48
    RemappedName:       D3D_0xb21d48
    Type:               dword
    Documentation:      "Controls initial allocation list size for D3D12 on Win7 applications."
    Default:            0x3000
END_KEY

BEGIN_KEY MEM_FRACTION_12ON7
    DefinedWhen:        1
    BinaryID:           0xb21d49
    RemappedName:       D3D_0xb21d49
    Type:               dword
    Documentation:      "Controls fraction of total memory allowed to be used for memory budget computations for D3D12 on Win7 applications."
    Default:            90
END_KEY

//---------------------------------------------------------------------------
//
// SPH Bits Registry Key
//
//---------------------------------------------------------------------------

BEGIN_KEY PS_SPH_FORCE_GLOBAL_STORE
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x0153334
    RemappedName:       D3D_0153334
    Type:               bool
    Documentation:      "Force a pixel shader's SPH bit DOES_GLOBAL_STORE flag to be on or off"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Force SPH bit _DOES_GLOBAL_STORE OFF"
            ON,  1, TRUE,  ENABLED   = 0x1, "Force SPH bit _DOES_GLOBAL_STORE ON"
        END_ENUM_LIST
END_KEY

BEGIN_KEY PS_SPH_FORCE_GLOBAL_STORE_HASH
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x0153333
    RemappedName:       D3D_0153333
    Type:               qword
    Documentation:      "If non-zero, only pixel shaders with the D3D10 shader hash will have _DOES_GLOBAL_STORE forced on/off by PS_SPH_FORCE_GLOBAL_STORE. If zero, all pixel shaders will have _DOES_GLOBAL_STORE forced on/off by PS_SPH_FORCE_GLOBAL_STORE"
    Default:            0x0
END_KEY

BEGIN_KEY PS_DX12_FORCE_RESOURCE_TYPE_ACCESSIBILITY
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe107da
    RemappedName:       D3D_0153335
    Type:               dword
    Documentation:      "Overrides automatic determination of resource type accessibility"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ALL_SRV_ACCESSIBLE  = 0x00000001, "Assume root signature infers all SRV resources are always accessible in GPU memory."
            ALL_CBV_ACCESSIBLE  = 0x00000010, "Assume root signature infers all CBV resources are always accessible in GPU memory."
            ALL_UAV_ACCESSIBLE  = 0x00000100, "Assume root signature infers all UAV resources are always accessible in GPU memory."
            NO_SRV_ACCESSIBLE   = 0x00000002, "Assume root signature infers no SRV resources are always accessible in GPU memory."
            NO_CBV_ACCESSIBLE   = 0x00000020, "Assume root signature infers no CBV resources are always accessible in GPU memory."
            NO_UAV_ACCESSIBLE   = 0x00000200, "Assume root signature infers no UAV resources are always accessible in GPU memory."
            ALL_RESOURCES_BOUND = ALL_SRV_ACCESSIBLE | ALL_CBV_ACCESSIBLE | ALL_UAV_ACCESSIBLE, "Assume all resources types are accessible in GPU memory at execution, same meaning as the shader supplying the allResourcesBound hint."
        END_ENUM_LIST
    Default: 0x0
END_KEY

BEGIN_KEY MISC_INDICATOR
    DefinedWhen:        1
    BinaryID:           0x8df510
    RemappedName:       D3D_14B5629
    Type:               dword
    Documentation:      "Miscellaneous indicators used for debug of various issues."
    Values: Bitfields
        BEGIN_ENUM_LIST
            DEFAULT            = 0x00000000, "No indicator."
            VRR_ENTROPY        = 0x00000001, "VRR - prints a green '.' when GSYNC entropy is reported high. Debug or Develop driver builds only."
            VRR_SUSPEND_REASON = 0x00000002, "VRR - prints the reason why GSYNC may have been suspended in DD. Debug or Develop driver builds only."
            VRR_SUPPORT        = 0x00000004, "VRR - prints whether G-sync is supported or not."
            MASK               = 0x00000007, "Mask of all valid bits."
        END_ENUM_LIST
    Default: DEFAULT
END_KEY


