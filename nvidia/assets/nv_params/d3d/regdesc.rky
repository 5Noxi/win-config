BEGIN_KEY TRMSAAMODE
    DefinedWhen:        1
    BinaryID:           0x43ed70
    RemappedName:       D3D_45382907
    Type:               dword
    Documentation:      "Transparency multisampling anti-aliasing modes."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST 
                 Q                                                          = 0x0000, "(Default, Mixed mode) uses application detection."
              ATOC                                                          = 0x0001, "(Old mode) uses the good old ATOC computation, 1x shader."
               A4X_TC                                                       = 0x0002, "(Quality mode) spawns 4 shader copies, averages alpha only. (only texcoords are adjusted)"
               C4X_TC                                                       = 0x0003, "(Quality mode) spawns 4 shader copies, averages r,g,b, and alpha. (only texcoords are adjusted)"
               A3X_TC                                                       = 0x0004, "(Quality mode) spawns 3 shader copies, averages alpha only. (only texcoords are adjusted)"
               C3X_TC                                                       = 0x0005, "(Quality mode) spawns 3 shader copies, averages r,g,b, and alpha. (only texcoords are adjusted)"
               A4X_ALL                                                      = 0x0006, "(Quality mode) spawns 4 shader copies, averages alpha only. (all parameters are adjusted)"
               C4X_ALL                                                      = 0x0007, "(Quality mode) spawns 4 shader copies, averages r,g,b, and alpha. (all parameters are adjusted)"
               A3X_ALL                                                      = 0x0008, "(Quality mode) spawns 3 shader copies, averages alpha only. (all parameters are adjusted)"
               C3X_ALL                                                      = 0x0009, "(Quality mode) spawns 3 shader copies, averages r,g,b, and alpha. (all parameters are adjusted)"
               SS2X                                                         = 0x000a, "Used for internal driver purposes only - spawns 2 shader copies"
               SS4X                                                         = 0x000b, "Used for internal driver purposes only - spawns 4 shader copies"
               SS8X                                                         = 0x000c, "Used for internal driver purposes only - spawns 8 shader copies"
              TEST                                                          = 0x000F, "(Test mode) shows shader types in different colors"
               MAX                                                          = 0x000F, ""
        END_ENUM_LIST
    Default:            0
END_KEY

