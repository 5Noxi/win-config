//---------------------------------------------------------------------------
//
// Direct3D Debug
//
//---------------------------------------------------------------------------

BEGIN_KEY D3D_DBG_AFTER_DRAW_DISPATCH
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x321ddd
    RemappedName:       D3D_12agdeee
    Type:               dword
    Documentation:      "Methods ( WFI/cache invalidation etc) to be inserted after every draw and dispatch - Dx1X only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DBG_NONE                                       = 0x00000000, "no method to be inserted"
            DBG_WFI                                        = 0x00000001, "insert WFI after every draw/dispatch"
            DBG_CACHE_INVALIDATE_NONWFI                    = 0x00000002, "insert WFI-less version of methods for cache invalidation"
            DBG_CACHE_INVALIDATE_WFI                       = 0x00000004, "insert WFI after cache invalidation methods"
            DBG_CACHE_INVALIDATE_PSB                       = 0x00000008, "maxwell+ only. Any HW which does not support falls back to WFI invalidate"
            DBG_INVALIDATE_TEX_HEADERS                     = 0x00000010, "invalidate tex headers"
            DBG_INVALIDATE_SAMPLERS                        = 0x00000020, "invalidate samplers"
            DBG_INVALIDATE_SHADERS                         = 0x00000040, "invalidate shaders"
            DBG_INVALIDATE_CONSTANTS                       = 0x00000080, "invalidate constants"
            DBG_INVALIDATE_TEX_OR_SURF_DATA                = 0x00000100, "invalidate tex or surf data"
            DBG_INVALIDATE_ALL_TARGETS                     = 0x000001f0, "invalidate all the targets like texheaders,samplers,shaders,constants"
            DBG_ON_GRAPHICS                                = 0x10000000, "insert method on graphics pipeline"
            DBG_ON_COMPUTE                                 = 0x20000000, "insert method on compute pipeline"
            GRAPHICS_NONWFI_INVALIDATE_CACHE_FOR_ALL       = 0x100001f2, "insert non-wfi invalidate method on all the targets for graphics"
            GRAPHICS_WFI_INVALIDATE_CACHE_FOR_ALL          = 0x100001f4, "insert wfi invalidate method on all the targets for graphics"
            GRAPHICS_PSB_INVALIDATE_CACHE_FOR_ALL          = 0x100001f8, "insert psb invalidate method on all the targets for graphics"
            COMPUTE_WFI_INVALIDATE_CACHE_FOR_ALL           = 0x200001f4, "insert wfi invalidate method on all the targets for compute"
            GRAPHICS_WFI                                   = 0x10000001, "insert WFI after draw/dispatch for 3D"
            COMPUTE_WFI                                    = 0x20000001, "insert WFI after draw/dispatch for compute"
        END_ENUM_LIST
    Default: DBG_NONE
END_KEY

BEGIN_KEY D3D_DBG_AFTER_DRAW_DISPATCH_FREQUENCY
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x342ddd
    RemappedName:       D3D_12fadeee
    Type:               dword
    Documentation:      "The frequency at which the methods(WFI/cacheinvalidation etc) are to be inserted in a given frame"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DBG_DEFAULT                                     = 0x00000000, "special default case, insert after every draw/dispatch call"
            DBG_EVERY                                       = 0x00010001, "insert after every draw/dispatch call"
            DBG_DRAW_MASK                                   = 0x0000ffff, "draw mask frequency (upto every 65535 draw calls) "
            DBG_DISPATCH_MASK                               = 0xffff0000, "dispatch frequency (upto every 65535 dispatch calls)"
            DRAW_FRQUENCY_20                                = 0x00000014, "insert after every 20 draw calls"
            DISPATCH_FRQUENCY_20                            = 0x00140000, "insert after every 20 dispatch calls"
            DRAW_FRQUENCY_100                               = 0x00000064, "insert after every 100 draw calls"
            DISPATCH_FRQUENCY_100                           = 0x00640000, "insert after every 100 dispatch calls"
        END_ENUM_LIST
    Default: DBG_DEFAULT
END_KEY

BEGIN_KEY D3D_DBG_DUMP_AFTER_DRAW
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xd831b3
    RemappedName:       D3D_8bfe85ab
    Type:               dword
    Documentation:      "Dump rendering data after every draw and dispatch - Dx1X only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DUMP_NONE                                      = 0x00000000, "nothing to be dumped"
            DUMP_PRE_DRAW                                  = 0x00000001, "dump images before the draw/dispatch"
            DUMP_RTV                                       = 0x00000010, "dump the content of all rendertarget views - RTVs"
            DUMP_DSV                                       = 0x00000020, "dump the content of all depth stencil views - DSVs"
            DUMP_STREAM                                    = 0x00000040, "dump the geometry content using stream outputs"
            DUMP_PL_STATS                                  = 0x00000100, "dump pipeline statistics"
            DUMP_ZPASS                                     = 0x00000200, "dump z passing statistics"
            DUMP_SO_STATS                                  = 0x00000400, "dump stream out statistics"
            DUMP_GFX_UAV                                   = 0x00001000, "dump the content of graphics unordered access views - UAVs"
            DUMP_GFX_SRV                                   = 0x00002000, "dump the content of graphics shader resource views - SRVs or texture"
            DUMP_GFX_CBV                                   = 0x00004000, "dump the content of graphics constant buffer views - CBVs"
            DUMP_GFX_GSCB                                  = 0x00008000, "dump the content of the graphics state constant buffer - GSCB"
            DUMP_GFX_TEXHEADERS                            = 0x00010000, "dump the content of the graphics texture headers"
            DUMP_COMPUTE_UAV                               = 0x00100000, "dump the content of compute unordered access views - UAVs"
            DUMP_COMPUTE_SRV                               = 0x00200000, "dump the content of compute shader resource views - SRVs or texture"
            DUMP_COMPUTE_CBV                               = 0x00400000, "dump the content of compute constant buffer views - CBVs"
            DUMP_COMPUTE_GSCB                              = 0x00800000, "dump the content of the compute state constant buffer - GSCB"
            DUMP_COMPUTE_TEXHEADERS                        = 0x01000000, "dump the content of the compute texture headers"
            IGNORE_BAKED_BUNDLES                           = 0x10000000, "do not dump data per draw calls inside baked bundles"
        END_ENUM_LIST
    Default: DUMP_NONE
END_KEY

BEGIN_KEY D3D_DBG_MISC_AFTER_DRAW
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xa22dc9 
    RemappedName:       D3D_4891f370
    Type:               dword
    Documentation:      "Misc operations we can do after every draw and dispatch - Dx1X only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            MISC_NONE                                      = 0x00000000, "nothing to be dumped"
            MISC_DISPATCH_FLUSH                            = 0x00000001, "force a command buffer dispatch and flush after every draw call"
            MISC_CHECK_DESCRIPTOR                          = 0x00000002, "do an extra check on descriptor before a draw call - ASSERT build only"
            IGNORE_BAKED_BUNDLES                           = 0x10000000, "do not do any misc operations per draw calls inside baked bundles"
        END_ENUM_LIST
    Default: MISC_NONE
END_KEY

BEGIN_KEY D3D_ENABLE_VALIDATION_SHIM
    DefinedWhen:    1
    BinaryID:       0xe46fce
    RemappedName:   D3D_01e46fce
    Type:           dword
    Documentation:  "Enables various validation checks (eg: reentrancy) in the Dx12 driver to catch appside bugs."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, DISABLED  = 0x00000000, "disable dx12 validation shim"
            ON,  ENABLED   = 0x00000001, "enable dx12 validation shim."
        END_ENUM_LIST
    Default:        DISABLED
END_KEY

BEGIN_KEY D3D_DBG_VALIDATION_MISC_ACTIVITY
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xB82355
    RemappedName:       D3D_B8231455
    Type:               dword
    Documentation:      "Enable various types of operations to be done while validating dx12 driver"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED, OFF, 0                                = 0x00000000, "Disabled"
            FORCE_DDI_CRITICAL_SECTION                      = 0x00000004, "Force a critical section on all DX12 commandlist DDI"
            FORCE_DDI_INTERLOCKED_CHECK                     = 0x00000008, "Force an interlocked check on all DX12 commandlist DDI"
            INCREASE_TIME_DDI_CALLS                         = 0x00000010, "Insert 1ms Sleep in command list DDI calls to catch reentrancy (g_IncreaseTimer)"
            USE_ZERO_FOR_INIT_DESCRIPTORS                   = 0x00000020, "Instead of using a canonical, valid null desc, use zeros"
        END_ENUM_LIST
    Default:            DISABLED
END_KEY

BEGIN_KEY LMEM_MIN_SIZE
    DefinedWhen:        1
    BinaryID:           0x7234fa
    RemappedName:       D3D_7234fa
    Type:               dword
    UserVisible
    Documentation:      "makes sure driver allocates at least as much shader local memory as specified"
    Default:            0
END_KEY

BEGIN_KEY D3D12_VPRS_FLAGS
    DefinedWhen:     1
    BinaryID:        0x554555
    RemappedName:    D3D_554555
    Type:            dword
    Documentation:   "DX12 Variable Pixel Rate Shading flags"
    Values: Bitfields
        BEGIN_ENUM_LIST
            VPRS_FLAGS_NONE                               = 0x00000000, ""
            AMPERE_PLUS_FORCE_LEGACY                      = 0x00000001, "AmpereB+, Force Turing behaviour of Viewport based VPRS Lookup table for VS/GS Shading Rate."
            FORCE_VPRS_NOT_SUPPORTED                      = 0x00000002, "Turing+, Force VRS not supported caps."
        END_ENUM_LIST
    Default:        VPRS_FLAGS_NONE
END_KEY

BEGIN_KEY AMPERE_COMPLETION_TRACKER
    DefinedWhen:     1
    BinaryID:        0x554321
    RemappedName:    D3D_554321
    Type:            dword
    Documentation:   "Use new compute completion tracking based on Ampere QMD dependence counters"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE                          = 0,          "Setting 0 disables the new tracker" 
            ENABLE                           = 0x00000001, "Enables the tracker"
            FORCE_FOR_GRAPHICS_TIMESTAMPS    = 0x00000002, "Stress-testing: force the compute tracker for the graphics timestamps too"
            DISALLOW_FOR_DIRECT_QUEUES       = 0x00000004, "Disable the tracker for direct queues"
            DISALLOW_HELPER_ON_DIRECT_QUEUES = 0x00000008, "Disable use of the helper channel on direct queues when the tracker is enabled"
            FORCE_HELPER_ON_ASYNC_QUEUES     = 0x00000010, "Force use of the helper channel on async compute queues when the tracker is enabled (by default, such helpers are disabled)"
            DISALLOW_CPU_PATCH_MODE          = 0x00000080, "Dissalow to make the driver to update semaphore info back in the pushbuffer instead of doing an extra GPU patching blit."
            DISALLOW_DEPENDENT_AFTER_BARRIER = 0x00000100, "Disallow to make the first API launch after the barrier to be launched by the tracker dependent pointer. Barrier is moved after the first launch"
            DISALLOW_ACQUIRE_DEFERRAL        = 0x00000200, "Disallow further deferral of the host acquire after first dispatch after the barrier, instead force it right after such dispatch."
            DISALLOW_DSC_DEFERRED_BARRIER    = 0x00000400, "Disallow to make the first DSC API launch after the barrier to be launched by the tracker dependent pointer. Barrier is moved after the first launch"
            DISALLOW_GSCB_PREFETCH           = 0x00000800, "Disallow driver side CB prefetch on dependent pointer launch"
            DBG_SKIP_SYSMEMBAR               = 0x00008000, "Debug only: skip sysmembar of the tracker completion semaphore"
            MAX_TRACKED_LAUNCHES_SHIFT       = 16,         "High 16 bits of the regkey store max number of launches per batch. When reached, the driver inserts a sync point."
            MAX_TRACKED_LAUNCHES_DEFAULT     = 0,          "0 for this field lets the driver to decide the default (0xFFFF is max supported by Ampere)"
        END_ENUM_LIST
    Default:        ENABLE
END_KEY

BEGIN_KEY D3D12_AMPERE_SUBCHSW_OVERRIDE
    DefinedWhen:     1
    BinaryID:        0x524621
    RemappedName:    D3D_524621
    Type:            dword
    Documentation:   "Regkey disables cache invalidates on subchannel switches on GA10x+. Specify, which particular switches are affected. Also, specify if any caches need to be excluded from override"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NO_OVERRIDE                      = 0,          "No overrides, any subchannel switch causes all cache invalidates" 
            FE0_CE_TO_COMPUTE                = 0x00000001, "Ignore invalidates on the FE0 pipe for subchannel switches from CE to COMPUTE"
            FE0_3D_TO_COMPUTE                = 0x00000002, "Ignore invalidates on the FE0 pipe for subchannel switches from 3D to COMPUTE"
            FE0_CE_TO_3D                     = 0x00000004, "Ignore invalidates on the FE0 pipe for subchannel switches from CE to 3D"
            FE0_COMPUTE_TO_3D                = 0x00000008, "Ignore invalidates on the FE0 pipe for subchannel switches from COMPUTE TO 3D"
            FE1_CE_TO_COMPUTE                = 0x00000010, "Ignore invalidates on the FE1 pipe for subchannel switches from CE to COMPUTE"
            SUBCHSW_TYPE_MASK                = 0x0000001F, "Mask of subchannel switch types"

            EXCLUDE_INV_SHADER_CACHES_INSTR  = 0x01000000, "Set the bit to invalidate instruction caches (ie exclude from override)"
            EXCLUDE_INV_SHADER_CACHES_DATA   = 0x02000000, "Set the bit to invalidate shader data caches (ie exclude from override)"
            EXCLUDE_INV_SHADER_CACHES_CONST  = 0x04000000, "Set the bit to invalidate shader constant caches (ie exclude from override)"
            EXCLUDE_INV_SHADER_CACHES_LOCKS  = 0x08000000, "Set the bit to invalidate shader locks caches (ie exclude from override)"
            EXCLUDE_INV_SAMPLER_CACHE        = 0x10000000, "Set the bit to invalidate sampler cache (ie exclude from override)"
            EXCLUDE_INV_TEXTURE_HEADER_CACHE = 0x20000000, "Set the bit to invalidate texture header cache (ie exclude from override)"
            EXCLUDE_INV_MASK                 = 0x3F000000, "Mask of invalidate bits that are assumed by default"

            INCLUDE_INV_RESTER_CACHE         = 0x40000000, "EXPERIMENTAL (note reversed meaning): set the bit to disable invalidate of raster cache"
            INCLUDE_INV_ROP_MINI_CACHE       = 0x80000000, "EXPERIMENTAL (note reversed meaning): set the bit to disable invalidate of ROP mini cache"

            COMPUTE_OVERRIDE                 = (FE0_CE_TO_COMPUTE | FE0_3D_TO_COMPUTE | FE0_COMPUTE_TO_3D | FE1_CE_TO_COMPUTE), "Compute related overrides"
        END_ENUM_LIST
    Default:        NO_OVERRIDE
END_KEY

BEGIN_KEY AMPERE_FORCE_MUTABLE_AS_HEAVYWEIGHT
    DefinedWhen:     1
    BinaryID:        0x554561
    RemappedName:    D3D_554561
    Type:            dword
    Documentation:   "Force mutable bundles as heavyweight. Ampere's default is lightweight"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE         = 0, "" 
            ENABLE          = 1, ""
        END_ENUM_LIST
    Default:        DISABLE
END_KEY

BEGIN_KEY AMPERE_GCC_CACHE_BUG_WAR
    DefinedWhen:     1
    BinaryID:        0x537561
    RemappedName:    D3D_537561
    Type:            dword
    Documentation:   "Selection of WAR options for GCC cache invalidation bug 200648621"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE              = 0,    "" 
            ALL_LINES_BY_METHOD  = 0x01, "The WAR forces all TSL2 lines to be invalidated by the invalidation methods"
            ALL_GCC_BY_PRI       = 0x02, "The WAR sets PRI to force invalidation of all of GCC"
        END_ENUM_LIST
    Default:        ALL_LINES_BY_METHOD  
END_KEY

//
// RTXIO regkeys
//

BEGIN_KEY RTXIO_FLAGS
    DefinedWhen:        1
    BinaryID:           0xa3c15d
    RemappedName:       D3D_0xa3c15d
    Type:               bool
    Documentation:      "Resource streamer control flags"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                        = 0,    "" 
            VIDMEM_STAGING_ENABLE       = 0x01, "Uses Staging buffer pinned to vidmem for file reads"
            HOST_STAGING_ALWAYS_MAPPED  = 0x02, "Uses host staging buffer mapped for file reads always. Otherwise we map/unmap staging resource for file read and ECL."
            ENABLE_DRIVER_THREAD        = 0x04, "Use internal worker thread (threaded submissions)"
            NVME_BATCH_READS            = 0x08, "NVMeFSBypass submits multiple reads togather."
        END_ENUM_LIST
    Default:            ENABLE_DRIVER_THREAD        
END_KEY


BEGIN_KEY RTXIO_NVME_RESERVED_QUEUES_ENABLE
    DefinedWhen:        1
    BinaryID:           0xa66156
    RemappedName:       D3D_0xa66156
    Type:               bool
    Documentation:      "Use NVMe reserved queues instead of win32 for file reads. This needs nvmetf driver otherwise it would fallback on win32."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0 , ""
            ON,  1, TRUE,  ENABLED   = 1 , ""
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY RTXIO_NVME_USE_LBA_UMD
    DefinedWhen:        1
    BinaryID:           0xa33157
    RemappedName:       D3D_0xa33157
    Type:               dword
    Documentation:      "UMD implementation of LBA translation requires running application in admin mode. Default KMD runs with non-admin."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0 , ""
            ON,  1, TRUE,  ENABLED   = 1 , ""
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY RTXIO_NVME_MAX_READ_PER_CMD
    DefinedWhen:        1
    BinaryID:           0xa33158
    RemappedName:       D3D_0xa33158
    Type:               dword
    Documentation:      "Override the number of bytes being copied in single NVMe read command. default use caps"
    AppProfile
    Default:            0x0
END_KEY

BEGIN_KEY RTXIO_MAX_SOURCE_READ_SIZE
    DefinedWhen:        1
    BinaryID:           0xa3315a
    RemappedName:       D3D_0xa3315a
    Type:               dword
    Documentation:      "Number of KB for the maximum read size. A smaller number implies more read requests. Default is to use staging buffer / maximum number of overlapped reads"
    AppProfile
    Default:            0
END_KEY

BEGIN_KEY RTXIO_OVERRIDE_STAGING_BUFFER_SIZE
    DefinedWhen:        1
    BinaryID:           0xa3315b
    RemappedName:       D3D_0xa3315b
    Type:               dword
    Documentation:      "Number of MB for the staging buffer size. The application provides this number but this is a way we can override it in the driver. The default is 0 to not override."
    AppProfile
    Default:            0
END_KEY

//---------------------------------------------------------------------------
//
// VR Indicator Registry Key
//
//---------------------------------------------------------------------------

BEGIN_KEY VRINDICATOR
    DefinedWhen:        1
    BinaryID:           0xd5e9d3
    RemappedName:       D3D_d52e49d3
    Type:               dword
    Documentation:      "Display the VR indicator"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disable VR indicator"
            SHOW_VR_INDICATOR        = 0x80402010, "Enable VR indicator"
            SHOW_VRS_INDICATOR       = 0x80402011, "Enable VRS indicator"
            SHOW_AUTOVRS_INDICATOR   = 0x80402012, "Enable AutoVRS indicator"
        END_ENUM_LIST
    Default:            DISABLED
END_KEY

//---------------------------------------------------------------------------
//
// VR Features Disable Registry Key
//
//---------------------------------------------------------------------------

BEGIN_KEY VR_FEATURES_DISABLE
    DefinedWhen: 		1
    BinaryID: 			0x4f3289
    RemappedName: 		D3D_371420
    Type: 				dword
    Documentation: 		"Used for disabling VR features : MRS, SPS, LMS, VRS and MVR"
    Values: 			Bitfields
        BEGIN_ENUM_LIST
            NONE                    = 0x00000000, "None of the VR features are disabled"
            MULTI_RES_SHADING       = 0x00000001, "If bit set, disables the Multi-Resolution Shading Feature"
            SINGLE_PASS_STEREO_X    = 0x00000002, "If bit set, disables the Stereo-X Feature"
            LENS_MATCH_SHADING      = 0x00000004, "If bit set, disables the Lens Match Shading Feature"
            VRCOMPOSITOR_NODE       = 0x00000008, "If bit set, disables using SCGCompute node for VR on Pascal. i.e. keeps using LowLatency on Pascal"
            VARIABLE_RATE_SHADING   = 0x00000010, "If bit set, disable the Variable Rate Shading Feature"
            SINGLE_PASS_STEREO_XYZW = 0x00000020, "If bit set, disable the Stereo-XYZW Feature"
            MULTIVIEW_RENDERING     = 0x00000040, "If bit set, disable the Multi-View Rendering Feature"
        END_ENUM_LIST
    Default: 			NONE
END_KEY

//---------------------------------------------------------------------------
//
// Aftermath Registry Key
//
//---------------------------------------------------------------------------

BEGIN_KEY AFTERMATH_ENABLE
    DefinedWhen:        1
    BinaryID:           0x110992
    RemappedName:       D3D_110992
    Type:               bool
    Documentation:      "Use to enable/disable the Aftermath system."
    Values:             Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED = 0x00000000, "Default - normal behaviour."
            ON, 1, TRUE, ENABLED    = 0x00000001, "Force the driver to create an Aftermath system on device creation."
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY AFTERMATH_FLAGS
    DefinedWhen:        1
    BinaryID:           0x110993
    RemappedName:       D3D_110993
    Type:               dword
    Documentation:      "Use to set flags for the Aftermath system. All flags should enable their respective features when set, and disable the feature when unset."
    Values:             Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED     = 0x00000000, "Default - normal behaviour, all features are OFF."
            MARKERS                     = 0x00000001, "When set, marker checkpointing will be available."
            RESOURCE_TRACKING           = 0x00000002, "When set, resource tracking will be available."
            GENERATE_CRASH_DUMPS        = 0x00000004, "When set, create GPU crash dump files if the GPU crash dump monitor is active."
            GENERATE_SHADER_DEBUG_INFO  = 0x00000008, "When set, create shader debug information files if the GPU crash dump monitor is active."
            LOG_TO_FILE                 = 0x20000000, "Log aftermath dump out to a file (AFTERMATH_FILENAME)"
            DETAILED_MARKERS            = 0x40000000, "Insert detailed driver markers (e.g. CPU callstacks)"
            AUTOMATIC_MODE              = 0x80000000, "Aftermath will use run automatically when possible."
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY AFTERMATH_FLAGS_DISABLE_MASK
    DefinedWhen:        1
    BinaryID:           0x11099A
    RemappedName:       D3D_11099A
    Type:               dword
    Documentation:      "Enabling a bit in this mask guarantees that the corresponding flag in AFTERMATH_FLAGS will be force-disabled. This disable happens after all other flag-setting logic and will override all preceding settings."
    Default:            0x0
END_KEY

BEGIN_KEY AFTERMATH_INDICATOR_ENABLE
    DefinedWhen:        1
    BinaryID:           0x110994
    RemappedName:       D3D_110994
    Type:               dword
    Documentation:      "Should we display an indicator when Aftermath is enabled."
    Values:             Bitfields
        BEGIN_ENUM_LIST
            NEVER, 0, OFF, DISABLED = 0x00000000, "Default - Never show overlay."
            ALWAYS, 1 = 0x00000001, "Always show overlay."
            DEVELOPER_MODE_ONLY, 2 = 0x00000002, "Only show overlay when Aftermath developer features are enabled."
        END_ENUM_LIST
    Default:            NEVER
END_KEY

BEGIN_KEY AFTERMATH_INDICATOR_MODE
    DefinedWhen:        1
    BinaryID:           0x11099B
    RemappedName:       D3D_11099B
    Type:               dword
    Documentation:      "Verbosity of Aftermath indicator."
    Values:             Bitfields
        BEGIN_ENUM_LIST
            MINIMAL = 0x00000000, "Default - only shows simple message for on/off and developer mode."
            VERBOSE    = 0x00000001, "Shows detailed overlay with configuration flags and marker counts. Requires AFTERMATH_INDICATOR_ENABLE set to ALWAYS."
        END_ENUM_LIST
    Default:            MINIMAL
END_KEY

