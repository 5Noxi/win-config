            ALLOW_UNKNOWN               = 0x40000000, "Allow GPU cache for unknown surfaces"
            ALLOW_GDI                   = 0x80000000, "Allow GPU cache for GDI allocations"
            ALLOW_ALL                   = 0xc0bf47ff, "Allow GPU cache for all allocations (default)"
