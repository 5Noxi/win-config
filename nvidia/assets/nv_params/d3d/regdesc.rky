            DEPTH_STENCIL_READ                       = 0x00000040, ""
            SHADER_RESOURCE                          = 0x00000080, ""
            STREAM_OUTPUT                            = 0x00000100, ""
            INDIRECT_ARGUMENT_OR_PREDICATION         = 0x00000200, ""
            COPY_DEST                                = 0x00000400, ""
            COPY_SOURCE                              = 0x00000800, ""
            RESOLVE_DEST                             = 0x00001000, ""
            RESOLVE_SOURCE                           = 0x00002000, ""
            RAYTRACING_ACCELERATION_STRUCTURE_READ   = 0x00004000, ""
            RAYTRACING_ACCELERATION_STRUCTURE_WRITE  = 0x00008000, ""
            SHADING_RATE_SOURCE                      = 0x00010000, ""
            NO_ACCESS                                = 0x80000000, ""
            ALL                                      = 0x8001ffff, "All bits set"         
        END_ENUM_LIST
    Default:            ALL
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_DEFERRAL_DISABLE_TRANSITION_STATES
    DefinedWhen:        1
    BinaryID:           0x932717
    RemappedName:       D3D_13497822
    Type:               dword
    Documentation:      "Disable barrier deferral for these transition states (both before/after)"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                              = 0x00000000, "Don't disable any resource state"
            VERTEX_AND_CONSTANT_BUFFER        = 0x00000001, "Disable for vertex and constant buffer state"
            INDEX_BUFFER                      = 0x00000002, "Disable for index buffer state"
            RENDER_TARGET                     = 0x00000004, "Disable for render target state"
            UNORDERED_ACCESS                  = 0x00000008, "Disable for unordered access state"
            DEPTH_WRITE                       = 0x00000010, "Disable for depth write state"
            DEPTH_READ                        = 0x00000020, "Disable for depth read state"
            NON_PIXEL_SHADER_RESOURCE         = 0x00000040, "Disable for non-pixel shader resource state"
            PIXEL_SHADER_RESOURCE             = 0x00000080, "Disable for pixel shader resource state"
            STREAM_OUT                        = 0x00000100, "Disable for stream out state"
            INDIRECT_ARGUMENT                 = 0x00000200, "Disable for indirect argument state"
            COPY_DEST                         = 0x00000400, "Disable for copy destination state"
            COPY_SOURCE                       = 0x00000800, "Disable for copy source state"
            RESOLVE_DEST                      = 0x00001000, "Disable for resolve destination state"
            RESOLVE_SOURCE                    = 0x00002000, "Disable for resolve source state"
            SHADING_RATE_SOURCE               = 0x01000000, "Disable for shading reate source state"
            RAYTRACING_ACCELERATION_STRUCTURE = 0x00400000, "Disable for accelleration structure state (shouldn't be encountered for now, invalid in API)"
            COMMON                            = 0x80000000, "Disable for common state"
        END_ENUM_LIST
    Default:            NONE
END_KEY

