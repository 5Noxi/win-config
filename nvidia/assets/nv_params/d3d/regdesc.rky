// See bugs 200437191 and 200447350 and 200709271 for the reasons behind the default value for the below key
BEGIN_KEY CONVERT_TO_LDG_ENABLES
    DefinedWhen:     1
    BinaryID:        0xcbe005
    RemappedName:    D3D_0xcbe005
    Type:            dword
    Documentation:   "This regkey specifies enabled functionality used by convert-to-LDG"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE                  = 0x00, ""
            UNUSED                = 0x01, "Formerly OCG_RANGE, which is now permanently the way of things"
            OCG_RANGE_HEADER      = 0x02, "Use the OCG OOR check in getVAandSizeFromResource - this will enable constExpr for the header loads"
            ULDC_LOAD             = 0x04, "Allow conversion from LDG to ULDC for data loads"
            ULDC_LOAD_HEADER      = 0x18, "Allow conversion from LDG to ULDC for header loads."
            ULDC_LOAD_HEADER11    = 0x08, "Allow conversion from LDG to ULDC for header loads. DX11 only"
            ULDC_LOAD_HEADER12    = 0x10, "Allow conversion from LDG to ULDC for header loads. DX12 only"
            REDUCED_TEXHEADER11   = 0x40, "Use a simplified (VA and Size) header for anything that will *only* be done with CtLDG, DX11 only"
            REDUCED_TEXHEADER12   = 0x80, "Same thing as above, but for DX12"

            ULDC_LOAD_DISABLE_CONST_INVALIDATION           = 0x300, "Disable const cache invalidations for ULDC loads of data per PSO change."
            ULDC_LOAD_DISABLE_CONST_INVALIDATION11         = 0x100, "Disable const cache invalidations for ULDC loads of data per PSO change. For DX11 only"
            ULDC_LOAD_DISABLE_CONST_INVALIDATION12         = 0x200, "Disable const cache invalidations for ULDC loads of data per PSO change. For DX12 only"
            ULDC_LOAD_HEADER_DISABLE_CONST_INVALIDATION    = 0xc00, "Disable const cache invalidations for header ULDC loads per PSO change."
            ULDC_LOAD_HEADER_DISABLE_CONST_INVALIDATION11  = 0x400, "Disable const cache invalidations for header ULDC loads per PSO change. For DX11 only"
            ULDC_LOAD_HEADER_DISABLE_CONST_INVALIDATION12  = 0x800, "Disable const cache invalidations for header ULDC loads per PSO change. For DX12 only"
        END_ENUM_LIST
    Default:         NONE
END_KEY

// The enums here must match those of DXILLDCToLDGTranslationMode (DXILCompiler.h) as they are used directly
