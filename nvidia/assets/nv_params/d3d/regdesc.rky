BEGIN_KEY ADA_A_TILEDCACHE_CONTROL_EXTENDED
    DefinedWhen:        1
    BinaryID:           0x212302
    RemappedName:       D3D_0x212302
    Type:               DWORD
    Documentation:      "Set value of TiledCacheControlExtended method"
    Values: Bitfields
        BEGIN_ENUM_LIST
            LEVEL1_BBOX_PRIM_COUNT_MASK                                     = 0x0000003F, "Level1 Bounding Box Primcount Mask"
            LEVEL1_BBOX_PRIM_COUNT_SHIFT                                    =          0, "First bit of LEVEL1_BBOX_PRIM_COUNT"
            MAX_CYCLES_WITHOUT_BINNER_DRAIN_MASK                            = 0x00000FC0, "Max cycles Without Binner Drain Mask"
            MAX_CYCLES_WITHOUT_BINNER_DRAIN_SHIFT                           =          6, "First bit of MAX_CYCLES_WITHOUT_BINNER_DRAIN"
            AREA_THRESHOLD_MASK                                             = 0x0001F000, "HW heuristic scaling factor (2.3 bit fixed point) Mask"
            AREA_THRESHOLD_SHIFT                                            =         12, "First bit of HW heuristic scaling factor"
            UNUSED_MASK                                                     = 0xFFFE0000, "Unused bits"
            UNUSED_SHIFT                                                    =         17, "First unused bit"
        END_ENUM_LIST
    // Default Area Threshold Heuristic value is 1.75 (determined by Arch pre-silicon testing)
    Default:            0x0000E008
END_KEY

