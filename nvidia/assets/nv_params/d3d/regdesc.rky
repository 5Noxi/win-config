    Values: Bitfields
       BEGIN_ENUM_LIST
            DISABLE                         = 0x00000001, "Disable tiled resources cap"
            DISABLE_TILE_POOL_MULTIALLOC    = 0x00000002, "Force single allocs for tile pools"
            UNUSED                          = 0x00000004, "Unused"
            FORCE_RT_DS_RESOURCES_TILED     = 0x00000008, "Forces rendertarget and depthstencil textures to be created as tiled resources.  Dx11 only.  Doesn't force shared, present and internal resources"
        END_ENUM_LIST
