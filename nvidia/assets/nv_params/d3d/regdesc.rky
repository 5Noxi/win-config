BEGIN_KEY SLI_BRIDGELESS_OPTIMIZATION
    DefinedWhen:        1
    BinaryID:           0xa67bad
    RemappedName:       D3D_49501226
    Type:               dword
    Documentation:      "Control optimization of bridgeless SLI using extra primary and async copy engine"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            AUTO_SELECT                                                     = 0x1,  "Allow the driver to take decision"
            FORCE_ON                                                        = 0x2,  "Enforce bridgeless mode (even on bridged configs)"
            FORCE_OFF                                                       = 0x4,  "Disable bridgeless optimization (even on supported configs)"
            SHOW_INDICATOR                                                  = 0x8,  "Enable Indicator for bridgeless SLI optimization"
            DISABLE_CHANNEL_PRESENT_COPY                                    = 0x10, "Disables usage CHANNEL_PRESENT_COPY for SLI present transfers optimization"
            DISABLE_FLEXI_PRESENT_CHANNEL                                   = 0x20, "Disables switching between CHANNEL_PRESENT_COPY and CHANNEL_ASYNC_COPY for present transfers"
            COPY_ON_3D_FOR_EXPLICIT_DX12                                    = 0x40, "Use 3D engine for frame transfer in explicit Dx12 (default is CE)"
            USE_MOSAIC_SCANOUT_OFFSET                                       = 0x80, "For scanout composition, use the legacy mosaic escape to get the offset for present transfers"
        END_ENUM_LIST
    Default:            AUTO_SELECT
END_KEY

