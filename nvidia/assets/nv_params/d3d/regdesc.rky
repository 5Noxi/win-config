    DefinedWhen:        1
    BinaryID:           0x896741
    RemappedName:       D3D_896741
    Type:               bool
    Documentation:      "Enable hotkey mode. This causes the feature to get enabled only when using the hotkey (CTRL+F12) and alternates sample positions every frame even when vsync is off/windowed mode."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, ""
            ON,  1, TRUE,  ENABLED   = 1, ""
        END_ENUM_LIST
        Default: OFF
END_KEY

BEGIN_KEY MAXWELL_B_SAMPLE_INTERLEAVE_PROFILED_SHADERS
    DefinedWhen:        1
    BinaryID:           0xab4312
    RemappedName:       D3D_ab4312
    Type:               wstring
    Documentation:      "Comma seperated list of shader hashes that need IPA to IPA.offset modification. Used when PATCH_ATTRIBUTE_EVAL_OFFSETS_ONLY_PROFILED_SHADERS bit is set in MAXWELL_B_SAMPLE_INTERLEAVE_SETTINGS. Note that no. of shaders is currently limited to 10 (MAX_PATCHED_SHADERS defined in nvPSMaxwellSampleInterleave.h)"
END_KEY

BEGIN_KEY TSF_ENABLE
    DefinedWhen:        1
    BinaryID:           0x853748
    RemappedName:       D3D_853748
