           DEFAULT_VALUE    = 0x00000000, "Default value for CPU frequency"
       END_ENUM_LIST
   Default:             DEFAULT_VALUE
END_KEY

BEGIN_KEY CONDITIONAL_COPY_QUEUE_PROMOTION_MSHYBRID
    DefinedWhen:        1
    BinaryID:           0x211021
    RemappedName:       D3D_211021
    Type:               dword
    Documentation:      "Conditionally promote only DX runtime created copy commandlist/queue which have a cross adapter copy queued on it. If zero, all copy commandlist/queues on MSHybrid will be promoted to support 3D"
    Values: Samples:LimitValuesToList
       BEGIN_ENUM_LIST
           DISABLED, OFF, 0, FALSE  = 0x0, "Promote all copy commandlist/queues on MSHybrid to support 3D"
           ENABLED, ON,  1, TRUE   = 0x1, "Conditionally promote only DX runtime created copy commandlist/queue which have a cross adapter copy queued"
       END_ENUM_LIST
   Default:            ENABLED
END_KEY

