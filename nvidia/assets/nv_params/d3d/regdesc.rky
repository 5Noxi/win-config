BEGIN_KEY DXR_ENABLE
    DefinedWhen:        1
    BinaryID:           0xde429a
    RemappedName:       D3D_0xde429a
    Type:               bool
    Documentation:      "Control the reporting of DXR support via the D3D cap.  Can only cause forced disable, cannot force enable."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, ""
            ON,  1, TRUE,  ENABLED   = 1, ""
        END_ENUM_LIST
    Default: ON
END_KEY

BEGIN_KEY DXR_TIER_OVERRIDE
    DefinedWhen:        1
    BinaryID:           0x8ee432
    RemappedName:       D3D_7c0601
    Type:               dword
    Documentation:      "Flags to force DXR tier support caps disable"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            FORCE_TIER_DEFAULT  = 0x00000000, "Caps expose default DXR tier"
            FORCE_TIER_1_0      = 0x00000001, "Force caps to expose D3D12DDI_RAYTRACING_TIER_1_0"
            FORCE_TIER_1_1      = 0x00000002, "Force caps to expose D3D12DDI_RAYTRACING_TIER_1_1"
        END_ENUM_LIST
    Default: FORCE_TIER_DEFAULT
END_KEY

BEGIN_KEY DXR_CONVERT_TO_LDG_FLAGS
    DefinedWhen:     1
    BinaryID:        0x8ce000
    RemappedName:    D3D_0x8ce000
    Type:            dword
    Documentation:   "This regkey specifies flags used by buffer load LDG emulation for DXR"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE              = 0x00, ""
            NORANGECHECK      = 0x01, "Disable range checking for converted loads"
            DISABLESRV        = 0x02, "Disable convert-to-ldg for SRVs"
            DISABLEUAV        = 0x04, "Disable convert-to-ldg for UAVs"
            BRANCHLESS_HEADER = 0x08, "Use branchless load for header"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_CONVERT_TO_LDG_TYPES
    DefinedWhen:     1
    BinaryID:        0x8ce001
    RemappedName:    D3D_0x8ce001
    Type:            dword
    Documentation:   "This regkey specifies the types of buffer load LDG emulation to be done for DXR"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE            = 0x0, "No Emulation"
            UNUSED1         = 0x1, "Unused"
            UNUSED2         = 0x2, "Unused"
            STRUCTURED_LOAD = 0x4, "Emulate ld_structured with LDG"
            RAW_LOAD        = 0x8, "Emulate ld_raw with LDG"
            ALL             = 0xf, "All handled types are emulated"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_CONVERT_TO_LDG_SHADERS
    DefinedWhen:     1
    BinaryID:        0x8ce002
    RemappedName:    D3D_0x8ce002
    Type:            dword
    Documentation:   "This regkey specifies the DXR shaders to which buffer load LDG emulation applies"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE                = 0x00, "No Emulation"
            RAYGEN_SHADER       = 0x01, "Emulate for raygen shaders"
            MISS_SHADER         = 0x02, "Emulate for miss shaders"
            CLOSESTHIT_SHADER   = 0x04, "Emulate for closesthit shaders"
            ANYHIT_SHADER       = 0x08, "Emulate for anyhit shaders"
            INTERSECTION_SHADER = 0x10, "Emulate for intersection shaders"
            CALLABLE_SHADER     = 0x20, "Emulate for callable shaders"
            ALL                 = 0x3f, "Emulate for all shader stages"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY DXR_PASCAL_MIN_FB_SIZE
    DefinedWhen:        1
