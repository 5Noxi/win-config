BEGIN_KEY D3D_DC_CONTROL
    DefinedWhen:        1
    RemappedName:       D3D_31482008
    BinaryID:           0x1208cb
    Type:               dword
    Documentation:      "Deferred context control flags"
    Values: Bitfields
       BEGIN_ENUM_LIST
            DISABLE_DC_D3D11                = 0x00000001, "Disable DC cap for D3D11 (falls back to runtime replay)"
            ENABLE_REPLAY_D3D12             = 0x00000004, "Use driver replay DC on D3D12.  Else baked."
            ENABLE_REPLAY_ALL               = 0x00000008, "Use driver replay DC all the time."
            ENABLE_BAKED_BUNDLES            = 0x00000010, "Use baked (non-replay) bundles."
        END_ENUM_LIST
    Default:            0x00000010
END_KEY

BEGIN_KEY D3D12_BUNDLE_BAKE_THRESHOLDS
