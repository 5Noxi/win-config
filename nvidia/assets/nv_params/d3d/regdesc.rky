BEGIN_KEY PS_SURFACE_PLACEMENT_HIGHEST_PRIORITY
    DefinedWhen:        1
    BinaryID:           0x6BDD49
    RemappedName:       D3D_75137491
    Type:               dword
    Documentation:      "Normally, render targets and Z buffers use high priority.  This regkey allows selective use of maximum priority, equivalent to D3DDDI_ALLOCATIONPRIORITY_MAXIMUM for these buffers."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            PRIORITY_HIGH                 = 0x187F7082, "RTs/ZBs use high priority (default)"
            PRIORITY_MAXIMUM              = 0x83B7BC1A, "RTs/ZBs use maximum priority"
            PRIORITY_MAXIMUM_IF_MIXED_BUS = 0xFC17F610, "RTs/ZBs use maximum priority on mnixed-bus GPUs (192-bit 2 GB, etc.)"
        END_ENUM_LIST
    Default: PRIORITY_HIGH
END_KEY

