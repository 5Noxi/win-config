BEGIN_KEY D3D12_DESCHEAP_READ_AT_CL_RECORD
    DefinedWhen:        1
    RemappedName:       D3D_20151820
    BinaryID:           0xde5c4d
    Type:               bool
    Documentation:      "Controls when the desc heap contents are read for some bind points"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Default D3D12 behavior - desc heap contents only guaranteed at execute"
            ON,  1, TRUE,  ENABLED   = 0x00000001, "The app promises that the desc heap contents will be immutable from record to execute"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY D3D12_DESCRIPTOR_PROMOTION
    DefinedWhen:        1
    RemappedName:       D3D_32195415
    BinaryID:           0x132a94
    Type:               dword
    Documentation:      "Controls when the we promote descriptor table entries to the root table"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Default D3D12 behavior - no promotion"
            CBV_GRAPHICS             = 0x00000001, "Promote CBV descriptors from descriptor tables to the root table for graphics"
            CBV_COMPUTE              = 0x00000002, "Promote CBV descriptors from descriptor tables to the root table for compute"
            PROMOTE_UNINITIALIZED    = 0x00000004, "Promote descriptor table entries, even if they are uninitialized (due to root signature changes etc"
        END_ENUM_LIST
    Default:            0x0
END_KEY

BEGIN_KEY D3D12_DESCRIPTOR_PROMOTION_FLAGS
    DefinedWhen:        1
    RemappedName:       D3D_34185314
    BinaryID:           0x149b83
    Type:               dword
    Documentation:      "Controls when the we promote descriptor table entries to the root table"
    Values: Bitfields
        BEGIN_ENUM_LIST
            CTAS_SHIFT_MASK                  = 0x0000000f, "Encode max number of CTAS to launch. The value in the mask will indicate CTAS to launch == 1 << CTA_SHIFT. All bits set == 1 thread per patch"
            CTAS_SHIFT_SHIFT                 = 0,          "Amount of right shift for the CTAS_SHIFT"
            THREADS_PER_CTA_MASK             = 0x000003f0, "Each CTA is 32 * this amount"
            THREADS_PER_CTA_SHIFT            = 4,          "Amount of right shift for THREADS_PER_CTA"
            USE_BAR_FOR_PATCH_ENTRIES        = 0x400,      "Use BAR1 vidmem for patch data"
            USE_VIDMEM_GPFIFO_FOR_PATCH_DST  = 0x800,      "Use vidmem GPFIFO entries for the root data updates"
            USE_DESCHEAP_GPFIFO_DIRECT_PATCH = 0x1000,     "Use GPFIFO + MME to patch root table entries directly from the descriptor heap"
        END_ENUM_LIST
    Default:            0x200
END_KEY


