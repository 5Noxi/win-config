        BEGIN_ENUM_LIST
            OFF, 0, FALSE  = 0x00000000, ""
            ON,  1, TRUE   = 0x00000001, ""
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_OVERRIDES
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x47b891
    RemappedName:       D3D_15437531
    Type:               dword
    Documentation:      "Override certain barriers. For experimental use only."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE                            = 0x00000000, "Default. No override."
            RT_TO_SRV_OVERRIDE                       = 0x00000001, "Override transition barriers of RT->NON_PS_SRV|SRV and make them RT->SRV. Leads to more PSBs. May corrupt images."
            DEFER_COPY_BARRIERS_UNTIL_DRAW           = 0x00000002, "Defer copy dst related (to/from) transition barriers until first draw. Only happens at the beginning of CLs"
            DEFER_COPY_BARRIERS_UNTIL_DRAW_ALWAYS_ON = 0x00000006, "Same as above, but keep this active through the entire CL, don't turn off at first draw"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_DEFERRAL
    DefinedWhen:        1
    BinaryID:           0x49c741
    RemappedName:       D3D_25367753
    Type:               dword
    Documentation:      "Defer barriers until needed."
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE                            = 0x00000000, "Default. No override."
            DEFER_ALL                                = 0x00000008, "Defer barriers until needed by next draw/dispatch/copy"     
            DEFER_ALL_UNTIL_PCAS                     = 0x00000010, "DEFER ALL but also defer compute until PCAS. Experimental."
            DEFER_ALL_CROSS_CL_DEFERRAL              = 0x00000020, "DEFER ALL plus cross CL deferral. Defer resolving end of CL barriers until ECL time"
            DEFER_ALL_PRE_CROSS_CL_DEFERRAL          = 0x00000040, "DEFER ALL with cross cl deferral enabled, plus defer CL barriers until ECL time. Experimental."
            DEFER_ALL_NO_GRAPHICS_OPTIMIZATIONS      = 0x00000080, "DEFER_ALL but with graphics optimizations turned off. For experiments."
            DEFER_ALL_DISCARD_IN_DISPATCH_TABLE      = 0x00000100, "DEFER ALL but always resolve pending syncs through dispatch table, regardless if discard is NOP or not. For experiments."
            DO_ONLY_SYNC_NO_DEFERRAL                 = 0x00010000, "Do all the synchronization and invalidation immediately at the end of the barrier DDI, and don't defer them. For debugging."
            NO_WFI_REMOVAL                           = 0x00020000, "Don't use reference value to remove any barriers, but always issue the synchronization"
            KEEP_REDUNDANT_BARRIERS                  = 0x00040000, "Don't remove redundant (readonly->readonly subset) barriers"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_DEFERRAL_QUEUE_TYPES
    DefinedWhen:        1
    BinaryID:           0x38a323
    RemappedName:       D3D_58216654
    Type:               dword
    Documentation:      "Enable barrier deferral on these queues only"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DIRECT                           = 0x00000001, "Enable barrier deferal on direct queue"     
            COMPUTE_ONLY                     = 0x00000002, "Enable barrier deferral on compute only queues"
            COPY_ONLY                        = 0x00000004, "Enable barrier deferral on copy only queues"
        END_ENUM_LIST
    Default:            DIRECT
END_KEY

BEGIN_KEY PS_DX12_RESOURCE_BARRIER_DEFERRAL_BARRIER_TYPES
    DefinedWhen:        1
    BinaryID:           0x249239
    RemappedName:       D3D_54123398
    Type:               dword
