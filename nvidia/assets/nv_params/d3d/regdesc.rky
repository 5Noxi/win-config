        BEGIN_ENUM_LIST
            DISABLED, OFF            = 0, "Compute MME is not supported on GA10x+"
            ENABLED, ON              = 1, "Compute MME is supported on GA10x+"
        END_ENUM_LIST
    Default: ENABLED
END_KEY

BEGIN_KEY ENABLE_COMPUTEMME_BACKINGSTORE_CLEAR_ONCREATE
    DefinedWhen:        1
    BinaryID:           0xF42AD6
    RemappedName:       D3D_F42AD6
    Type:               bool
    Documentation:      "Enable this to have some known initial state of computemme backing store to help catch any bugs with MME dataRAM usage"
    UserVisible
    UserVisibleName:    " "    
    NvInternalSetting
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DISABLED, OFF            = 0, "Compute MME backing store content is not initialized to known state"
            ENABLED, ON              = 1, "Clears the compute MME backing store to known state (say 0xffffff) on create"
        END_ENUM_LIST
    Default: ENABLED
END_KEY

BEGIN_KEY DISABLE_COMPUTE_MME_FOR_OPERATION
    DefinedWhen:        1
    BinaryID:           0xF42AC0
    RemappedName:       D3D_F42AC0
    Type:               dword
    Documentation:      "Setting to disable compute MME stuff for the said operation on supported hardware(i.e GA10x+) "
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            CPU_SIDE_CB_UPLOAD_BY_I2MME      = 0x00000001, "Disable  Use of I2DmaWrite for CPU-side sections of GSCB"
            FILTER_SETDESCRIPTORHEAP_METHODS = 0x00000002, "Disable  MME macro that filter redundant SetTexHeader/Sampler pool VA methods"
            SAVE_RESTORE_MME_ON_FE1          = 0x00000004, "Disable  Save-Restore macros that get injected on compute VEID switches on FE1"
            COPY_GSCSECTIONS_TO_GSCB         = 0x00000008, "Disable  MME macro that uploads few global shader constants like texheader pool VA into ComputestateCB and fallback to i2m path"
            POLL_FOR_DATARAM_REUSE           = 0x00000010, "Disable  MME macro that polls to check if DataRam can be overwritten by next dispatch without corrupting earlier one"
            BUILD_QMD                        = 0x00000100, "Disable  building QMDs with MME"
            INCREMENTAL_BUILD_QMD            = 0x00000200, "Disable  incremental building of QMDs with MME"
            SKIP_CPU_SIDE_QMD_UPDATE         = 0x00000400, "Disable  skiping CPU-side QMD updates (relevant for release/develop builds only, forced disabled in debug)"
        END_ENUM_LIST
     Default: 0
END_KEY

