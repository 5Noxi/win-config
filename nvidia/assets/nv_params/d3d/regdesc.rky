            LOW_NODE                                                        = 1, "CE5 - NodeDmaCopyLow - Alias to CE2"
            MEDIUM_NODE                                                     = 2, "CE4 - NodeDmaCopyMedium - Alias to CE1"
            HIGH_NODE                                                       = 3, "CE3 - NodeDmaCopyHigh - Alias to CE0"
            CE0_NODE                                                        = 4, "CE0 - default CE for paging"
            CE1_NODE                                                        = 5, "CE1 - default CE for sysmem access (see COPY_ENGINE key)"
            CE2_NODE                                                        = 6, "CE2 - fastest CE for NVLINK (multiple PCEs assigned to this LCE)"
            DISABLE_MASK                                                    = 0xf0000000, "mask of bits controlling individual driver disablement"
            DISABLE_DX11                                                    = 0x10000000, "Disable the channel for DX11"
            DISABLE_DX12                                                    = 0x20000000, "Disable the channel for DX12"
        END_ENUM_LIST
        // DISABLE_DX12 | CE2_NODE
