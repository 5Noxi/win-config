            EARLY_PUSH_1x1xR32                                                            = 0x20000000, "Temp hack - force early push f 1x1 R32 textues (HDR)"
            LASTMINUTE_FIXES                                                              = 0x40000000, "use this bit for the critical last minute's fixes."
            OVERRIDE_BIT                                                                  = 0x80000000, "makes the global profile override app's profile"
