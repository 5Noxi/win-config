            MEDIUM_NODE                                                     = 2, "CHANNEL_PRESENT_COPY created on virtual node NodeDmaCopyMedium"
            HIGH_NODE                                                       = 3, "CHANNEL_PRESENT_COPY created on virtual node NodeDmaCopyHigh"
            CE0_NODE                                                        = 4, "CHANNEL_PRESENT_COPY created on physical Node CE0"
            CE1_NODE                                                        = 5, "CHANNEL_PRESENT_COPY created on physical Node CE1"
