    DefinedWhen:        1
    BinaryID:           0x211022
    RemappedName:       D3D_211022
    Type:               dword
    Documentation:      "Bug 200442345 : Workaround for N+1 frame rendering problem when capturing cyclestats data with END_FRAME=N"
    Values: Samples:LimitValuesToList
       BEGIN_ENUM_LIST
           DISABLED, OFF, 0, FALSE  = 0x0, ""
           ENABLED, ON,  1, TRUE   = 0x1, ""
       END_ENUM_LIST
   Default:            DISABLED
END_KEY

BEGIN_KEY PS_GPUKERNEL_DEBUG_HELPER_FLAGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x97d6b7
    RemappedName:       D3D_97d6b7
    Type:               dword
    Documentation:      ""
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_BREAK_ON_ASSERT     = 0x00000001, "Disable debug break on gpukAssert messages"
            ENABLE_BREAK_ON_SNAPSHOT    = 0x00000002, "Enable debug break on gpukDebugSnapshot messages"
            ENABLE_BREAK_ON_WARNING     = 0x00000004, "Enable debug break on gpukWarning messages"
            LOG_ASSERTS                 = 0x00000010, "Write gpukAssert messages to a file in PS_FILE_PATH"
            LOG_DEBUG_SNAPSHOTS         = 0x00000020, "Write gpukDebugSnapshot messages to a file in PS_FILE_PATH"
            LOG_PRINTS                  = 0x00000040, "Write gpukPrint messages to a file in PS_FILE_PATH"
            LOG_WARNINGS                = 0x00000080, "Write gpukWarning messages to a file in PS_FILE_PATH"
            LOG_ALL                     = 0x000000F0, "Write all GPUKernel messages to a file in PS_FILE_PATH"
        END_ENUM_LIST
