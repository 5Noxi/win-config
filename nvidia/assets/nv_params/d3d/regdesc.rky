    Documentation:      "Control dumping of intermediate DXIL/NVVM files for DXR. Respects PS_FILE_PATH."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "Never dump intermediate DXIL/NVVM files for DXR"
            ON,  1, TRUE,  ENABLED                          = 0x00000001, "Always dump intermediate DXIL/NVVM files for DXR"
        END_ENUM_LIST
    Default:        0
END_KEY


