            PS_REG_ALLOC_POLICY_THIN  = 0x00000000, "Use THIN allocation policy."
            PS_REG_ALLOC_POLICY_THICK = 0x00000002, "Use THICK allocation policy."
       END_ENUM_LIST
    Default:            0        
END_KEY

