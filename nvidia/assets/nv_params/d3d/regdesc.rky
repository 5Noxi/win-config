    DefinedWhen:        1
    BinaryID:           0xababd7
    RemappedName:       D3D_ababd7
    Type:               bool
    Documentation:      "Regkey to enable new/low-overhead CBL path for DXML (currently only affects metacommand path)"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default: ON
END_KEY

BEGIN_KEY DXML_USE_DEP_QMD_LAUNCHES
    DefinedWhen:        1
    BinaryID:           0xabcd32
    RemappedName:       D3D_abcd32
