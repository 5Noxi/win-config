BEGIN_KEY LOW_LATENCY_MODE
    DefinedWhen:        1
    BinaryID:           0x45AB1F
    RemappedName:       D3D_45AB1F
    Type:               dword
    Documentation:      "Low latency mode settings. Disabled by default (to enable set VSYNCMODE=VIRTUAL).  When enabled this provides a mode which is similar to 'vsync ON' - i.e, no tearing, but has fps/latency similar to 'vsync OFF'. The idea is to let the app render as fast it can and present the latest frame at vblank. The BLEND mode enables temporal supersampling using a exponential decay filter by making use of the additional rendered frames to smoothen out the animation."
    Values: Bitfields
        BEGIN_ENUM_LIST
            ALLOW               = 0x00000001, "Allows LOW Latency VSync (Fast Sync). Set this bit to 0 for denylisting the app."                
            BLEND               = 0x00000002, "Enable Blending. Might result in slightly higher latency but smoother animation. Use LOW_LATENCY_BLEND_FACTOR to control blending factor."
            DYNAMIC_FPS_CAP     = 0x00000004, "Enable Dynamic fps limit to cap to a multiple of refresh rate."
            COLLAPSE_FLIP       = 0x00000008, "Enable Display hardware's collapseFlip mechanism to pick the latest rendered frame."
        END_ENUM_LIST
        Default: ALLOW|DYNAMIC_FPS_CAP|COLLAPSE_FLIP
END_KEY

BEGIN_KEY LOW_LATENCY_BLEND_FACTOR
    DefinedWhen:        1
    BinaryID:           0xbf0871
    RemappedName:       D3D_bf0871
    Type:               dword
    Documentation:      "Blend factor to use for low-latency blend mode. This value is divided by 255.0f before passing to the filter shader. (it's dword because our DRS profile framework won't accept floats in app profile). Default is 127 (for 0.5f)"
    Default:            127
END_KEY

