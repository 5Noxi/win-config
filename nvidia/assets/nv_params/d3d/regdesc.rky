END_KEY

BEGIN_KEY METACOMMAND_LOG
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xababcd
    RemappedName:       D3D_ababcd
    Type:               dword
    Documentation:      "Enable Metacommand logs"
    Values: Bitfields
        BEGIN_ENUM_LIST
            LOG_CREATE          = 0x00000001, "Log create calls, and unsupported errors."
            LOG_QUERY           = 0x00000002, "Log query calls."
            LOG_INIT_EXECUTE    = 0x00000004, "Log init and execute calls."
            DETAILED_PARAM_LOG  = 0x00000008, "Log all paramater details for query and create calls. (Need to enable LOG_CREATE/LOG_QUERY bits too)"
            DUMP_OP_TENSOR_DATA = 0x00000010, "Dump output tensor at time of execute."
            DUMP_IP_TENSOR_DATA = 0x00000020, "Dump input tensors at time of execute."
        END_ENUM_LIST
    Default: 0
END_KEY

