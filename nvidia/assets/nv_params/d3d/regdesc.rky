            CB_HIGH_THRESHOLD_MASK  = 0x0000FF00, "Mask for CBTBL high threshold"
            CB_MAX_THRESHOLD_MASK   = 0xFFFF0000, "Mask for CBTBL max threshold (Maxwell multi-GPC only)"
       END_ENUM_LIST
