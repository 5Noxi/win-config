BEGIN_KEY USE_INCREMENT_PUT_PRE_GA10x
    DefinedWhen:        1
    BinaryID:           0xabdb11
    RemappedName:       D3D_abdb11
    Type:               bool
    Documentation:      "Use increment put instead of PushAlloc on pre-GA10x for launching the first task of producer-consumer compute queues. GA10x+ always uses IncrementPut with delta"
    UserVisible
    UserVisibleName:    " "
    NvInternalSetting
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST 
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x00000001, "Enabled"
        END_ENUM_LIST
    Default: OFF
END_KEY

BEGIN_KEY NVAPI_GWC_USE_LOCAL_ROOT_TABLE
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xabab12
    RemappedName:       D3D_abab12
    Type:               bool
    Documentation:      "Use local root table (populated in GPU memory by the app) for GWC shaders instead of the global root table (i.e, root table set on command list). Only for testing/debugging - apps are always expected to use local root table"
    UserVisible
    UserVisibleName:    " "
    NvInternalSetting
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST 
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x00000001, "Enabled"
        END_ENUM_LIST
    Default: ON
END_KEY


