            ALIASING          = 0x00000002, "Enable barrier deferral for aliasing barriers"
            UAV               = 0x00000004, "Enable barrier deferral for UAV barriers"
            RANGED            = 0x00000008, "Enable barrier deferral for ranged barriers"
            ALL               = 0x0000000f, "Enable barrier deferral for all types of barriers"            
        END_ENUM_LIST
    Default:            ALL
END_KEY

