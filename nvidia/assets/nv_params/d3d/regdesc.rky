    DISABLE_WRITE_CONVERSION                = 0x00000002, "Ignore sRGB writes"
    DISABLE_READ_CONVERSION                 = 0x00000004, "Ignore sRGB reads"
    DISABLE_BLIT_READ_CONVERSION            = 0x00000008, "Ignore sRGB blit reads"
    DISABLE_BLIT_WRITE_CONVERSION           = 0x00000010, "Ignore sRGB blit writes"
    ON                                      = 0x0000001e, "Disable sRGB"
