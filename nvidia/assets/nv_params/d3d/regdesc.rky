            CUBIN_NVAPI_DX11 = 0x00000001, "Enable CBL path for DX11 cubin NVAPIs"
            CUBIN_NVAPI_DX12 = 0x00000002, "Enable CBL path for DX12 cubin NVAPIs"
        END_ENUM_LIST
    Default:            0x3
END_KEY

