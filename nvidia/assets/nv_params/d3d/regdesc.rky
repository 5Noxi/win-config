BEGIN_KEY COMPUTE_UAV_HAZARD_CONTROL
    DefinedWhen:     PERF_STRATEGY_REGKEYS
    BinaryID:        0xa25fc6
    RemappedName:    D3D_0xa25fc6
    Type:            dword
    Documentation:   "control for handling compute uav hazards"
    Values: Samples
        BEGIN_ENUM_LIST
            DRIVER_CONTROLLED            = 0, "Right now, default == use semaphore"
            FORCE_WFI                    = 1, ""
            FORCE_SEMAPHORE              = 2, ""
            IGNORE_HAZARD                = 4, ""
            MODE_CONTROL_MASK            = 0xFF, "The mask for the field representing above modes"

            DISABLE_GP10x_HYSTERESIS     = 0x100, " a flag to disable GP10x CWD hysteresis on CS to CS hazards"
            FORCE_FE_METHOD_SEMAPHORE    = 0x200, " a flag to force FE method semaphore in addition to QMD seaphores on CS to CS hazards (old code)"
        END_ENUM_LIST
    Default:        DRIVER_CONTROLLED
END_KEY

BEGIN_KEY SCG_GR_HAZARD_CONTROL
    DefinedWhen:     PERF_STRATEGY_REGKEYS
