            FORCE_NO_OPAQUE   = 2, ""
            TERM_ON_FIRST_HIT = 4, ""
            SKIP_CLOSEST_HIT  = 8, ""
            CULL_BACK_FACING  = 16, ""
            CULL_FRONT_FACING = 32, ""
            CULL_OPAQUE       = 64, ""
            CULL_NON_OPAQUE   = 128, ""
            SKIP_TRIANGLES    = 256, ""
            SKIP_AABBS        = 512, ""
        END_ENUM_LIST
    Default: DEFAULT
END_KEY


BEGIN_KEY RAYQUERY_AND_FLAGS
    DefinedWhen:     1
    BinaryID:        0x50a158
    RemappedName:    D3D_0x50a158
    Type:            dword
    Documentation:   "Inline ray query template flags are bitwise ANDed with this value"
  AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            DEFAULT                  = 0xFFFFFFFF, "Default."
            CLEAR_FORCE_OPAQUE       = 0xFFFFFFFE, ""
            CLEAR_FORCE_NO_OPAQUE    = 0xFFFFFFFD, ""
            CLEAR_TERM_ON_FIRST_HIT  = 0xFFFFFFFB, ""
            CLEAR_SKIP_CLOSEST_HIT   = 0xFFFFFFF7, ""
            CLEAR_CULL_BACK_FACING   = 0xFFFFFFEF, ""
            CLEAR_CULL_FRONT_FACING  = 0xFFFFFFDF, ""
            CLEAR_CULL_OPAQUE        = 0xFFFFFFBF, ""
            CLEAR_CULL_NON_OPAQUE    = 0xFFFFFF7F, ""
            CLEAR_SKIP_TRIANGLES     = 0xFFFFFEFF, ""
            CLEAR_SKIP_AABBS         = 0xFFFFFDFF, ""
        END_ENUM_LIST
    Default: DEFAULT
END_KEY


BEGIN_KEY DXR_MAX_PAYLOAD_REGISTERS
    DefinedWhen:     1
    BinaryID:        0x50a160
    RemappedName:    D3D_0x50a160
    Type:            dword
    Documentation:   "Sets the maximum number of payload registers used for DXR. This value cannot exceed RTCore's limit and will be capped."
    AppProfile
    Values: Bitfields
        BEGIN_ENUM_LIST
            DEFAULT    = 0x00000020, "Default value of 32 registers."
            MAX        = 0xffffffff, "Sets the number of registers to the max allowed number of registers."
        END_ENUM_LIST
    Default: DEFAULT
END_KEY


BEGIN_KEY DXR_DUMP_INTERMEDIATE_DXIL
    DefinedWhen:        defined(DEBUG) || defined(DEVELOP)
