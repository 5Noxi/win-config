BEGIN_KEY WKS_FEATURE_INDICATOR
    DefinedWhen:        1
    BinaryID:           0x211019
    RemappedName:       D3D_211019
    Type:               dword
    Documentation:      "Toggle Workstation Feature Indicator on or off"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "Disable Everything"
            ON,  1, TRUE,  ENABLED                          = 0x00000001, "Enable Wks feature Indicator only"
            FEATURE_MASK                                    = 0x00000FF0, "Indicator for specific features"
            SWAPGROUP                                       = 0x00000010, "Show indicator for swapgroup"
            SWAPGROUP_JOINED                                = 0x00000020, "Show indicator for clients which joined the swapgroup"
            COMPOSITOR                                      = 0x00000040, "Show indicator for the compositor"
            DDISPLAY                                        = 0x00000080, "Show indicator for dedicated display"
            APP_MASK                                        = 0x0000F000, "Enable the indicator to app or DWM"
            APP                                             = 0x00001000, "Enable the indicator to APP"
            DWM                                             = 0x00002000, "Enable the indicator to DWM"
        END_ENUM_LIST
    Default: OFF
END_KEY

BEGIN_KEY ACE_POWERMODE_CPU_FREQUENCY
   DefinedWhen:         1
