            FORCE_4AFR                                                                    = 0x00000005, "force N-way AFR on N-way system"
            FORCE_3AFR                                                                    = 0x00000006, "force 2-AFR on 2-way system and 3-AFR on N-way"
            SLI_MODE_MASK                                                                 = 0x00000007, " --- not a value. This is a mask to select sli mode enum field"
            OVERRIDE_BIT                                                                  = 0x80000000, "makes the global profile override app's profile"
