    DefinedWhen:        1
    BinaryID:           0xabc123
    RemappedName:       D3D_abc123
    Type:               bool
    Documentation:      "read Windows registry for dvs-machine check"
    UserVisible
    UserVisibleName:    " "
    NvInternalSetting
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST 
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x00000001, "Enabled"
        END_ENUM_LIST
    Default: ON
