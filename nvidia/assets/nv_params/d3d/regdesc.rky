BEGIN_KEY BAR_INDICATOR
DefinedWhen:        1
    BinaryID:           0x452114
    RemappedName:       D3D_452114
    Type:               dword
    Documentation:      "Enables a plethora of bar drawing options to debug flip pattern issues"
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED                         = 0x00000000, "No indicator"
            DISPLAY_COUNT_MASK                              = 0x0000000F, "0-15 bars to be drawn at regular intervals, mostly to get one per display (though it can do more than one per display)."
            FRAME_COUNT_MASK                                = 0x000000F0, "Number of different offsets to draw the bars in, to distinguish different frames. Useful for SLI to distinguish frames drawn by different GPUs if set to (a multiple of) the number of GPUs."
            WIDTH_PERCENT_MASK                              = 0x00007F00, "Percentage of the screen size to be used as the bar width."
            SPEED_MASK                                      = 0x00FF0000, "Speed which the bar moves in the screen. Zero is no movement, each added unit is 10% of the bar width."
            DRAW_PORTRAIT                                   = 0x00008000, "Draw bar from left-to-right instead of top-to-bottom. Useful for portrait modes."
            SWITCH_COLORS                                   = 0x80000000, "make bars change colors when drawn by the same GPU (so the same color is used by all frames before it is updated)."
            MASK                                            = 0x80FFFFFF, "Mask of all valid bits"
            SINGLE_MOVING_BAR                               = 0X00100000, "Legacy mode of a single white bar moving left-right on the screen"
        END_ENUM_LIST
    Default: OFF
END_KEY

