    BinaryID:           0x00effba1
    RemappedName:       D3D_0562ABA1
    Type:               dword
    Documentation:      "To determine how many segments per storage unit holds. Size used is calculated by (#ofWarpsPerSM * #ofSMs * PS_WARP_PROFILER_SEGMENTS * 1024 * 16B) "
    Default:            0x1
END_KEY

BEGIN_KEY PS_WARP_PROFILER_FRAMES
