BEGIN_KEY SUPPRESS_ASSERTS_IN_AUTOMATION
    DefinedWhen:        defined(DEBUG)
    BinaryID:           0x32DCD5
    RemappedName:       D3D_35354321
    Type:               dword
    Documentation:      "Used for suppressing assert which indicates a problem in test/runtime which can't be fixed in the driver and needs to be suppressed to allow the test to run further in automation instead of crashing."
    Values: Bitfields
        BEGIN_ENUM_LIST
            SUPPRESS_ASSERT_RS1                = 0x00000001, "suppress assert on RS1 so that the test continues to run in automation without crashing"
            SUPPRESS_ASSERT_RS2                = 0x00000002, "suppress assert on RS2 so that the test continues to run in automation without crashing"
            SUPPRESS_ASSERT_ALL                = 0x00000004, "suppress assert on all so that the test continues to run in automation without crashing"
        END_ENUM_LIST
    Default:            0
END_KEY

BEGIN_KEY SUPPRESS_MSEDGE_ASSERTS_IN_AUTOMATION
    DefinedWhen:        defined(DEBUG)
    BinaryID:           0x32ecb5
    RemappedName:       D3D_200383472
    Type:               bool
    Documentation:      "Used for suppressing msedge asserts in automation."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default:            ON
END_KEY

BEGIN_KEY DVS_TESTNAME
    DefinedWhen:    1
    BinaryID:       0x202317
    RemappedName:   D3D_2023179
    Type:           string
    Documentation:  "DVS testname used for Assert Suppression"
END_KEY

BEGIN_KEY DISABLE_ASSERT_SUPPRESSION
    DefinedWhen:        1
    BinaryID:           0x202318
    RemappedName:       D3D_200386643
    Type:               bool
    UserVisible
    Documentation:      "Disable the assert suppression done by the driver in DVS system"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY TURING_CBV_BIND_MODE
    DefinedWhen:        1
    BinaryID:           0x35aed
    RemappedName:       D3D_CB1234
    Type:               dword
    Documentation:      "Way to choose CBV bind mechanism."
    Values: Bitfields
        BEGIN_ENUM_LIST
            CBV_BIND_MODE_DEFAULT                               = 0x00000000, "DX11 Compute - HybridBindless, DX12 - PureBindless"

            DX12_CBV_BIND_MODE_SHIFT                            = 0,          "" 
            DX12_CBV_BIND_MODE_MASK                             = 0x0000000F, "" 
            DX12_CBV_BIND_MODE_LEGACY                           = 0x00000001, ""
            DX12_CBV_BIND_MODE_PUREBINDLESS                     = 0x00000000, ""

            DX11_CMP_CBV_BIND_MODE_SHIFT                        = 4,          ""
            DX11_CMP_CBV_BIND_MODE_MASK                         = 0x000000F0, ""  
            DX11_CMP_CBV_BIND_MODE_LEGACY                       = 0x00000010, ""
            DX11_CMP_CBV_BIND_MODE_PUREBINDLESS                 = 0x00000020, ""
            DX11_CMP_CBV_BIND_MODE_HYBRIDBINDLESS               = 0x00000000, ""
        END_ENUM_LIST
    Default: CBV_BIND_MODE_DEFAULT
END_KEY

BEGIN_KEY TURING_ROOTCBV_MODE
    DefinedWhen:        1
    BinaryID:           0x35bef
    RemappedName:       D3D_CB2284
    Type:               dword
    Documentation:      "Way to choose graphics and compute RootCBV behaviour when DX12_CBV_BIND_MODE_PUREBINDLESS mode is selected for TURING_CBV_BIND_MODE regkey - Using LDG or LDCB.Default is to use LDG for both compute and graphics RootCBVs. "
    Values: Bitfields
        BEGIN_ENUM_LIST
            ROOTCBV_MODE_FORCE_LDG                              = 0x0,      "Use LDG for both Graphics and Compute RootCBVs"
            GRAPHICS_ROOTCBV_FORCE_LDCB                         = 0x1,      "Use LDCB for Graphhics RootCBVs"
            COMPUTE_ROOTCBV_FORCE_LDCB                          = 0x2,      "Use LDCB for Compute RootCBVs"  
            ROOTCBV_MODE_FORCE_LDCB                             = 0x3,      "Use LDCB for Compute RootCBVs"  
        END_ENUM_LIST
    Default: ROOTCBV_MODE_FORCE_LDCB
END_KEY

BEGIN_KEY TURING_TEX_SMP_VIA_ROOT_TABLE
    DefinedWhen:        1
    BinaryID:           0xab4d10
    RemappedName:       D3D_ab4d10
    Type:               bool
    UserVisible
    Documentation:      "Put first 32 tex/smp combos of VS and PS in root table. Only for testing Turing HW root table feature with dx11"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x0, "Disabled"
            ON,  1, TRUE,  ENABLED   = 0x1, "Enabled"
        END_ENUM_LIST
    Default:            ON
END_KEY

BEGIN_KEY TURING_DX12_SURFACE_BIND_MODE
    DefinedWhen:        1
    BinaryID:           0xab4d1a
    RemappedName:       D3D_ab4d1a
    Type:               dword
    Documentation:      "Decides binding mode for DX12 surfaces"
    Values: Bitfields
        BEGIN_ENUM_LIST
            PUREBINDLESS                              = 0x0,      "Use Purebindless mode for all surfaces"
            LEGACY                                    = 0x1,      "Use Legacy i.e. first 64 surfaces use Bound mode and later use PureBindless mode"
        END_ENUM_LIST
    Default:            PUREBINDLESS
END_KEY

BEGIN_KEY TURING_TEXTURE_BIND_MODE
    DefinedWhen:        1
    BinaryID:           0xab4d1b
    RemappedName:       D3D_ab4d1b
    Type:               dword
    Documentation:      "Decides binding mode for Textures - both DX11 and DX12"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DX11_LEGACY                               = 0x1,      "Use legacy texture binding (tex/smp combos) for DX11.  Falls back to bindless if tex/smp combo space is exhausted."
            DX12_LEGACY                               = 0x2,      "Use legacy texture binding (tex/smp combos) for DX12.  Falls back to bindless if tex/smp combo space is exhausted."
        END_ENUM_LIST
    Default:            DX11_LEGACY
END_KEY

BEGIN_KEY DX12_MESH_SHAREDMEM_EMU_MODE
    DefinedWhen:        1
    BinaryID:           0xEB1205
    RemappedName:       D3D_EB1205
    Type:               dword
    Documentation:      "Way to choose Shared memory emulation mode. This regkey just controls size of underlying allocation based on mode. For actually forcing the mode need to set matching OCG knob : MeshSmemEmulationMode"
    Values: Bitfields
        BEGIN_ENUM_LIST
            SINGLE_CTA_PER_SM = 0x0,      "Force single CTA/SM when shared memory emulation is used."
            MAX_CTAS_PER_SM   = 0x1,      "Allow maximum number of CTAs per SM when shared memory emulation is used."
        END_ENUM_LIST
    Default: SINGLE_CTA_PER_SM
END_KEY

BEGIN_KEY SET_3D_CHANNEL_INIT_METHODS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe118A5
    RemappedName:       D3D_DE34575A
    Type:               string
    Documentation:      "Pass 3D Channel initialization Methods. String should contain multiple key value pairs in hexadecimal notation, separated by a semi-colon. Please use format 'HexMethod1 HexValue1; HexMethod2 HexValue2;...'. Driver initialization will fail if incorrect syntax is used. Very little validation is performed here on the actual values, so anything incorrect may lead to TDR's/Failures. Available Kepler+ and only on Develop/Debug drivers"
    Default:            ""
END_KEY

BEGIN_KEY SET_COMPUTE_CHANNEL_INIT_METHODS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xe22894
    RemappedName:       D3D_DE456649
    Type:               string
    Documentation:      "Pass Compute Channel initialization Methods. String should contain multiple key value pairs in hexadecimal notation, separated by a semi-colon. Please use format 'HexMethod1 HexValue1; HexMethod2 HexValue2;...'. Driver initialization will fail if incorrect syntax is used. Very little validation is performed here on the actual values, so anything incorrect may lead to TDR's/Failures. Available Kepler+ and only on Develop/Debug drivers"
    Default:            ""
END_KEY

BEGIN_KEY PRI_SETTINGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x210204
    RemappedName:       D3D_210204
    Type:               string
    Documentation:      "Pass PRI registers to set. String should contain multiple key-value-mask triplets in hexadecimal notation, separated by a semi-colon. Please use format 'HexPRIOffset1 HexValue1 HexMask1; HexPRIOffset1 HexValue2 HexMask2;...'. RM will assert if illegal offsets are used or if the PRIs are not in the allowList.  Very little validation is performed here on the actual values, so anything incorrect may lead to TDR's/Failures. Available Kepler+ and only on Develop/Debug drivers"
    Default:            ""
END_KEY

