            DEPTH_STENCIL                                         = 0x00000020, ""
            RENDER_TARGET                                         = 0x00000040, ""
            COMPUTE_SHADING                                       = 0x00000080, ""
            RAYTRACING                                            = 0x00000100, ""
            COPY                                                  = 0x00000200, ""
            RESOLVE                                               = 0x00000400, ""
            EXECUTE_INDIRECT_OR_PREDICATION                       = 0x00000800, ""
            ALL_SHADING                                           = 0x00001000, ""
