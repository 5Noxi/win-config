BEGIN_KEY TSF_SETTING
    DefinedWhen:        1
    BinaryID:           0x322156
    RemappedName:       D3D_322156
    Type:               dword
    Documentation:      "TSF additional settings"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            DEFAULT_FILTER      = 0x00000001, "simple 4 frames based algorithm only applied on static objects"
            SPATIAL_FILTER      = 0x00000002, "Additional to default filter, spatial filter on moving objects"
            DEINTERLACE_FILTER  = 0x00000003, "Special de-interlacing filter espicially designed for 1x->2x mode"
            FILTER_FROM_FILE    = 0x00000004, "Load custom filter from file (available only on debug/develop drivers). File named tsfshader.bin should be placed in the path specificed by MAXWELL_B_SAMPLE_INTERLEAVE_PATH."
        END_ENUM_LIST
        Default: SPATIAL_FILTER
END_KEY

