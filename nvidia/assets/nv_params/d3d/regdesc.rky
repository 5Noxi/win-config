            DEFAULT                     = 0x00000000, "Automatically select the mode"
            FORCE_P2P_WRITES            = 0x00000001, "Use P2P Writes for present copies"
            FORCE_P2P_READS             = 0x00000002, "Use P2P Reads for present copies"
            INVERT_PLATFORM_CHOICE      = 0x00000003, "Inverte the choice preferred by the platform - this setting makes Turing use Writes and Volta- use Reads"
        END_ENUM_LIST
