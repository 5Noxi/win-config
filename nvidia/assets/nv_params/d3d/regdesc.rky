            DISABLE_DEPTH_ZBC                                       = 0x00000020, "completely disable ZBC for depth targets [via PRI: NV_PGRAPH_PRI_DS_DEBUG_ZBC_EN]"
            DISABLE_STENCIL_ZBC                                     = 0x00000040, "Pascal_B, completely disable ZBC for stencil targets [via PRI: NV_PGRAPH_PRI_GPCS_SWDX_DSS_ROP_DEBUG2_STENCIL_ZBC_EN]"
