BEGIN_KEY PS_COPARGS_DUMP_VER
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0xbe58bb
    RemappedName:       D3D_be58bb
    Type:               dword
    Documentation:      "COPArgs dump version. Currently parseasm doesn't parse all of the parameters the driver sends to COP. We are fixing this, but in the meantime, this key controls the format of what the driver outputs in shader dumps for COPARgs."
    Values: Samples
        BEGIN_ENUM_LIST
        VER_0, 0            = 0, "Old version of COPArgs with ATTRIBINDEXABLEBLOCKID, RESULTINDEXABLEBLOCKID"
        VER_1, 1            = 1, "This is the current version parsed by parseasm."                                                      
        VER_2, 2            = 2, "This version has additional sampler and texture properties, and isn't currently handled by parseasm." 
        VER_3, 3            = 3, ""
        VER_COMPAT,         = 0xffffffff, "This option is temporary - this settings specifies the use the old driver based code for dumping COPArgs, rather than common code."
        VER_UNKNOWN,        = 0xffffffff, "This value is for use by the parser as it tries to figure out what version of the dump it is dealing with."
        END_ENUM_LIST
      Default:          VER_2
END_KEY

