BEGIN_KEY SCG_D3D12_CONTROL_FLAGS
    DefinedWhen:     1
    BinaryID:        0x1c19fd
    RemappedName:    D3D_0x1c19fd
    Type:            dword
    Documentation:   "Controls for various SCG functionality"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_CL_HAZARD_DETECT                         = 0x0001, "Disables cross command list hazard resolution (can cause RC errors)"
            FORCE_GR_SEMAPHORE_WFI                           = 0x0010, "Forces semaphore release/acquire based WFIs for graphics queues"
            FORCE_CS_SEMAPHORE_WFI                           = 0x0020, "Forces semaphore release/acquire based WFIs for compute queues"
            FORCE_GR_HOST_WFI                                = 0x0040, "Forces host release/acquire based WFIs for graphics queues"
            FORCE_CS_HOST_WFI                                = 0x0080, "Forces host release/acquire based WFIs for compute queues"
            DISABLE_STATIC_CONFIG                            = 0x0100, "Disables all static configurations of SCG."
            DISABLE_CL_INITIAL_DESCRIPTOR_HEAP_SET_ON_PBDMA1 = 0x0200, "Disables setting initial descriptor heap on PBDMA1"
        END_ENUM_LIST
    Default:        0
END_KEY

BEGIN_KEY SCG_D3D12_ENABLE_DYNAMIC_SMSCG_HEURISTIC
