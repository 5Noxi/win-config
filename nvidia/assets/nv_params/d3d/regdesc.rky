BEGIN_KEY PS_ECL_MERGE_FLAGS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x6ee191
    RemappedName:       D3D_01694446
    Type:               dword
    Documentation:      ""
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            DISABLE_MERGING     = 0x00000001, "Don't perform any ECL merging, just allow dependency tracking"
            LOG_MULTIPLE_FRAMES = 0x00000002, "Pressing the hotkey is a start/stop switch for logging frames, instead of just logging one frame"
            BASIC_LOGGING       = 0x00000004, "Log the ECL merging information into a file called NVECLDEPS.txt"
            EXTENDED_LOGGING    = 0x00000008, "Log everything submitted"
            ETW_LOGGING         = 0x00000010, "Log all file events to ETW as well"
            FRAME_SUMMARIES     = 0x00000020, "For each frame, record the 0"
        END_ENUM_LIST
    Default: OFF
END_KEY

