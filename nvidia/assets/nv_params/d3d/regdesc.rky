BEGIN_KEY CONVERT_TO_LDG_FLAGS
    DefinedWhen:     1
    BinaryID:        0xcbe000
    RemappedName:    D3D_0xcbe000
    Type:            dword
    Documentation:   "This regkey specifies flags used by convert-to-LDG"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE                = 0x00, ""
            NORANGECHECK        = 0x01, "Disable range checking for converted loads"
            DISABLESRV          = 0x02, "Disable convert-to-ldg for SRVs"
            DISABLEUAV          = 0x04, "Disable convert-to-ldg for UAVs"
            FORCERANGECHECK     = 0x08, "Force range-check on, even for RootSig V1.1"
            CROSSRESDISABLE     = 0x10, "One disallowed resource disables other resources from CONVERT_TO_LDG. DXIL only."
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY CONVERT_TO_LDG_TYPES
    DefinedWhen:     1
    BinaryID:        0xcbe001
    RemappedName:    D3D_0xcbe001
    Type:            dword
    Documentation:   "This regkey specifies the types of emulation to be done"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE            = 0x0, "No Emulation"
            UNUSED1         = 0x1, "Unused"
            UNUSED2         = 0x2, "Unused"
            STRUCTURED_LOAD = 0x4, "Emulate ld_structured with LDG"
            RAW_LOAD        = 0x8, "Emulate ld_raw with LDG"
            ALL             = 0xc, "All handled types are emulated"
        END_ENUM_LIST
    Default: NONE
END_KEY
 
BEGIN_KEY CONVERT_TO_LDG_STAGES
    DefinedWhen:     1
    BinaryID:        0xcbe002
    RemappedName:    D3D_0xcbe002
    Type:            dword
    Documentation:   "This regkey specifies the shader stages to which emulation applies. Flags are BIT(DsiShaderType)"
    Values:          Bitfields
        BEGIN_ENUM_LIST
            NONE              = 0x00, "No Emulation"
            VERTEX_SHADER     = 0x01, "Emulate for vertex shaders"
            HULL_SHADER       = 0x02, "Emulate for hull shaders"
            DOMAIN_SHADER     = 0x04, "Emulate for domain shaders"
            GEOMETRY_SHADER   = 0x08, "Emulate for geometry shaders"
            PIXEL_SHADER      = 0x10, "Emulate for pixel shaders"
            COMPUTE_SHADER    = 0x20, "Emulate for compute shaders"
            ALL               = 0x3f, "Emulate for all shader stages"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY CONVERT_TO_LDG_HASH
