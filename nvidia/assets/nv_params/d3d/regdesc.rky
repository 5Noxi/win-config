BEGIN_KEY PS_D3D_DEBUG_HOOKS
    DefinedWhen:        1
    BinaryID:           0x6ee18f
    RemappedName:       D3D_6ee18f
    Type:               dword
    Documentation:      "Enable hooking of d3d functions to enable app regime data in cyclestats."
    Values: Bitfields:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF                      = 0x00000000,                                                                    "No hooks are made"
            OS_EXIT_HOOKS_ON         = 0x00000001,                                                                    "Enable for TerminateProcess, ExitProcess, CrtExit"
            PERF_MARKERS_ON_FOR_DX9  = 0x00000002,                                                                    "Enable for D3DPERF_BeginEvent"
            PERF_MARKERS_ON_FOR_DX11 = 0x00000004,                                                                    "Enable for D3DPerformance_BeginEvent/ID3DUserDefinedAnnotation::BeginEvent"
            PERF_MARKERS_ON_FOR_DX12 = 0x00000008,                                                                    "Enable for ID3D12GraphicsCommandList::BeginEvent"
            PERF_MARKERS_ON          = PERF_MARKERS_ON_FOR_DX9 | PERF_MARKERS_ON_FOR_DX11 | PERF_MARKERS_ON_FOR_DX12, "Enable for all listed perf markers"
            CLASS_NAME_TRACKING_ON   = 0x00000010,                                                                    "Enable to track names for ID3D11DeviceChild classes"
            TIMESTAMP_CHECK_ON       = 0x00000020,                                                                    "Enable to spew timestamp query information built from the D3D12 API"
            ECL_MERGING              = 0x00000040,                                                                    "Enable hooks necessary for merging ECL calls"
            MISC_DEBUG_ON            = CLASS_NAME_TRACKING_ON | TIMESTAMP_CHECK_ON,                                   "Enable non-perf and non-OS hooks"
            ON                       = OS_EXIT_HOOKS_ON | PERF_MARKERS_ON | MISC_DEBUG_ON | ECL_MERGING,              "Enable for everything"
        END_ENUM_LIST
    Default: OFF
END_KEY

BEGIN_KEY PS_ECL_MERGE_HOTKEY
