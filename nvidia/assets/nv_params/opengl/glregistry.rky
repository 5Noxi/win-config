    DefinedWhen:        1
    BinaryID:           0xbc1a2f
    RemappedName:       OGL_0xbc1a2f
    Type:               dword
    Documentation:      "Controls if CE copies are fully pipelined between barriers (when allowed by WNF bugs)"
    Values:             Samples
        BEGIN_ENUM_LIST
            DISABLE                                 = 0x00000000, "disable"
            ENABLE                                  = 0x00000001, "enable"
        END_ENUM_LIST
    Default: ENABLE
END_KEY

