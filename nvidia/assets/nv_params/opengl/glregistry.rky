    BinaryID:           0xbd29fc
    RemappedName:       OGL_bd29fc
    Type:   dword
    Documentation:  "Control clamping behavior for floating-point blend operations on Pascal and above (see bug 1704952)."
    Values: Samples
        BEGIN_ENUM_LIST
            TO_INFINITY    = 0x00000000, "Clamp to +/- infinity. This is the default for OpenGL."
            TO_MAXVAL      = 0x00000001, "Clamp to +/- maximum value. This is the default for DX."
        END_ENUM_LIST
    Default:    TO_MAXVAL
END_KEY

BEGIN_KEY VK_COPY_CONTROL
    DefinedWhen:    1
    BinaryID:       0xafa115
    RemappedName:   OGL_afa115
    Type:           dword
    Documentation:  "Controls if vkCmdCopy* functions use TWOD, PSHADER, or COMPUTE in this order where applicable"
    Values: Bitfields
        BEGIN_ENUM_LIST
            PSHADER_OFF  = 0x00000000, "Don't convert suitable CmdCopyImage into CmdBlitImage"
            PSHADER_ON   = 0x00000001, "Allow converting suitable CmdCopyImage into CmdBlitImage to use pixel shader"
            TWOD_OFF     = 0x00000000, "Disallow TWOD"
            TWOD_ON      = 0x00000002, "Allow TWOD"
            TWOD_AUTO    = 0x00000004, "Only allow TWOD based on HW bug and perf"
        END_ENUM_LIST
    Default:    TWOD_AUTO | PSHADER_ON
END_KEY

BEGIN_KEY VK_SEMAPHORE_HAL
    DefinedWhen:    1
    BinaryID:           0x5effa1
    RemappedName:       OGL_5effa1
    Type:   dword
    Documentation:  "Select which semaphore HAL is used for timeline semaphore operations on non-WDDM platforms.  If an unsupported HAL is requested, the next-best supported HAL is chosen.  To facilitate this, better HALs must have larger values below."
    Values: Samples
        BEGIN_ENUM_LIST
            FERMI          = 0x00000000, "Use the baseline 32-bit host semaphore HAL.  Supported by all GPUs."
            VOLTA          = 0x00000001, "Use the 64-bit host semaphore HAL.  Supported on Volta and above GPUs."
            HW_DEFAULT     = 0xFFFFFFFF, "Choose the best HAL supported by the hardware."
        END_ENUM_LIST
    Default:    HW_DEFAULT
END_KEY

