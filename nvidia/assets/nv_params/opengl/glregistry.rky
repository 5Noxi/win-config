BEGIN_KEY OGL_SHADER_LOCAL_MEMORY_PER_WARP_LIMIT
    DefinedWhen:        1
    BinaryID:           0x6a4390
    RemappedName:       OGL_6a4390
    Type:               dword
    Documentation:      "Specifies a maximum shader local memory allocation size, in bytes per warp.  The driver may throttle (running shaders on fewer warps for graphics or fewer TPCs for compute) when using shaders requiring more local memory.  The driver may also allocate more local memory than indicated by this cap if the size derived from the cap is insufficient to run the shader.  A value of zero indicates no cap on the local memory allocation size and thus no throttling."
    Default:            0x2000
END_KEY

