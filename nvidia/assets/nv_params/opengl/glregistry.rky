            DISABLE    = 0, "Disable use of Pixels From Memory."
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

BEGIN_KEY OGL_DOWNSAMPLE_RESERVED_TEX_HEADERS
    DefinedWhen:        1
    BinaryID:           0x366b82
    RemappedName:       OGL_93A89B12
    Type:               dword
    Documentation:      "Set the number of reserved tex headers for downsample textures, this is needed for non-flushing downsample for tile-caching on Maxwell. A value of 0 disables the functionality"
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE    = 0, "Disable the use of reserved tex header slots for downsample images."
            MAXIMUM    = 32, "Maximum reserved textures supported."
        END_ENUM_LIST
    Default:    8
END_KEY

BEGIN_KEY OGL_OPTIMUS_TOGGLE_DCE_ON_MODESWITCH
    DefinedWhen:        1
    BinaryID:           0x9c816f
    RemappedName:       OGL_09c816f0
    Type:               dword
    Documentation:      "Toggle DCE when on an Optimus capable system and DCE is enabled to WAR bug 858751."
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLED  = 1, "Toggle DCE on modeswitch"
            DISABLED = 0, "Skip toggling DCE on modeswitch."
        END_ENUM_LIST
    Default:            ENABLED
END_KEY

BEGIN_KEY OGL_APP_NO_TEX_RGBA4_TO_RGBA8_MAPPING
    DefinedWhen:        1
    BinaryID:           0xc42a03
    RemappedName:       OGL_6253FA2E
    Type:               dword
    Documentation:      "Avoid the remapping from the internal texture format GL_RGBA4 to GL_RGBA8 at the cost of not being able to use that texture as a render target but with the benefit to not having to convert it."
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLE      = 1, "Don't map the GL_RGBA4 texture format to GL_RGBA8 internally."
            DISABLE     = 0, "Map the GL_RGBA4 texture format to GL_RGBA8 internally."
        END_ENUM_LIST
    Default:            DISABLE
END_KEY

