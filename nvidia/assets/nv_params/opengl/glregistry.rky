BEGIN_KEY OGL_WGL_MESSAGE_BOX_ON_GPU_DISCONNECT
    DefinedWhen:    1
    BinaryID:           0x4a5341
    RemappedName:   OGL_4a5341
    Type:   dword
    Documentation:  ""
    Values: Samples
        BEGIN_ENUM_LIST
            HIDE_EXIT   = 0x00000000, "Hide the dialog and exit silently"
            SHOW        = 0x00000001, "Show the dialog and exit if requested"
            HIDE_NOEXIT = 0x00000002, "Hide the dialog and do not exit"
        END_ENUM_LIST
    // Applications behave erratically after GPU hot-unplug.  Exit them to avoid ugly crashes and
    // error dialogs.  If work is lost, this is the users fault for not terminating applications
    // properly (we have a UI for safe removal that warns if applications are using the GPU).
    // Note that applications that use ARB_robustness will neither be terminated nor show a dialog
    // since they can detect device lost.
    Default:    HIDE_EXIT
END_KEY

