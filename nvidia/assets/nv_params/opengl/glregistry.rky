    Documentation:  ""
    Values:         Samples
        BEGIN_ENUM_LIST
            FORCE_DISABLE                       = 0x00000000, "Disable SMSCG for ray tracing"
            ALLOW_ENABLE                        = 0x00000001, "Do not disable SMSCG for ray tracing"
