BEGIN_KEY VK_PIPELINE_CACHE_COMPRESSION_METHOD
    DefinedWhen:        1
    BinaryID:           0x10a9a3
    RemappedName:       OGL_0x10a9a3
    Type:               dword
    Documentation:      "Selects between ZSTD & LZMA compression methods"
    Values:             Samples
        BEGIN_ENUM_LIST
            AUTO        = 0x00000000, "Driver determines the appropriate compressor"
            LZMA        = 0x00000001, "Use LZMA compressor"
            ZSTD        = 0x00000002, "Use ZSTD compressor"
            SHARED      = 0x00000003, "Use the same compressor as the driver internal cache"
        END_ENUM_LIST
    Default: AUTO
END_KEY

BEGIN_KEY VK_RECONVERGENCE
    DefinedWhen:        1
    BinaryID:           0x9e7d35
    RemappedName:       OGL_0x9e7d35
    Type:               dword
    Documentation:      "Enables maximal reconvergence in GLV on Volta+, using vote and warpsync"
    Values:             Samples
        BEGIN_ENUM_LIST
            DISABLED                             = 0x00000000, "disabled"
            ENABLED                              = 0x00000001, "enabled"
        END_ENUM_LIST
    Default: ENABLED
END_KEY

BEGIN_KEY VK_DISABLE_RECONVERGENCE_HASH_LIST
    DefinedWhen:        1
    BinaryID:           0x9e7d36
    RemappedName:       OGL_0x9e7d36
    Type:               string
    Documentation:      "String for passing list of shader appHashes to disable Reconvergence for. ';' delimited eg: '0xbadcf00ddeadbeef;' or an upper/lower bound eg: '<=0xbadcf00ddeadbeef'"
    Default: ""
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION
    DefinedWhen:        1
    BinaryID:           0xF07E33
    RemappedName:       OGL_F07E33
    Type:               dword
    Documentation:      "Controls vulkan driver PGO strategy."
    Values:             Samples
        BEGIN_ENUM_LIST
            DISABLE,DISABLED,OFF      = 0x00000000, "Disabled"
            STATIC                    = 0x00000001, "Look for and use profile data gathered offline"
            PROFILE                   = 0x00000004, "Fully instrument shaders and gather profiling data"
        END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION_HOTKEY
    DefinedWhen:        1
    BinaryID:           0xF07E34
    RemappedName:       OGL_0xF07E34
    Type:               dword
    Documentation:      "Hotkey to trigger profiling dump. Default is VK_F6"
    Default: 0x75
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION_START_FRAME
    DefinedWhen:        1
    BinaryID:           0xF07E35
    RemappedName:       OGL_0xF07E35
    Type:               dword
    Documentation:      "First frame to dump shader profiling data on"
    Default: 0x64
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION_DUMP_PERIOD
    DefinedWhen:        1
    BinaryID:           0xF07E36
    RemappedName:       OGL_0xF07E36
    Type:               dword
    Documentation:      "Controls how often to dump profiling data (in frames), starting from the _START_FRAME value. Setting 0 means dump once."
    Default: 0x64
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION_PATH
    DefinedWhen:        1
    BinaryID:           0xF07E37
    RemappedName:       OGL_F07E37
    Type:               string
    Documentation:      "Controls location of the profile database."
    Default:            ""
END_KEY

BEGIN_KEY VK_PROFILE_GUIDED_OPTIMIZATION_SHADER_FRACTION
    DefinedWhen:        1
    BinaryID:           0xF07E38
    RemappedName:       OGL_F07E38
    Type:               float
    Documentation:      "Fraction of shaders that will be profiled for PGO. The susbet of shaders profiled is randomized across runs."
    Default: 1.f
END_KEY

BEGIN_KEY VK_CONVERT_DOUBLE_INDIRECT_TO_ULDC
