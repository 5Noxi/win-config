BEGIN_KEY OGL_FAST_MATH_FLAGS
    DefinedWhen:        1
    BinaryID:           0xbc1a2c
    RemappedName:       OGL_0xbc1a2c
    Type:               dword
    Documentation:      "Controls OCG floating point optimization behavior"
    Values:             Bitfields
        BEGIN_ENUM_LIST
            DISABLE_REORDER_FLOAT_DISTRIBUTE        = 0x00000001, "disable canReorderFloatDistribute"
            DISABLE_REORDER_CSE                     = 0x00000002, "disable canReorderCSE"
            DISABLE_DISTRIBUTE_AND_REASSOCIATE_MUL  = 0x00000004, "disable canDistributeAndReassociateMul"
            ENABLE_ALL                              = 0x00000000, "all optimizations enabled"
