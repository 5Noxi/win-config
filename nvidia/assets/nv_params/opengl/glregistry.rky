            OPENCL = 0x00000002, "Enable OpenCL <-> OpenGL interop"
            NVENC  = 0x00000004, "Enable NVENC  <-> OpenGL interop"
            ALL    = CUDA | OPENCL | NVENC, "Enable all OpenGL interop"
