BEGIN_KEY OGL_TRACE_MASK
    DefinedWhen:       1
    BinaryID:           0x748eA2
    RemappedName:       OGL_748eA2
    Type:               qword
    Documentation:      "Mark of which code to TRACE"
    Values: bitfields
        BEGIN_ENUM_LIST
            NONE         = 0x0000000000000000, "Nothing selected"
            CLEAR        = 0x0000000000000001, ""
            BEGIN        = 0x0000000000000002, ""
            VERTEX       = 0x0000000000000004, ""
            XFORM        = 0x0000000000000008, ""

            TEXTURE      = 0x0000000000000010, ""
            STATE        = 0x0000000000000020, ""
            RASTER       = 0x0000000000000040, ""
            LIGHT        = 0x0000000000000080, ""

            DLIST        = 0x0000000000000100, ""
            VTXARRAY     = 0x0000000000000200, ""
            ICD_CMDS     = 0x0000000000000400, ""
            EVAL         = 0x0000000000000800, ""

            PIXEL        = 0x0000000000001000, ""
            ERRORS       = 0x0000000000002000, ""
            PUSHBUFFER   = 0x0000000000004000, ""
            WGL          = 0x0000000000008000, ""

            DRAWABLE     = 0x0000000000010000, ""
            USER_1       = 0x0000000000020000, "Reserved for hacking. Don't check\n\t\tin anything that uses TR_USER* values."
            GLS          = 0x0000000000040000, "GLS"
            MEMALLOC     = 0x0000000000080000, "AGP memory allocation"

            THREAD       = 0x0000000000100000, "Multi-thread driver info"
            LIST_EXEC    = 0x0000000000200000, "DL execution info"
            PROGRAM      = 0x0000000000400000, "common for VP and FP, see COP for\n\t\tlevels to dump nvInst list and ucode bits"
            MALLOC       = 0x0000000000800000, "non-AGP memory alloc/free/realloc"

            CLAW         = 0x0000000001000000, "CLAW messages"
            FSAA         = 0x0000000002000000, "FSAA tracking"
            GET          = 0x0000000004000000, "any GET routine"
            VP_CREATE    = 0x0000000008000000, "Vertex Program create/destroy\n\t\tlevel 25 print key when generating VP\n\t\tlevel 35-40 internal VP generation\n\t\tlevel 43 trace VP generation\n\t\tlevel 44 trace when VP sent to GPU\n\t\tlevel 45 generate each time (instead of sometimes getting from cache)\n\t\tlevel 55 loading GPU cache, switching user <--> fixed VP"

            VALIDATE     = 0x0000000010000000, "for tracing validation"
            TEXMGR       = 0x0000000020000000, "internal texture management\n\t\tLevel 20: System issues (mode switch)\n\t\tLevel 25: Init/Destroy/Exception\n\t\tLevel 30: Alloc/Free\n\t\tLevel 35: Use/Orphan/Promote/Tag\n\t\tLevel 40: Eviction/Discard\n\t\tLevel 45: Wait\n\t\tLevel 50: Frame counter (in nvContext.c)\n\t\tLevel 60: Texture download (cook texture)\n\t\tLevel 80: LRU list printing"
            MUTEX        = 0x0000000040000000, "mutex grab/releasing\n\t\tLevel 70: Mutex acquire/release"
            CONFIG       = 0x0000000080000000, "various config info, like Reg. values"

            VP_INTERNAL  = 0x0000000100000000, "internal VP generation will push/clear/pop bit\n\t\tVP_CREATE unless this mask bit is set"
            STATS        = 0x0000000200000000, ""
            PM_STATS     = 0x0000000400000000, "nvpmapi and assoc'd stats tracing"
            FP_CREATE    = 0x0000000800000000, ""

            COP          = 0x0000001000000000, "to get trace for filing OCG bugs, set this bit\n\t\tand level == 50.  Cut trace\n\t\tfrom ***** Begin COP compile\n\t\tto ***** End COP compile\n\t\tlevel 50 dump source and inst list\n\t\tlevel 60 dump inst list to be converted to ucode\n\t\tlevel 70 dump ucode bits"
            FBO          = 0x0000002000000000, ""
            MULTIGPU     = 0x0000004000000000, "multiGpu related debug output"
            PROGRAM_EXEC = 0x0000008000000000, "SW GPU program execution"

            LONGHORN     = 0x0000010000000000, "Longhorn stuff"
            GLSL         = 0x0000020000000000, "GLSL shader/program compilation"
            UTIL         = 0x0000040000000000, "for glUtil tracing"
            WWMP         = 0x0000080000000000, "For WWMP"

            PATH         = 0x0000100000000000, "Path Rendering"
            WSPERF       = 0x0000200000000000, "WSPERF paths"
            SHADERS      = 0x0000400000000000, "cyclestats-style shader dumps"
            MEMUSAGE     = 0x0000800000000000, "GL memory usage stats"

            DISKCACHE    = 0x0001000000000000, "Shader disk cache stats"
            CYCLESTATS   = 0x0002000000000000, "CycleStats internals"
            NVN          = 0x0004000000000000, "NVN API usage"
            VK_ERROR     = 0x0008000000000000, "Report any VK API usage errors we detect"
            RAYTRACING   = 0x0010000000000000, "Raytracing"
            VK_SYNC      = 0x0020000000000000, "Vulkan synchronization"

            SPARSE       = 0x0040000000000000, "Sparse resources"

            PERFSTRAT    = 0x0080000000000000, "Performance strategies"

            FENCE        = 0x0100000000000000, "GL synchronization"
            INTEROP      = 0x0200000000000000, "Interop"

            ALL          = 0x03ffffffffffffff, "All trace bits"
        END_ENUM_LIST
    Default:    NONE
END_KEY

BEGIN_KEY OGL_TRACE_FILE
    DefinedWhen:        1
    BinaryID:           0xBD4287
    RemappedName:       OGL_BD4287
    Type:               string
    Documentation:      "Which file to write nvtrace output to"
    Values: Samples
        BEGIN_ENUM_LIST
            BASIC = "nvtrace.txt", "Default nvtrace output filename"
        END_ENUM_LIST
    Default:    BASIC
END_KEY

BEGIN_KEY OGL_TRACE_LEVEL
    DefinedWhen:        1
    BinaryID:           0x2C455C
    RemappedName:       OGL_2C455C
    Type:               dword
    Documentation:      "Which level of tracing is desired"
    Values: Samples
        BEGIN_ENUM_LIST
            NONE   = 0, "Default level of tracing is disabled"
        END_ENUM_LIST
    Default:    NONE
END_KEY

BEGIN_KEY OGL_TRACE_OPTIONS
    DefinedWhen:        1
    BinaryID:           0x30ae9c
    RemappedName:       OGL_30ae9c
    Type:               dword
    Documentation:      "Which level of tracing is desired"
    Values: bitfields
        BEGIN_ENUM_LIST
            NONE                = 0x00000000, "No options selected"
            LOG_TO_CONSOLE      = 0x00000001, "trace output to a console window"
            LOG_TO_FILE         = 0x00000002, "trace output to a file"
            LOG_TO_DEBUGGER     = 0x00000004, "trace output to debugger window"
            LOG_TO_CALLBACK     = 0x00000008, "trace output to a user-specified callback"
            LOG_TO_STDOUT       = 0x00000010, "trace output to stdout"
            LOG_TO_BUFFER       = 0x00000020, "trace output to circular buffer"
            LOG_TO_ANY          = LOG_TO_CONSOLE | LOG_TO_STDOUT | LOG_TO_FILE | LOG_TO_DEBUGGER | LOG_TO_CALLBACK | LOG_TO_BUFFER, ""

            PER_FRAME_LOGFILE   = 0x00000200, "w/LOG_TO_FILE, new name each frame"
            PRINT_FRAME_COUNT   = 0x00001000, "prepend each line with frame count"

            PRINT_THREAD_ID     = 0x00002000, "prepend each line with thread ID"
            PRINT_THREAD_NUM    = 0x00004000, "... with thread number"
            PRINT_INDENT        = 0x00008000, "indent per stack level"
            PRINT_FUNCTION      = 0x00040000, "prepend each line with the function name (class::function for C++)"
            PRINT_THIS          = 0x00080000, "Add the this ptr for C++ (i.e. class(ptr)::function)"
            PRINT_PREFIX_PAD    = 0x00100000, "pad the prefix out to NV_TRACE_PREFIX_PAD characters"
            PRINT_TIME          = 0x00400000, "prepend each line with current time"
            FLUSHFILE_PER_WRITE = 0x40000000, "flush log file after each write"
            DISABLE_ASSERT_BRK  = 0x80000000, "don't break into the debugger on failed assertions"

            DEFAULT             = LOG_TO_DEBUGGER | LOG_TO_CONSOLE, "Default options"
       END_ENUM_LIST
   Default: DEFAULT
END_KEY

BEGIN_KEY OGL_FB_REGION_ENABLE
    DefinedWhen:        1
    BinaryID:           0x334277
    RemappedName:       OGL_419A265
    Type:   dword
    Documentation:  "Select the enabled FB regions on boards with multiple regions."
    Values: Samples
        BEGIN_ENUM_LIST
            ALL_REGIONS  = 0xffffffff, "Use all FB regions"
            REGION_0     = 0x00000000, "Use FB region 0"
            REGION_1     = 0x00000001, "Use FB region 1"
        END_ENUM_LIST
    Default:    ALL_REGIONS
END_KEY

BEGIN_KEY OGL_APP_VBUM_VIRTUAL_ADDRESS
    DefinedWhen:    1
    BinaryID:       0x07b25e
    RemappedName:   OGL_0007B25E
    Type:   dword
    Documentation:  "XP only, virtual addresses are created for any VBUM addresses passed back to the user application. Disabled for performance"
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLED   = 1, "Virtual Address created for VBUM card references, safer for mode switching"
            DISABLED  = 0, "VRAM address passed directly back to the application, may not survive mode switch"
        END_ENUM_LIST
    Default:    ENABLED
END_KEY

BEGIN_KEY OGL_OCGCONTROL_DIRECT_NVIR
    DefinedWhen:    1
    BinaryID:       0x8f3f2d
    RemappedName:   OGL_F33BC370
    Type:   dword
    Documentation:  "Controls OCG support for processing nvInst shaders.  Legacy support converts nvInst to a DAG; newer code converts it directly to NVIR (instruction list) form."
    Values: Samples
        BEGIN_ENUM_LIST
            DRIVER_DEFAULT   = 0, "Use driver default behavior."
            FORCE_ENABLE = 1, "Enable nvInst->NVIR conversion, regardless of defaults"
            FORCE_DISABLE = 2, "Disable nvInst->NVIR conversion, regardless of defaults"
        END_ENUM_LIST
    Default:    DRIVER_DEFAULT
END_KEY

BEGIN_KEY OGL_SHADER_DISK_CACHE
    DefinedWhen:        1
    BinaryID:           0x8f3f2e
    RemappedName:       OGL_43787d31
    Type:               dword
    Documentation:      "Enable caching shader microcode to disk"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE     = 0x0, "Disable caching shader microcode to disk"
            ENABLE      = 0x1, "Enable caching shader microcode to disk"
            DEBUG_CACHE = 0x2, "Compare cached shader microcode against compiler"
            REBUILD     = 0x4, "Rebuild shader cache per run"
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

BEGIN_KEY OGL_SHADER_DISK_CACHE_READ_ONLY
    DefinedWhen:        1
    BinaryID:           0xaa07bb
    RemappedName:       OGL_1854d03B
    Type:               dword
    Documentation:      "Access cached shader microcode read-only"
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE     = 0x0, "Access cached shader microcode read-write"
            ENABLE      = 0x1, "Access cached shader microcode read-only"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SHADER_DISK_CACHE_LOCATION
    DefinedWhen:        1
    BinaryID:           0x8f3f2f
    RemappedName:       OGL_D2983C32
    Type:               string
    Documentation:      "Override location of the shader disk cache. This location must already exist, and should not include \"/GLCache/\" at the end"
END_KEY

BEGIN_KEY OGL_SHADER_DISK_CACHE_SIZE
    DefinedWhen:        1
    BinaryID:           0x8f3f30
    RemappedName:       OGL_SHADER_DISK_CACHE_SIZE
    Type:               dword
    Documentation:      "Set the size of the shader disk cache"
    Values: Samples
        BEGIN_ENUM_LIST
            DEFAULT_ANDROID = (2*1024*1024),   "2MB by default for Android"
            DEFAULT_LEGACY  = (128*1024*1024),   "128MB by default for legacy caches (unix only)"
        END_ENUM_LIST
    Default:            (1024*1024*1024)
END_KEY

BEGIN_KEY OGL_VULKAN_SHADER_CACHE_TYPE
    DefinedWhen:        1
    BinaryID:           0x8f3f31
    RemappedName:       OGL_43787d32
    Type:               dword
    Documentation:      "Set the Vulkan shader cache type"
    Values: Samples
        BEGIN_ENUM_LIST
            NONE        = 0x0, "Disable the shader cache for Vulkan"
            DISK        = 0x1, "Save the Vulkan shader cache to disk"
            MEM         = 0x2, "Save the Vulkan shader cache to memory"
        END_ENUM_LIST
    Default:            DISK
END_KEY

BEGIN_KEY OGL_VULKAN_GFN_SHADER_CACHE_CONTROL
    DefinedWhen:        1
    BinaryID:           0xa011d7
    RemappedName:       OGL_a011d7
    Type:               dword
    Documentation:      "Controls enablement of the GFN shader cache DLL path. You must also set PS_SHADERDISKCACHE_DLL_PATH to enable the path fully."
    Values: Samples
        BEGIN_ENUM_LIST
            OFF,DISABLE,DISABLED        = 0x0, "Disable the GFN shader cache DLL"
            ON,ENABLE,ENABLED           = 0x1, "Enable the GFN shader cache DLL"
        END_ENUM_LIST
    Default: OFF
END_KEY

BEGIN_KEY OGL_GLSL_LINK_MULTITHREAD
    DefinedWhen:        1
    BinaryId:           0xeb92a3
    RemappedName:       OGL_eb92a3
    Type:               dword
    Documentation:      "GLSL link multithread force on/force off/force defer.  \"On\" means use multiple link threads.  \"Off\" means complete linking immediately when requested.  \"Defer\" means only complete the link when link results are required.  \"Defer\" is useful for debugging validation issues."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE     = 0, "Disable link multithreading"
            ENABLE      = 1, "Enable link multithreading"
            DEFER       = 2, "Defer, but don't multithread"
            ALLOW_API   = 3, "Allow API multithreading, but not default"
        END_ENUM_LIST
    Default: ALLOW_API
END_KEY


BEGIN_KEY OGL_GLSL_LINK_THREAD_APP_RESERVE
    DefinedWhen:    1
    BinaryID:       0xfaa14a
    RemappedName:   OGL_faa14a
    Type:           dword
    Documentation:   "Multithread linking. Reserve N CPU cores for the application, rather than allocating a link thread for all cores. 0 == auto."
    Default: 0
END_KEY

BEGIN_KEY OGL_GLSL_LINK_THREAD_MAX
    DefinedWhen:    1
    BinaryID:       0xfc64c7
    RemappedName:   OGL_fc64c7
    Type:           dword
    Documentation:   "Limits the number of threads created for multithread linking to N.  0 == auto (all physical cores)."
    Default: 0
END_KEY

BEGIN_KEY OGL_OPT_COMPILE_MULTITHREAD
    DefinedWhen:        1
    BinaryId:           0xef84d2
    RemappedName:       OGL_ef84d2
    Type:               dword
    Documentation:      "Optional compile multithread force on/force off/force heuristic. Requires GLSL_LINK_MULTITHREAD to be enabled. \"On\" means always force multithread compile.  \"Off\" means complete compile immediately on main thread.  \"Heuristic\" means only do multithread compile based on number of threads and total size of pending compiles."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE     = 0, "Disable optional compile multithreading"
            ALWAYS      = 1, "Force optional compile  multithreading"
            HEURISTIC   = 2, "Use number of threads and total pending compiles to determine"
        END_ENUM_LIST
    Default: HEURISTIC
END_KEY

BEGIN_KEY OGL_OPT_COMPILE_MAX_COMPILES_PER_THREAD
    DefinedWhen:        1
    BinaryId:           0xef84d3
    RemappedName:       OGL_ef84d3
    Type:               dword
    Documentation:      "Limits the number of optional compiles that can be queued to the number of link threads multiplied by this value."
    Default: 4
END_KEY

BEGIN_KEY OGL_OPT_COMPILE_MAX_QUEUE_BYTES
    DefinedWhen:        1
    BinaryId:           0xef84d4
    RemappedName:       OGL_ef84d4
    Type:               dword
    Documentation:      "Limits the total size of all of the programs in the optional compile queue."
    Default: 1048576
END_KEY

BEGIN_KEY OGL_GPU_LIMITED
    DefinedWhen:        1
    BinaryID:           0x21be9c
    RemappedName:       OGL_21be9c
    Type:               dword
    Documentation:      "Force the indicators in the driver for GPU and CPU limited to drive our heuristics"
    Values: bitfields
        BEGIN_ENUM_LIST
            NONE                  = 0x00000000, "Do not force anything"
            FORCE_GPU_LIMITED_OFF = 0x00000001, "Never let the driver think it is GPU limited"
            FORCE_GPU_LIMITED_ON  = 0x00000002, "Force the driver to think it is GPU limited"
            FORCE_CPU_LIMITED_OFF = 0x00000004, "Never let the driver think it is GPU limited"
            FORCE_CPU_LIMITED_ON  = 0x00000008, "Force the driver to think it is GPU limited"
            FORCE_ALL_OFF = FORCE_GPU_LIMITED_OFF | FORCE_CPU_LIMITED_OFF, "Force all off"
            FORCE_ALL_ON = FORCE_GPU_LIMITED_ON | FORCE_CPU_LIMITED_ON, "Force all on"
       END_ENUM_LIST
   Default: NONE
END_KEY

BEGIN_KEY OGL_EVENT_LOG_SEVERITY_THRESHOLD
    DefinedWhen:        1
    BinaryID:           0x9df23e
    RemappedName:       OGL_342abb
    Type:               dword
    UserVisibleName:    "Event Log Severity Threshold"
    OverInstallBehavior: OVERRIDE
    Documentation:      "This setting specifies the severity of events logged into the Windows Event log by the OpenGL driver."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE        = 0,  "Do not log any events"
            CRITICAL       = 1,  "Log only Critical events."
            WARNING        = 2,  "Log Warning and Critical events."
            INFORMATION    = 3,  "Log Information and more severe events."
            ALL            = 4,  "Log all events."
        END_ENUM_LIST
    Default:    ALL
END_KEY

BEGIN_KEY OGL_TMON_LEVEL
    DefinedWhen:        1
    BinaryID:           0x2888c1
    RemappedName:       OGL_2888c1
    Type:               dword
    UserVisibleName:    "Event Log Tmon Severity Threshold"
    OverInstallBehavior: OVERRIDE
    Documentation:      "This setting specifies the severity of events logged into the tmonlog by the OpenGL driver."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE        = 0,  "Do not log any events"
            CRITICAL       = 1,  "Log only Critical events."
            WARNING        = 2,  "Log Warning and Critical events."
            INFORMATION    = 3,  "Log Information and more severe events."
            MOST           = 4,  "Log all but verbose events."
            VERBOSE        = 5,  "Log all including verbose events"
        END_ENUM_LIST
    Default:    MOST
END_KEY

BEGIN_KEY OGL_PIXELS_FROM_MEMORY
    DefinedWhen:        1
    BinaryID:           0xc07bc3
    RemappedName:       OGL_93A89C0B
    Type:               dword
    Documentation:      "Toggle the usage of Pixels From Memory(PFM) for downsamples."
    Values: Samples
        BEGIN_ENUM_LIST
