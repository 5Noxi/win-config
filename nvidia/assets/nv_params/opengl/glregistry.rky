BEGIN_KEY VK_CONSTANT_FOLDING
    DefinedWhen:    1
    BinaryID:       0xc0def0
    RemappedName:   OGL_0xc0def0
    Type:           dword
    Documentation:  "Control whether shader constant folding is enabled and for which stages"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            // Set of flags, should match corresponding __GLprogramStage enum - i.e. (1 << stage)
            DISABLE                = 0x00000000,      "Disable shader constant folding (except by explicit hash list)"
            VERTEX                 = 0x00000001,      "Enable for vertex shaders"
            FRAGMENT               = 0x00000002,      "Enable for fragment shaders"
            GEOMETRY               = 0x00000004,      "Enable for geometry shaders"
            TESS_CONTROL           = 0x00000008,      "Enable for tessellation control shaders"
            TESS_EVALUATION        = 0x00000010,      "Enable for tessellation evaluation shaders"
            COMPUTE                = 0x00000020,      "Enable for compute shaders"
            TASK                   = 0x00000040,      "Enable for task shaders"
            MESH                   = 0x00000080,      "Enable for mesh shaders"
            PLATFORM_DEFAULT       = 0x40000000,      "Platform-specific defaults"
            FORCE_DISABLE          = 0x80000000,      "Disable entirely, even for shaders listed in VK_CONSTANT_FOLDING_HASH_LIST"
        END_ENUM_LIST
    Default: PLATFORM_DEFAULT
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_VERSION
    DefinedWhen:    1
    BinaryID:       0x0fed0c
    RemappedName:   OGL_0x0fed0c
    Type:           dword
    Documentation:  "CYA setting to switch between cfgpu implementation versions"
    Values:         Samples
        BEGIN_ENUM_LIST
            CFGPUV1 = 1,  "Original Vulkan CFGPU implementation. Does not support reusable command buffers. Keeping around initially as a CYA."
            CFGPUV2 = 2,  "New Vulkan CFGPU implementation."
        END_ENUM_LIST
    Default: CFGPUV1
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_STABILITY_THRESHOLD
    DefinedWhen:    1
    BinaryID:       0xc0def1
    RemappedName:   OGL_0xc0def1
    Type:           dword
    Documentation:  "Number of tracking passes a uniform needs to keep the same value before being constant folded"
    Default: 2
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_TRACKING_BUFFER_SIZE
    DefinedWhen:    1
    BinaryID:       0xc0def2
    RemappedName:   OGL_0xc0def2
    Type:           dword
    Documentation:  "Size of the buffer used for tracking constant values"
    Default: 0x10000
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_TRACKING_BUFFER_COUNT
    DefinedWhen:    1
    BinaryID:       0xc0def3
    RemappedName:   OGL_0xc0def3
    Type:           dword
    Documentation:  "Number of tracking buffers used by the constant folding perf strat"
    Default: 8
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_DEBUG_FLAGS
    DefinedWhen:    1
    BinaryID:       0xc0def4
    RemappedName:   OGL_0xc0def4
    Type:           dword
    Documentation:  "Set of debugging flags to control constant folding behavior"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            TRACKING_ONLY               = 0x00000001,      "Only perform constant tracking; Never optimize"
            SKIP_VALIDATION             = 0x00000002,      "Optimize programs, but skip validation (rendering errors can/will occur)"
            VALIDATION_TRAP             = 0x00000004,      "Never move a program back to the tracking state, even if it fails validation"
            DISABLE_PUSH_CONSTANT_FOLDING = 0x00000008,    "Don't fold push constant values"
            SKIP_SUBSTITUTION           = 0x00000010,      "Compile constant folded shaders, but don't use them"
            SKIP_SELECTION              = 0x00000020,      "Runs the validation shader, but ignores the result for shader selection"
        END_ENUM_LIST
    Default:    0 
END_KEY

