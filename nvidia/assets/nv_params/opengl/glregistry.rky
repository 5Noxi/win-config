BEGIN_KEY VK_SHADER_COPARGS_FORCE
    DefinedWhen:    1
    BinaryID:       0xbc1a34
    RemappedName:   OGL_bc1a34
    Type:           dword
    Documentation:  "Control which compiler options/optimizations are force enabled/disabled."
    Values: Bitfields
        BEGIN_ENUM_LIST
            ALL_DEFAULT       = 0x00000000, "Set all values to driver default"

            HIGH_LATENCY_HOIST_ENABLE        = 0x00000001, "Force enable High Latency Hoist"
            HIGH_LATENCY_HOIST_DISABLE       = 0x00000002, "Force disable High Latency Hoist"

            PARTIAL_LOOP_UNROLL_ENABLE       = 0x00000004, "Force enable Partial Loop Unrolling"
            PARTIAL_LOOP_UNROLL_DISABLE      = 0x00000008, "Force disable Partial Loop Unrolling"

            FULL_LOOP_UNROLL_ENABLE          = 0x00000010, "Force enable Full Loop Unrolling"
            FULL_LOOP_UNROLL_DISABLE         = 0x00000020, "Force disable Full Loop Unrolling"

            POST_UNROLL_HOIST_ENABLE         = 0x00000040, "Force enable Post Unroll Hoist"
            POST_UNROLL_HOIST_DISABLE        = 0x00000080, "Force disable Post Unroll Hoist"

            SCALARIZER_ENABLE                = 0x00000100, "Force enable Scalarizer"
            SCALARIZER_DISABLE               = 0x00000200, "Force disable Scalarizer"

            CONSTANT_FOLDING_ENABLE          = 0x00000400, "Force enable Constant folding"
            CONSTANT_FOLDING_DISABLE         = 0x00000800, "Force disable Constant folding"

            SWITCH_JUMP_TABLE_ENABLE         = 0x00001000, "Force enable allowing switches to be lowered to a jump table"
            SWITCH_JUMP_TABLE_DISABLE        = 0x00002000, "Force disable allowing switches to be lowered to a jump table"

            ENABLE_ALL                       = 0x55555555, "Force enable all options/optimizations"
            DISABLE_ALL                      = 0xaaaaaaaa, "Force disable all options/optimizations"
        END_ENUM_LIST
    Default: NONE
END_KEY

