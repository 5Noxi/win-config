BEGIN_KEY OGL_DISPATCHER_SLEEPORSPIN_HEURISTIC_FACTOR
    DefinedWhen:    1
    BinaryID:           0xcd128a
    RemappedName:   OGL_cd128a
    Type:   dword
    Documentation:  "Sets the factor N used in the sleep-or-spin heuristic in the dual core driver. That heuristic decides to sleep if the next sync is expected to take at least N times the time it takes for a sleep synchronization event, as profiled by the driver at startup. Use 0 to always sleep, or a very high value to always spin. Lower values sleep more aggressively."
    Values: Samples
        BEGIN_ENUM_LIST
        END_ENUM_LIST
    Default:    10
END_KEY

BEGIN_KEY OGL_YIELD_FUNCTION
    DefinedWhen:    1
    BinaryID:           0xddb579
    RemappedName:   OGL_yieldFunction
    Type:   dword
    Documentation:  "Default yield function to use. Depending on the operating system, not all yield functions may be implemented exactly."
    Values: Samples
        BEGIN_ENUM_LIST
            SWITCHTOTHREAD  = 0, "SwitchToThread() - Yield to next waiting thread only"
            BUSY_WAIT       = 1, "Busy Wait - Do not yield the CPU"
            SLEEP_0MS       = 2, "Sleep(0) - Yield to all waiting threads"
            SLEEP_1MS       = 3, "Sleep(1) - Yield CPU for approximately 1ms"
            SLEEP_250US     = 4, "usleep(250) - Sleep for approximately 250 microseconds"
            SLEEP_VARIABLE  = 5, "usleep(hintInfo->desiredDelayMicros) - Sleep requested time, if non-NULL hintInfo"
            ANDROID_DEFAULT = 5, "Default policy on Android"
        END_ENUM_LIST
    Default:    SWITCHTOTHREAD
END_KEY

