    BinaryID:       0x654715
    RemappedName:   OGL_n46gscka8
    Type:           dword
    Documentation:  "Align OG allocation address (WGL only)"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED       = 0,          "no adjustment"
            COUNT_SHIFT    = 0, ""
            COUNT_MASK     = 0x0000ffff, "align this number of OG allocations"
            COUNT_ALL      = 0x0000ffff, "align all OG allocations"
            COUNT_2        = 0x00000002, "align first two OG allocations"
            BIT_SHIFT      = 16, ""
            BIT_MASK       = 0x00ff0000, "force this address bit"
            BIT_12         = 0x000c0000, "force address bit 12"
            BIT_16         = 0x00100000, "force address bit 16"
            VALUE_SHIFT    = 24, ""
            VALUE_MASK     = 0x01000000, "force address bit to this value"
            VALUE_0        = 0x00000000, "force address bit to 0"
            VALUE_1        = 0x01000000, "force address bit to 1"
            FORCE_BIT16_VALUE0_COUNT2 = BIT_16 | VALUE_0 | COUNT_2, ""
            FORCE_BIT16_VALUE1_COUNT2 = BIT_16 | VALUE_1 | COUNT_2, ""
        END_ENUM_LIST
    Default:        FORCE_BIT16_VALUE1_COUNT2
END_KEY

