            ON                          = 0x00000001,      "Listen to CPMM requests, use separate thread if !SINGLE_THREADED, otherwise listen as part of __glNVPerFrameOperations"
            FORCE_SYNCHRONOUS           = 0x00000002,      "Listen to CPMM requests, always in __glNVPerFrameOperations"
