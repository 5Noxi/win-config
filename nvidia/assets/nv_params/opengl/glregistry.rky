            ALLOW_BYPASS         = 0x00000001, "Allow bypassing opengl32, call DrvPresentBuffers directly"
            ALLOW_WIN7BLIT       = 0x00000002, "Allow win7blit (starting with RS2)"
            ALLOW_WIN7BLIT_THUNK = 0x00000004, "Allow win7blit thunk present, bypassing pfnPresentToRedirectionSurface"
