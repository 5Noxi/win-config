            DISABLE_FLIP_TRANSITION   = 0x00000001, "Present transition to fullscreen flipping"
            DONT_REQUIRE_MSHYBRID     = 0x00000002, "Don't require MSHybrid flag to enable this path"
            DISABLE_INTEROP_SYNC      = 0x00000004, "Disable interop synchronization and use the present thread"
        END_ENUM_LIST
    Default:    NONE
END_KEY

