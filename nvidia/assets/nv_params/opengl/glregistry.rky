BEGIN_KEY OGL_PERF_STRAT_LDDM_BUFFER_SIZE_CONTROL
    DefinedWhen:    1
    BinaryID:           0x666860
    RemappedName:   OGL_LddmBufferSizeControl
    Type:   dword
    Documentation:  "Controls the behavior of how the\n\n    OGL_PERF_STRAT_LDDM_CMDBUFFER_SIZE\n    OGL_PERF_STRAT_LDDM_PATCHLOCATIONTABLE_SIZE\n    OGL_PERF_STRAT_LDDM_ALLOCATIONTABLE_SIZE\n\nregistry keys are used when creating a new context."
    Values: Samples
        BEGIN_ENUM_LIST
            REG_KEY = 0x0, "size = OGL_PERF_STRAT_LDDM_XXX_SIZE"
            MIN_MIN_REG_KEY = 0x1, "size = __GL_MIN(NVL_MIN_INITIAL_XXX_SIZE, OGL_PERF_STRAT_LDDM_XXX_SIZE)"
            MIN_MAX_REG_KEY = 0x2, "size = __GL_MIN(NVL_MAX_INITIAL_XXX_SIZE, OGL_PERF_STRAT_LDDM_XXX_SIZE)"
            MAX_MIN_REG_KEY = 0x3, "size = __GL_MAX(NVL_MIN_INITIAL_XXX_SIZE, OGL_PERF_STRAT_LDDM_XXX_SIZE)"
            MAX_MAX_REG_KEY = 0x4, "size = __GL_MAX(NVL_MAX_INITIAL_XXX_SIZE, OGL_PERF_STRAT_LDDM_XXX_SIZE)"
            FORCE_MIN = 0x5, "size = NVL_MIN_INITIAL_XXX_SIZE"
            FORCE_MID = 0x6, "size = NVL_MID_INITIAL_XXX_SIZE"
            FORCE_MAX = 0x7, "size = NVL_MAX_INITIAL_XXX_SIZE"
            FORCE_ZERO = 0x8, "size = 0"
        END_ENUM_LIST
    Default:    MIN_MIN_REG_KEY
END_KEY

