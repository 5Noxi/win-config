/*
 * Controls driver behavior related to wddmv2 residency model.
 * Refer to //sw/docs/gpu/drivers/OpenGL/wddm2/ogl-wddmv2-overview.docx.
 *
 * | stage | residency | res when | sync   | sync type | regkey |
 * |-------+-----------+----------+--------+-----------+--------|
 * | mR1   | OS        | always   | OS     | sync      |    dnc |
 * | mR2   | driver    | always   | OS     | sync      |      0 |
 * | mR2   | driver    | always   | driver | async     |      1 |
 * | mR3   | driver    | both     | driver | async     |      1 |
 * | mR5   | driver    | always   | driver | async     |      1 |
 * | mR6   | driver    | use      | driver | async     |      1 |
 *
 * | stage | periodicTrim | evictToBudget | allocLegacyAlPll |
 * |-------+--------------+---------------+------------------|
 * | mR3   | no           | no            | yes              |
 * | mR5   | yes          | no            | yes              |
 * | mR6   | yes          | yes           | no               |
 *
 * regeky: RTL_REGISTRY_CONTROL/GraphicsDrivers/MemoryManagement/EnableAsyncResidency
 *
 * 'Both' residency means lock (MakeResident) at CreateAllocation, then
 * lock again at use. Locking at use enables comparing isResident against
 * the AL to assert if any allocations were not made resident.
 */
BEGIN_KEY OGL_WDDM2_RESIDENCY_CONTROL
    DefinedWhen:    1
    BinaryID:       0x9af32c
    RemappedName:   OGL_9af32c
    Type:   dword
    Documentation:  "Controls driver behavior related to wddmv2 residency model.\nRefer to //sw/docs/gpu/drivers/OpenGL/wddm2/ogl-wddmv2-overview.docx.\n\n| stage | residency | res when | sync   | sync type | regkey |\n|-------+-----------+----------+--------+-----------+--------|\n| mR1   | OS        | always   | OS     | sync      |    dnc |\n| mR2   | driver    | always   | OS     | sync      |      0 |\n| mR2   | driver    | always   | driver | async     |      1 |\n| mR3   | driver    | both     | driver | async     |      1 |\n| mR5   | driver    | always   | driver | async     |      1 |\n| mR6   | driver    | use      | driver | async     |      1 |\n\n| stage | periodicTrim | evictToBudget | allocLegacyAlPll |\n|-------+--------------+---------------+------------------|\n| mR3   | no           | no            | yes              |\n| mR5   | yes          | no            | yes              |\n| mR6   | yes          | yes           | no               |\n\nregeky: RTL_REGISTRY_CONTROL/GraphicsDrivers/MemoryManagement/EnableAsyncResidency\n\n'Both' residency means lock (MakeResident) at CreateAllocation, then\nlock again at use. Locking at use enables comparing isResident against\nthe AL to assert if any allocations were not made resident."
    Values: Samples
        BEGIN_ENUM_LIST
            mR1 = 1,   "OS does MakeResident and synchronous paging"
            mR2 = 2,   "MakeResident at Alloc"
            mR3 = 3,   "MakeResident at Alloc and at Use"
            mR5 = 5,   "mR2 + periodicTrim"
            mR5a = 51, "(temporary) MakeResident at use, periodic trim (no toBudget), have AL/PLL"
            mR5b = 52, "(temporary) MakeResident at use, periodic and toBudget trim, have AL/PLL"
            mR6 = 6,   "MakeResident at use, periodic and toBudget trim, no AL/PLL"
            DEV = 7,   "Temporary development settings."
        END_ENUM_LIST
    Default:    mR5b
END_KEY

BEGIN_KEY OGL_WDDM2_RESIDENCY_DEBUG_FLAGS
    DefinedWhen:    1
    BinaryID:       0x28ca3e
    RemappedName:   OGL_28ca3e
    Type:   dword
    Documentation:  "Debug flags that override individual bits of behavior from OGL_WDDM2_RESIDENCY_CONTROL"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                        = 0,          "All flags off"
            FORCE_RESIDENCY_AT_CREATE   = 0x00000001, "Trapdoor force residency in postCreateResource"
            FORCE_RESIDENCY_AT_FINALIZE = 0x00000002, "Trapdoor force residency in Finalize (processing AL)"
            DISABLE_ASSUME_NOT_IN_USE_OPT = 0x00000004, "Disable AssumeNotInUse optimization in DestroyAllocation"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY OGL_WDDM2_RESIDENCY_MAX_TRIM_LEVEL
    DefinedWhen:    1
    BinaryID:       0x28ca3f
    RemappedName:   OGL_28ca3f
    Type:   dword
    Documentation:  "Control which trim level is the highest allowed"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ANY_TRIM                          = 0,          "Allow any level"
            LEVEL1                            = 1,          "Allow up to level 1"
            LEVEL2                            = 2,          "Allow up to level 2"
            LEVEL3                            = 3,          "Allow up to level 3"
        END_ENUM_LIST
    Default: ANY_TRIM
END_KEY

BEGIN_KEY OGL_WDDM2_LDA_BROADCAST_SUBMIT
    DefinedWhen:    1
    BinaryID:           0x0f8b72
    RemappedName:   OGL_0f8b72
    Type:   dword
    Documentation:  ""
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE         = 0, "Unicast LDA buffer submission"
            ENABLE          = 1, "Broadcast LDA buffer submission"
        END_ENUM_LIST
    // Disabled by default because in testing, broadcast submissions show more fluctuation in
    // performance and never exceed the performance of unicast submissions.
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SCG_MAX_SM_FRACTION
    BinaryID:           0x300fc8
    RemappedName:   OGL_0x300fc8
    Type:   dword
    Documentation:  "Limits hardware to use only a fraction of the total SM count for SCG (simultaneous compute and graphics).  A value of 0x100 means to use all SMs."
    Values: Samples
        BEGIN_ENUM_LIST
            DEFAULT        = 0x67, "Default - 40% of SMs to be used for SCG"
            MIN            = 0x0, "Allow 0% of all SMs to be used for SCG (rounded up to 1 SM)"
            MAX            = 0x100, "Allow up to 100% of all SMs to be used for SCG."
        END_ENUM_LIST
    Default:    DEFAULT
END_KEY

BEGIN_KEY OGL_SCG_MIN_SM_FRACTION
    BinaryID:           0x301fc8
    RemappedName:   OGL_0x301fc8
    Type:   dword
    Documentation:  "Sets a floor on the fraction of SMs that will be allocated to SCG work. This only applies if there is actually SCG work, if there isn't these SMs will be released to do GFX work."
    Values: Samples
        BEGIN_ENUM_LIST
            MIN            = 0x0, "No minimum guarantee for the number of SMs dedicated to SCG."
            MAX            = 0x100, "All SMs will be allocated to SCG work when it is available."
        END_ENUM_LIST
    Default:    MIN
END_KEY

BEGIN_KEY OGL_SCG_FLAGS
    BinaryID:           0x302fc8
    RemappedName:   OGL_0x302fc8
    Type:   dword
    Documentation:  "Flags controlling SCG behaviour"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_LIMITS_IN_ALL_COMPUTE    =    0x00000001, "All SMs will be allocated to SCG when the FE determines there is no GFX work available."
        END_ENUM_LIST
    Default:    DISABLE_LIMITS_IN_ALL_COMPUTE
END_KEY

BEGIN_KEY VK_COMPUTE_QUEUE_FLAGS
    BinaryID:           0xC32AD3
    RemappedName:   OGL_0xC32AD3
    Type:   dword
    Documentation:  "Flags Vulkan SCG behaviour"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED              =    0x00000000, "Disable Vulkan Compute Queue support"
            ENABLE_GM20X          =    0x00000001, "Enable Vulkan Compute Queue support for GM20X+"
            ENABLE_GP10X          =    0x00000002, "Enable Vulkan Compute Queue support for GP10X+"
            ENABLE_TU10X          =    0x00000004, "Enable Vulkan Compute Queue support for TU10X+"
            ENABLE_NON_SCG        =    0x80000000, "Exposes a Vulkan Compute Queue without doing SCG"
        END_ENUM_LIST
    Default:    ENABLE_GP10X
END_KEY

