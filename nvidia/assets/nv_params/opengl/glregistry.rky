BEGIN_KEY OGL_DEFAULT_SWAP_INTERVAL
    DefinedWhen:    1
    BinaryID:           0x6a6582
    RemappedName:   OGL_DefaultSwapInterval
    Type:   dword
    UserVisibleName: "OpenGL default swap interval"
    Documentation:  "Controls the number of V-blank signals from the display to wait before rendering a frame (SwapInterval) on OpenGL. In order to force VSYNC ON or OFF, use VSYNCMODE"
    Values: Bitfields
        BEGIN_ENUM_LIST
            TEAR            =          0, "Allow Tearing"
            VSYNC_ONE       =          1, "Sync to VSync"
            VSYNC           =          1, "Sync to VSync default value which is vsync to 1 vsync"
            VALUE_MASK      = 0x0000FFFF, "Read mask"
            FORCE_MASK      = 0xF0000000, "Force bit read mask"
            FORCE_OFF       = 0xF0000000, "Force sync off"
            FORCE_ON        = 0x10000000, "Force sync on"
            APP_CONTROLLED  = 0x00000000, "Allow application to toggle"
            DISABLE         = 0xffffffff, "Disable Wait For VSync"
        END_ENUM_LIST
    Default:    VSYNC_ONE
END_KEY

BEGIN_KEY OGL_OVERRIDE_VSYNCMODE
    DefinedWhen:    1
    BinaryID:           0x84bf14
    RemappedName:   OGL_84bf14
    Type:   dword
    Documentation:  "Various policies for overriding the swap interval set in NVCPL or application"
    Values: Samples
        BEGIN_ENUM_LIST
            NO_OVERRIDE          = 0, "Use standard vsync policy"
            VR_FORCE_OFF         = 2, "When interop-based VR is detected, force vsync off"
        END_ENUM_LIST
    Default:    VR_FORCE_OFF
END_KEY

