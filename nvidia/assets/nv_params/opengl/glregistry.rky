BEGIN_KEY OGL_APP_WAR_BUG_1446990_REMOVE_INVALIDATE_BUFFER_BIT
    DefinedWhen:         1
    BinaryID:            0xe01f2d
    RemappedName:        OGL_0xe01f2d
    Type:   bool
    Documentation:       "WAR bug 1446990: Unity sets MAP_INVALIDATE_BUFFER_BIT eventhough it reads from the mapped area. Mask MAP_INVALIDATE_BUFFER_BIT flag away from <access> parameter provided to MapBufferRange(). Default is no masking."
