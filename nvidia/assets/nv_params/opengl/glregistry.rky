        BEGIN_ENUM_LIST
            DISABLE_NONE                   = 0x00000000, "Expose all available configs."
            DISABLE_SWAP_PRESERVED         = 0x00000001, "Disable the swap preserve capability."
            DISABLE_DEPTH_24_STENCIL_0     = 0x00000002, "Disable Z24S0 configs."
        END_ENUM_LIST
    Default:    DISABLE_SWAP_PRESERVED
END_KEY

BEGIN_KEY VK_NVVM
    DefinedWhen:    1
    BinaryID:       0x8f3477
    RemappedName:   VK_NextGenCompiler
    Type:           dword
    Documentation:  "Enable NVVM compiler for Vulkan"
    Values:         Samples
        BEGIN_ENUM_LIST
            DISABLE                       = 0x00000000, "Disable NVVM."
            ENABLE                        = 0x00000001, "Enable NVVM."
            AUTO                          = 0x00000002, "Driver default."
            FORCE_ENABLE                  = 0x00000003, "Force enable NVVM, even for unsupported SPIR-V."
        END_ENUM_LIST
    Default:    AUTO
END_KEY

BEGIN_KEY OGL_DEFAULT_SHADER_DISK_CACHE_LOCATION
    DefinedWhen:    1
    BinaryID:       0x19d12f
    RemappedName:   OGL_19d12f
    Type:           dword
    Documentation:  "Control where OGL driver should store the shader disk cache files"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            AUTOSELECT                    = 0x00000000, "Let driver decide the shader cache location based on process integrity levels"
            LOCAL                         = 0x00000001, "Force to use LOCAL folder (only for debug and make sure untrusty process cannot create cache)"
            LOCAL_LOW                     = 0x00000002, "Force to use LOCALLOW folder (only for debug and make sure trusty process can still create cache)"
        END_ENUM_LIST
    Default:    AUTOSELECT
END_KEY

BEGIN_KEY OGL_NON_FRAGMENT_TEXTURE_LOD
    DefinedWhen:    1
    BinaryID:       0x4c0734
    RemappedName:   OGL_4c0734
    Type:   dword
    Documentation:  "Control the handling of texture LOD computations in non-fragment shaders."
    Values: Bitfields
        BEGIN_ENUM_LIST
            ZERO_DERIVATIVES = 0x0, "Use hardware instructions using zero derivatives (LOD = -INF)."
            ZERO_LOD = 0x1, "Use software replacements that force the base LOD to zero."
        END_ENUM_LIST
    Default:    ZERO_DERIVATIVES
END_KEY

BEGIN_KEY VK_BINDLESS_UBO
    DefinedWhen:    1
    BinaryID:       0x4c0735
    RemappedName:   OGL_0x4c0735
    Type:           dword
    Documentation:  "Enable higher UBO descriptor limits for Vulkan"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            DISABLE                       = 0x00000000, "Disable bindless UBO."
            ENABLE                        = 0x00000001, "Enable bindless UBO."
            HW_DEFAULT                    = 0x00000002, "Hardware default."
        END_ENUM_LIST
    Default:    HW_DEFAULT
END_KEY

BEGIN_KEY VK_ENABLE_TURING_IMPLICIT_MULTIVIEW
    DefinedWhen:    1
    BinaryID:       0x4c0736
    RemappedName:   OGL_0x4c0736
    Type:           dword
    Documentation:  "Enable Turing multi-view optimization, where shaders dependent on view IDs are optimized to produce outputs for all views in a single pass."
    Values:         Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            FALSE                       = 0x00000000, "Disable Turing multiview optimization. "
            TRUE                        = 0x00000001, "Enable Turing multiview optimization. "
        END_ENUM_LIST
    Default:    TRUE
END_KEY

BEGIN_KEY VK_FAST_MATH
    DefinedWhen:        1
    BinaryID:           0x8f212e
    RemappedName:       OGL_4238713e
    Type:               dword
    Documentation:      "Allow looser floating point behavior for Vulkan compiles for specific stages"
    Values: Bitfields
        BEGIN_ENUM_LIST
            VERTEX          = 0x1, "Enable fast math for Vulkan vertex"
            FRAGMENT        = 0x2, "Enable fast math for Vulkan fragment"
            GEOMETRY        = 0x4, "Enable fast math for Vulkan geometry"
            TESS_CONTROL    = 0x8, "Enable fast math for Vulkan tess control"
            TESS_EVALUATION = 0x10, "Enable fast math for Vulkan tess evaluation"
            COMPUTE         = 0x20, "Enable fast math for Vulkan compute"
            TASK            = 0x40, "Enable fast math for Vulkan task"
            MESH            = 0x80, "Enable fast math for Vulkan mesh"
            ALL             = 0xff, "Enable fast math for all Vulkan shaders"
        END_ENUM_LIST
    Default:    ALL
END_KEY

BEGIN_KEY OGL_LDC_WITH_LDG
    DefinedWhen:        1
    BinaryID:           0x83212e
    RemappedName:       OGL_42f8713e
    Type:               dword
    Documentation:      "Replace LDC with LDG in some cases for bug 200364993"
    Values:             Samples
        BEGIN_ENUM_LIST
            NEVER          = 0x00000000, "Never replace constant loads with LDG for the workaround"
            ALWAYS         = 0x00000001, "Always replace constant buffer loads with LDG"
            INDEXED        = 0x00000002, "Replace indexed constant loads with LDG"
            DYNAMIC        = 0x00000003, "Use the default driver heuristic to select modes"
            HW_DEFAULT     = 0x00000004, "Arch-specific default behavior"
        END_ENUM_LIST
    Default: HW_DEFAULT
END_KEY

BEGIN_KEY VK_LDC_WITH_LDG_HASH_LIST
    DefinedWhen:        1
    BinaryID:           0x83212f
    RemappedName:       OGL_83212f
    Type:               string
    Documentation:      "String for passing list of appHashes to replace constant loads with LDG for. ';' delimited eg: '0xbadcf00ddeadbeef;' or an upper/lower bound eg: '<=0xbadcf00ddeadbeef'"
    Default: ""
END_KEY

BEGIN_KEY VK_QUEUES_SINGLE_STATE
    DefinedWhen:    1
    BinaryID:       0xaf34c7
    RemappedName:   OGL_0xaf34c7
