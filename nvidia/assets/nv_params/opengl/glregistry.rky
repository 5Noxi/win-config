BEGIN_KEY VK_EXT_MESH_SHAREDMEM_EMU_MODE
    DefinedWhen:        1
    BinaryID:           0xBF9011
    RemappedName:       OGL_0xBF9011
    Type:               dword
    Documentation:      "Controls the shared memory emulation mode for Mesh Shader (EXT_mesh_shader)."
    Values: Samples
        BEGIN_ENUM_LIST
            SINGLE_CTA_PER_SM = 0x0,      "Force single CTA/SM when shared memory emulation is used."
            MAX_CTAS_PER_SM   = 0x1,      "Allow maximum number of CTAs per SM when shared memory emulation is used."
        END_ENUM_LIST
    Default: SINGLE_CTA_PER_SM
END_KEY

BEGIN_KEY OGL_NONMULTISAMPLED_Z
    DefinedWhen:        1
    BinaryID:           0x394A56
    RemappedName:       OGL_23409817
    Type:               dword
    Documentation:      "Sets the depth (Z) sampling method for multisampling buffers when the multisampling is disabled.\nWhen using single-sample depth buffers or when multisampling is enabled, this setting is ignored by hardware."
    Values: Samples
        BEGIN_ENUM_LIST
            PER_SAMPLE      = 0x0, "depth values are from the current sample"
            AT_PIXEL_CENTER = 0x1, "depth values used are from the pixel center when multisample is disabled"
        END_ENUM_LIST
    Default: PER_SAMPLE
END_KEY

BEGIN_KEY VK_RAY_TTU_SLEEP_WAR
    BinaryID:           0xB13013
    RemappedName:   OGL_0xB13013
    Type:   dword
    Documentation:  "Controls workaround for Turing TTU HW bug 2648362"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED                   = 0x00000000, "No workarounds"
            PIPELINE_ENABLE            = 0x00000001, "Enable workaround for ray tracing pipelines on Turing"
            RAY_QUERY_ENABLE           = 0x00000002, "Enable workaround for ray query on Turing"
            ALL = PIPELINE_ENABLE | RAY_QUERY_ENABLE, "Enable workaround for all paths on Turing"
        END_ENUM_LIST
    Default:    ALL
END_KEY

