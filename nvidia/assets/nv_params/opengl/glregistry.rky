            ENABLE                 = 0x00000001,      "Enable copy query pool acquire prefetch"
        END_ENUM_LIST
    Default: ENABLE
END_KEY

BEGIN_KEY VK_HOST_VISIBLE_VIDMEM
    DefinedWhen:    1
    BinaryID:       0xc0def8
    RemappedName:   VK_HostVisibleVidmem
    Type:           dword
    Documentation:  "Controls whether the host-visible vidmem type and heap (DEVICE_LOCAL | HOST_VISIBLE | HOST_COHERENT) are exposed through the Vulkan API."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLED                = 0, "Disabled"
            ENABLED                 = 1, "Enabled"
            ENABLE_LARGE_BAR1_ONLY  = 2, "Enabled only for configs with BAR1 >= FB size"
        END_ENUM_LIST
    Default:       ENABLED
END_KEY

BEGIN_KEY VK_HOST_VISIBLE_VIDMEM_SYSMEM_FALLBACK
    DefinedWhen:    1
    BinaryID:       0xba7e04
    RemappedName:   VK_HostVisibleVidmemSysmemFallback
    Type:           dword
    Documentation:  "Controls whether oversubscription of the host-visible heap automatically retries in sysmem rather than failing the allocation. For use as WAR for certain applications."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLED                = 0, "Disabled"
            ENABLED                 = 1, "Enabled"
        END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY VK_PROMOTE_SYSMEM_TO_HOST_VISIBLE_VIDMEM
    DefinedWhen:    1
    BinaryID:       0xba7e05
    RemappedName:   VK_PromoteSysmemToHostVisibleVidmem
    Type:           dword
    Documentation:  "Controls trying to promote some sysmem types into HVV for better GPU perf"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED                = 0, "Disabled"
            UNCACHED                = 1, "Try to promote __VkPhysicalDevice::MEMORY_TYPE_SYSHEAP"
            CACHED                  = 2, "Try to promote __VkPhysicalDevice::MEMORY_TYPE_CACHED"
            INCLUDE_PRE_AMPERE      = 4, "Also try for pre-Ampere (business decision to exclude by default)"
        END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY VK_HOST_VISIBLE_VIDMEM_HEAP
    DefinedWhen:        1
    BinaryID:           0x7f9ab3
    RemappedName:       OGL_7f9ab3
    Type:               dword
    Documentation:      "Controls the device local memory heaps we advertise for HVV."
    Values:             Samples
        BEGIN_ENUM_LIST
            USE_OWN_HEAP                    = 0, "Use separate heaps for VIDMEM and HVV."
            USE_VIDMEM_HEAP                 = 1, "Use the same heap as VIDMEM."
            USE_VIDMEM_HEAP_FOR_LARGE_BAR1  = 2, "Use the VIDMEM heap only when BAR1 >= VIDMEM (ignoring bar1ReserveBytes), otherwise use a separate HVV heap."
        END_ENUM_LIST
    Default: USE_VIDMEM_HEAP_FOR_LARGE_BAR1
END_KEY

BEGIN_KEY OGL_BAR1_LIMIT
    DefinedWhen:    1
    BinaryID:       0xdac44e
    RemappedName:   OGL_dac44e
    Type:           dword
    Documentation:  "Limits the amount of BAR1 space available to the application. Units in MiB. Amount made available is the min of this and the amount the GPU actually supports."
    Values: Samples
        BEGIN_ENUM_LIST
            MAX = 0xffffffff, "Essentially unlimited - about 4 petabytes"
        END_ENUM_LIST
    Default: MAX
END_KEY

BEGIN_KEY OGL_BAR1_RESERVE_SPACE
    DefinedWhen:    1
    BinaryID:       0xc0def9
    RemappedName:   OGL_BAR1ReserveSpace
    Type:           dword
    Documentation:  "Controls the amount of BAR1 space in MiB that OpenGL and Vulkan cannot use, which is reserved for other applications to allocate graphics channels. A reserve of 10MiB should allow roughly 12 additional apps to start after an app uses all of the BAR1 space it can."
    Default:       10
END_KEY

