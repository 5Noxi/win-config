    DefinedWhen:    1
    BinaryID:       0xc42a04
    RemappedName:   OGL_MemmgrVidHeapAllocLimit
    Type:           dword
    Documentation:   "Set an upper limit on vidmem heap allocations, in 4 KiB increments. This limit will be capped to the driver's default limit."
    Default: 0
END_KEY

BEGIN_KEY OGL_MEMMGR_SYS_HEAP_ALLOC_LIMIT
    DefinedWhen:    1
    BinaryID:       0xc42a05
    RemappedName:   OGL_MemmgrSysHeapAllocLimit
    Type:           dword
    Documentation:   "Set an upper limit on sysmem heap allocations, in 4 KiB increments. This limit will be capped to the driver's default limit."
    Default: 0
END_KEY

BEGIN_KEY OGL_MEMMGR_CACHED_ALLOC_LIMIT
    DefinedWhen:    1
    BinaryID:       0xc42a06
    RemappedName:   OGL_MemmgrCachedAllocLimit
    Type:           dword
    Documentation:   "Set an upper limit on cached DMA allocations, in 4 KiB increments. This limit will be capped to the driver's default limit."
    Default: 0
END_KEY

BEGIN_KEY OGL_MEMMGR_SYS_HEAP_ALLOC_LIMIT_RATIO
    DefinedWhen:    1
    BinaryID:       0xe1389a
    RemappedName:   OGL_MemmgrSysHeapAllocLimitRatio
    Type:           dword
    Documentation:   "Set an upper limit on sysmem heap allocations, expressed in percentage of the total amount of sysmem. This value will override OGL_MEMMGR_SYS_HEAP_ALLOC_LIMIT"
    // When sys heap is almost full, we could allow allocations, but they may fail residency later, see bug 3255421. Prevent by reducing sysheap size
    Default: 95
END_KEY

BEGIN_KEY OGL_MEMMGR_CACHED_ALLOC_LIMIT_RATIO
    DefinedWhen:    1
    BinaryID:       0xc82d63
    RemappedName:   OGL_MemmgrCachedAllocLimitRatio
    Type:           dword
    Documentation:   "Set an upper limit on cached DMA allocations, expressed in percentage of the total amount of sysmem. This value will override OGL_MEMMGR_CACHED_ALLOC_LIMIT"
    // When sys heap is almost full, we could allow allocations, but they may fail residency later, see bug 3255421. Prevent by reducing sysheap size
    Default: 95
END_KEY

BEGIN_KEY OGL_GS_LINE_OPTIMIZATION
    DefinedWhen:        1
    BinaryID:           0x255e39
    RemappedName:       OGL_255e39
    Type:               dword
    Documentation:      "Enables or disables the optimization that uses a Geometry Shader in order to cull early smooth AA lines. Only works on cards with more than 1 GPC."
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLE      = 1, "Enable the Geometry Shader optimization."
            DISABLE     = 0, "Disable the Geometry Shader optimization."
        END_ENUM_LIST
    Default:            DISABLE
