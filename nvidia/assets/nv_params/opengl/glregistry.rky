/*
 * Controls usage of dedicated hw state per GL context.
 *
 */
BEGIN_KEY OGL_DEDICATED_HW_STATE_PER_CONTEXT
    DefinedWhen:        1
    BinaryID:           0xC17757
    RemappedName:       OGL_HWSTATE_PER_CTX
    Type:               dword
    Documentation:      "Controls whether GL is allowed to use dedicated HW state per context"
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE         = 0, "Not allowed"
            ENABLE          = 1, "Allowed for all contexts"
            ENABLE_ROBUST   = 2, "Allowed for robust contexts only"
            TEGRA_DEFAULT   = 2, "Default for Tegra platforms"
        END_ENUM_LIST
    Default:            DISABLE
END_KEY

BEGIN_KEY OGL_DEDICATED_HW_STATE_PER_CONTEXT_SERIALIZE_EXEC
    DefinedWhen:        1
    BinaryID:           0xC17758
    RemappedName:       OGL_SERIALIZE_CONTEXTS
    Type:               dword
    Documentation:      "Workaround for applications that requires serialized execution on the GPU for the contexts used by a single thread. Can break Vsync, can hurt performance."
    Values: Samples
        BEGIN_ENUM_LIST
            FALSE         = 0, "Do not serialize"
            TRUE          = 1, "Serialize execution using host semaphores at MakeCurrent/LoseCurrent"
        END_ENUM_LIST
    Default:            FALSE
END_KEY

BEGIN_KEY OGL_COMMAND_LIST_CONTROL
    DefinedWhen:    1
    BinaryID:       0x9af32d
    RemappedName:   OGL_9af32d
    Type:   dword
    Documentation:  "Controls driver behavior related to command_list"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DYNAMIC                 = 0x00000000, "load balance between CPU & GPU decoding"
            FORCE_GPU_DECODE        = 0x00000001, "always use GPU decoding"
            FORCE_CPU_DECODE        = 0x00000002, "always use CPU decoding"
        END_ENUM_LIST
    Default:    DYNAMIC
END_KEY

BEGIN_KEY OGL_COMMANDLIST_GEFORCE_SLOWDOWN
    DefinedWhen:    1
    BinaryID:       0x9af32e
    RemappedName:   OGL_9af32e
    Type:           dword
    Documentation:  "Value of the slowdown on geforce products for each draw inside a commandlist"
    Values: Samples
        BEGIN_ENUM_LIST
            DEFAULT_GEFORCE         = 0x10, "number of cycles to wait per draw on geforce"
        END_ENUM_LIST
    Default:    DEFAULT_GEFORCE
END_KEY

BEGIN_KEY OGL_TILE_COALESCER_CONTROL
    DefinedWhen:    1
    BinaryID:       0xeae964
    RemappedName:   OGL_eae964
    Type:           dword
    Documentation:  "Controls the HW Tile Coalescer(TC) - used for arch experiments"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            MODE_NO_CONFLICT_DETECT         =   0x00000000, "Conflict detection disabled"
            MODE_CONFLICT_DETECT_SAMPLE     =   0x00000001, "Same pixel may appear in different quads, but they will not cover same samples"
            MODE_CONFLICT_DETECT_PIXEL      =   0x00000002, "the same pixel will not appear in more than one TC tile"

            TILE_SIZE_16x16                 =   0x00000000, "Sets the TC tile size to 16x16 (HW default)"
            TILE_SIZE_8x8                   =   0x00000004, "Sets the TC tile size to 8x8"

            FRAGMENT_ORDER_ORDERED          =   0x00000000, "TC tiles are processed in the API order of the primitives"
            FRAGMENT_ORDER_UNORDERED        =   0x00000008, "API ordering of the primitives is not guaranteed"
        END_ENUM_LIST
    Default:    MODE_NO_CONFLICT_DETECT | TILE_SIZE_16x16 | FRAGMENT_ORDER_ORDERED
END_KEY

