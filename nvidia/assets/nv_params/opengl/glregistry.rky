BEGIN_KEY VK_UNDEFINED_LAYOUT_TRANSITION_CLEAR
    DefinedWhen:        1
    BinaryID:           0xbc1a2e
    RemappedName:       OGL_0xbc1a2e
    Type:               dword
    Documentation:      "Controls clear behavior on layout transition from undefined layout"
    Values:             Samples
        BEGIN_ENUM_LIST
            DISABLE                                 = 0x00000000, "disable"
            FORCE_ENABLE                            = 0x00000001, "enable on all HW"
            HW_DEFAULT                              = 0x00000002, "enable on HW that needs it"
            FORCE_ENABLE_ALLOW_TRANSFER_QUEUE       = 0x00000003, "enable on all HW, also for layout transition submitted to transfer queue" 
            HW_DEFAULT_ALLOW_TRANSFER_QUEUE         = 0x00000004, "enable on HW that needs it, also for layout transition submitted to transfer queue"
        END_ENUM_LIST
    Default: HW_DEFAULT_ALLOW_TRANSFER_QUEUE
END_KEY

