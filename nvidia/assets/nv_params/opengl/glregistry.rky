    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE = 0, "When the dual core driver is enabled, all functions that interact with sync objects must synchronize with the worker thread."
            ENABLE  = 1, "When the dual core driver is enabled, most functions that interact with sync objects can avoid synchronizing with the worker thread."
        END_ENUM_LIST
    Default:        ENABLE
END_KEY

