BEGIN_KEY VK_QUADRO_SYNC_POLARITY
    DefinedWhen:    1
    BinaryID:       0x2CE308
    RemappedName:   VK_QuadroSyncPolarity
    Type:           dword
    Documentation:  "Controls which edge of the Quadro Sync FrameLock sync pulse the GPU will sync to"
    Values: Samples
        BEGIN_ENUM_LIST
            RISING_EDGE   = 0x0, "Sync to rising edge of sync pulse"
            FALLING_EDGE  = 0x1, "Sync to falling edge of sync pulse"
            BOTH_EDGES    = 0x2, "Sync to both edges of sync pulse"
        END_ENUM_LIST
    Default:   RISING_EDGE
END_KEY

BEGIN_KEY VK_SHADER_OUTPUT_OPTIMIZATION_STAGES
    DefinedWhen:    1
    BinaryID:           0x045533
    RemappedName:       OGL_0x045533
    Type:   dword
    Documentation:  "Flags to enable the dead output optimization (output attribute minimization) for different shader stages."
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE             = 0x00000000, "Disable the dead output optimization for all shaders."
            VERTEX           = 0x00000001, "Enable the dead output optimization for vertex shaders."
            TESS_CONTROL     = 0x00000002, "Enable the dead output optimization for tessellation control shaders."
            TESS_EVALUATION  = 0x00000004, "Enable the dead output optimization for tessellation evaluation shaders."
            GEOMETRY         = 0x00000008, "Enable the dead output optimization for geometry shaders."
            FRAGMENT         = 0x00000010, "Enable the dead output optimization for fragment shaders."
            /* Reserve 0x00000020 for COMPUTE. The dead output optimization doesn't apply to compute shaders. */
            TASK             = 0x00000040, "Enable the dead output optimization for task shaders."
            MESH             = 0x00000080, "Enable the dead output optimization for mesh shaders."
        END_ENUM_LIST
    Default:    VERTEX | TESS_CONTROL | TESS_EVALUATION | GEOMETRY | FRAGMENT
END_KEY

BEGIN_KEY OGL_SPH_MRT_ENABLE
    DefinedWhen:        1
    BinaryID:           0x76AC62
    RemappedName:       OGL_76AC62
    Type:               dword
    Documentation:      "Controls setting of SPH.MRT_ENABLE."
    Values: Samples
        BEGIN_ENUM_LIST
            ONLY_ON_DRAWBUFFERS = 0x0, "Enable MRT only on multiple shader outputs"
            DEPENDING_ON_FP_OUT = 0x1, "Enable MRT also when gl_FragData or user-defined out is used in fp"
            ALWAYS              = 0x2, "Aways enable MRT"
        END_ENUM_LIST
    Default: ONLY_ON_DRAWBUFFERS
END_KEY

BEGIN_KEY VK_RAY_LOG_RT_EXCEPTIONS
    DefinedWhen:    1
    BinaryID:       0x3CE314
    RemappedName:   OGL_0x3CE314
    Type:           dword
    Documentation:  "Controls if we log exceptions we get from RTCore in PS_FILE_PATH. Note this changes how we traverse somewhat, so is invasive on how the app runs."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLED   = 0x0, "No logging, default traverser/ABI"
            ENABLED    = 0x1, "Enable logging, force traverser/ABI to UTRAV to enable more checks"
        END_ENUM_LIST
    Default:   DISABLED
END_KEY

