    Values: Bitfields
        BEGIN_ENUM_LIST
            STANDARD                   = 0x00000000, "Default locking"
            LEGACY_BIND_SPARSE_LOCKING = 0x00000001, "Legacy (additional) locking during vkQueueBindSparse execution"
        END_ENUM_LIST
    Default:    STANDARD
