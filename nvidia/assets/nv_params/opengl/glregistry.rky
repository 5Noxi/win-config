    Values:         Samples
        BEGIN_ENUM_LIST
            DISABLE                       = 0x00000000, "Vulkan Queues have their own state."
            ENABLE                        = 0x00000001, "Force Vulkan Queues to share a single state."
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY VK_GETDEVICEPROCADDR_COMPATIBILITY
    DefinedWhen:    1
    BinaryID:       0xbc1a2a
    RemappedName:   OGL_0xbc1a2a
