    BinaryID:       0xf84383
    RemappedName:   OGL_IgnoreInvalidateFramebuffer
    Type:           dword
    Documentation:  "Ignore glInvalidate*Framebuffer calls. Useful for e.g. Unity which invalidates framebuffers without clearing them and ends up with garbage data used for rendering."
    Values:         Samples
        BEGIN_ENUM_LIST
