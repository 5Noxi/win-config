            ENABLE      = 1, "Do invalidate the context after GL_OUT_OF_MEMORY."
        END_ENUM_LIST
    Default:            DISABLE
END_KEY

BEGIN_KEY OGL_MT_FINISH_AFTER_SWAP
    DefinedWhen:    1
    BinaryID:       0x87AF01
    RemappedName:   OGL_8E640CD1
    Type:           dword
    Documentation:  "Controls whether finish is called after swap if multiple threads render to the same drawable."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE    = 0, "Don't call finish after swap."
            ENABLE     = 1, "Call finish after swap."
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_DISALLOW_CE_MASK
    DefinedWhen: 1
    BinaryID:    0x573822
    RemappedName: OGL_DisallowCEMask
    Type:        dword
    Documentation: "Sets a bitmask determining whether async CE (bit 0) or GRCE (bit 1) should be disabled."
    Values: Bitfields
        BEGIN_ENUM_LIST
            ASYNC   =   0x00000001, "Disable the asynchronous CE"
            GR      =   0x00000002, "Disable the CE on the graphics channel"
            ALL     =   ASYNC | GR, "Disable all CE"
        END_ENUM_LIST
    Default: 0
END_KEY

BEGIN_KEY OGL_RINGBUFFER_SETTINGS
    DefinedWhen: 1
    BinaryID: 0x4f4e48
    RemappedName: OGL_4F4E48
    Type:   dword
    Documentation: "Controls various ringbuffer allocation settings."
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_RECREATE       = 0x00000001, "Disable the recreate (orphan/realloc) path"
            DISABLE_HDR_REUSE      = 0x00000002, "Disable reusing ringbuffer allocations on recreate"
            DISABLE_ALL = DISABLE_RECREATE | DISABLE_HDR_REUSE, "Disable all optimizations"
        END_ENUM_LIST
    Default: 0
END_KEY

BEGIN_KEY OGL_SLI_DL_CONTROL
    DefinedWhen: 1
    BinaryID:    0x873922
    RemappedName: OGL_SLI_DLI_CONTROL
    Type:        dword
    Documentation: "Optimise SLI downloads using P2P transfers"
    Values: Bitfields
        BEGIN_ENUM_LIST
            ENABLE      = 0x00000001, "Bit set to use SLI DL optionations"
            PUSH        = 0x00000002, "USE PUSH P2P instead of pull"
            LIMIT_DL    = 0x00000004, "limit download to one subdivce"
            LIMIT_CE    = 0x00000008, "limit CE to use only one engine"
            METH_CE     = 0x00000010, "use copy enigine"
            METH_MASK   = 0x000000F0, "method mask"
            CHUNKS      = 0x00020000, "number of chunks to use"
            WATERFALL   = 0x00000100, "use waterfall copy"
            SKIP_P2P    = 0x00000200, "skip P2P but use rest of algorithm"
            ONE_2_MANY  = 0x00000400, "copy from one GPU to many"
            CHUNKS_MASK = 0x00FF0000, "chunks mask"
            BASE        = WATERFALL | ENABLE | METH_CE, "Enable by default with CE"
        END_ENUM_LIST
    Default: BASE
END_KEY

BEGIN_KEY OGL_BLIT_PREFER_3D_SIZE
    DefinedWhen: 1
    BinaryID:    0x784561
    RemappedName: OGL_784561
    Type:        dword
    Documentation: "Sets a threshold for ReadImage prefering 3D over 2D: If blit size < threshold then prefer 2D else prefer 3D."
    Default: 0x100000
END_KEY

BEGIN_KEY OGL_ROBUSTNESS_BUFFER_WATCHDOG_TIMEOUT
    DefinedWhen:    1
    BinaryID:       0x3d3691
    RemappedName:   OGL_RobustnessBufferWatchdogTimeout
    Type:   dword
    Documentation:  "This setting specfies the timeout value in ms once a buffer will get killed by the reset engine in KMD"
    Values: Samples
        BEGIN_ENUM_LIST
        END_ENUM_LIST
    Default:    1500
END_KEY

BEGIN_KEY OGL_CONFORMANT_BLIT_FRAMEBUFFER_SCISSOR
    DefinedWhen:    1
    BinaryID:       0x6f4c6d
    RemappedName:   OGL_ConformantBlitFramebufferScissor
    Type:           bool
    Documentation:  "Indicates that glBlitFramebuffer should be affected by the scissor test, as per the OpenGL specification"
    Values: Samples
        BEGIN_ENUM_LIST
            NONCONFORMANT       = 0x00000000, "ignore the scissor test"
            CONFORMANT          = 0x00000001, "respect the scissor test"
        END_ENUM_LIST
    Default:        CONFORMANT
END_KEY

BEGIN_KEY OGL_CONFORMANT_INCOMPLETE_TEXTURES
    DefinedWhen:    1
    BinaryID:       0xf107cc
    RemappedName:   OGL_ConformantIncompleteTextures
    Type:           bool
    Documentation:  "Indicates whether incomplete textures should produce (0,0,0,0) matching D3D and our hardware, or (0,0,0,1) as per the OpenGL specification"
    Values: Samples
        BEGIN_ENUM_LIST
            NONCONFORMANT       = 0x00000000, "return (0,0,0,0)"
            CONFORMANT          = 0x00000001, "return (0,0,0,1)"
        END_ENUM_LIST
    Default:        CONFORMANT
END_KEY

BEGIN_KEY OGL_STRICT_DRAW_RANGE_ELEMENTS
    DefinedWhen:    1
    BinaryID:       0xblade5
    RemappedName:   OGL_StrictDrawRangeElements
    Type:           bool
    Documentation:  "Indicates whether all vertices in the bounding range [start, end] passed to glDrawRangeElements are required to be valid.  If true, they may all be compiled in some cases to improve performance, otherwise only those vertices between the greatest and least element index will ever be accessed."
    Values: Samples
        BEGIN_ENUM_LIST
        NONSTRICT_RANGE     = 0x00000000, "all vertices in range need not be valid"
        STRICT_RANGE        = 0x00000001, "all vertices in range must be valid"
    END_ENUM_LIST
    Default:        STRICT_RANGE
END_KEY

BEGIN_KEY OGL_VPIPE_FORMAT_BLOAT_LIMIT
    DefinedWhen:    1
    BinaryID:       0xf10734
    RemappedName:   OGL_VpipeFormatBloatLimit
    Type:           dword
    Documentation:  "Limit the number of attributes vpipe will allow before forcing a vertex format change"
    Default:        3
END_KEY

BEGIN_KEY OGL_SPARSE_TEXTURE
    DefinedWhen: 1
    BinaryID:    0x542675
    RemappedName: OGL_SparseTexture
    Type:        dword
    Documentation: "Sparse texture features"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE                                    =   0x00000000, "Disable all features"
            RESERVED                                =   0x00000001, "Reserved"
            DISABLE_FULL_ARRAY_CUBE_MIPMAPS         =   0x00000002, "Force disable SPARSE_TEXTURE_FULL_ARRAY_CUBE_MIPMAPS_ARB"
            ENABLE_FULL_ARRAY_CUBE_MIPMAPS          =   0x00000004, "Force enable SPARSE_TEXTURE_FULL_ARRAY_CUBE_MIPMAPS_ARB"
            MIPMAP_TAIL_SMALLER_THAN_TILE_SIZE      =   0x00000008, "Start mipmap tail if level size smaller than tile size"
            MIPMAP_TAIL_FULL_ARRAY                  =   0x00000010, "Commit/uncommit mipmap tail for all layers of an texture array"
            TILE_SIZE_128KB_SUPPORTED               =   0x00000020, "Support 128kb tile size on 128kb big pages"
            DISABLE_COMPRESSION                     =   0x00000040, "Disable compression"
            SEPARATE_TILE_POOLS                     =   0x00000080, "Allocate separate tile pools for different formatIds and samples"
            COMPRESS_NON_RT                         =   0x00000100, "Allow compression on non-render targets"
            FORCE_ASSIGN_COMPTAGS_DRIVER_PROTECTION =   0x00000200, "Force assignment of comptags in driver protection (wddm2)"
            BATCH_CONSECUTIVE_VA_UPDATES            =   0x00000400, "Batch consecutive VA updates (wddm2)"
            TEGRA_DEFAULT                           =   0x000000A0, "Default value on Tegra"
