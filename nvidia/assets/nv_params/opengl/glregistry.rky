// Threaded driver optimizations for Quadro, same as below. Make sure the bits match. Use this for Quadro apps.
BEGIN_KEY OGL_THREAD_OPTIMIZATION
    DefinedWhen:        1
    BinaryID:           0x7A8C92
    RemappedName:       OGL_7A8C9649
    Type:               dword
    Documentation:      "Set this to 0 in order to prevent the creation of a suspended worker thread on Quadro"
    Values: Bitfields
        BEGIN_ENUM_LIST
            CACHE_VIEWPORT           = 0x00000001, "Cache calls to glViewport"
            CACHE_GLSL_OBJECTS       = 0x00000002, "Cache calls to glGetUniformLocation and glIsShader"
            CACHE_GL_STATE           = 0x00000004, "Cache calls to glIsEnabled for a subset of state"
            CACHE_MATRIX             = 0x00000008, "Cache calls to glGetFloatv for GL_PROJECTION_MATRIX and GL_MODELVIEW_MATRIX"
            IGNORE_CHECK_FB_STATUS   = 0x00000010, "Ignore calls to glCheckFramebufferStatus"
            MAKE_CURRENT_ASYNC       = 0x00000020, "Don't sync on DrvSetContext and DrvReleaseContext if possible. Ignores return values."
            IGNORE_DLIST_PIXELSTATE_UPDATE= 0x00000040, "Pixel state not updated by display lists do not invalidate app thread pixel state due to callList"
            IGNORE_DLIST_PARTIAL_PRIM= 0x00000080, "No partial begin/ends in display list.  Do not assume calls must be ignored after callList"
            CACHE_GET_RESULTS        = 0x00000100, "Cache calls to certain glGets"
            QUEUE_WINDOW_EVENTS      = 0x00000200, "Queue window events instead of syncing"
            APP_THREAD_GETS          = 0x00000400, "Perform certain glGet* calls in the application thread when the front and back-end threads are already synchronized."
            MODIFY_TIMESTAMP         = 0x00000800, "Return same value for timestamp to defeat bad algorithms that use GL_TIMESTAMP measurements for off swtiches"
            CACHE_DRAW_PIXEL_DATA    = 0x00001000, "Cache large draw pixel data in application thread"
            DISABLE_ALL_OPTIMIZATIONS,DISABLE = 0, "Disable all optimizations"
            ENABLE_ALL               = 0x000001FF, "Enable all threading optimizations"
            QUADRO_DEFAULT           = CACHE_DRAW_PIXEL_DATA | APP_THREAD_GETS,   "Quadro specific default"
            QUADRO_ONLY_BITS         = MAKE_CURRENT_ASYNC | IGNORE_DLIST_PIXELSTATE_UPDATE | IGNORE_DLIST_PARTIAL_PRIM | CACHE_GET_RESULTS | QUEUE_WINDOW_EVENTS | APP_THREAD_GETS | MODIFY_TIMESTAMP | CACHE_DRAW_PIXEL_DATA,   "Bits intended only for Quadro"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

// Threaded driver optimizations for GeForce, same as above. Make sure the bits match. Use this for GeForce apps.
BEGIN_KEY OGL_THREAD_OPTIMIZATION_GEFORCE
    DefinedWhen:        1
    BinaryID:           0x2DC432
    RemappedName:       OGL_2DC432
    Type:               dword
    Documentation:      "Threaded optimizations for GeForce."
    Values: Bitfields
        BEGIN_ENUM_LIST
            CACHE_VIEWPORT           = 0x00000001, "Cache calls to glViewport"
            CACHE_GLSL_OBJECTS       = 0x00000002, "Cache calls to glGetUniformLocation and glIsShader"
            CACHE_GL_STATE           = 0x00000004, "Cache calls to glIsEnabled for a subset of state"
            CACHE_MATRIX             = 0x00000008, "Cache calls to glGetFloatv for GL_PROJECTION_MATRIX and GL_MODELVIEW_MATRIX"
            IGNORE_CHECK_FB_STATUS   = 0x00000010, "Ignore calls to glCheckFramebufferStatus"
            MAKE_CURRENT_ASYNC       = 0x00000020, "Don't sync on DrvSetContext and DrvReleaseContext if possible. Ignores return values."
            IGNORE_DLIST_PIXELSTATE_UPDATE= 0x00000040, "Pixel state not updated by display lists do not invalidate app thread pixel state due to callList"
            IGNORE_DLIST_PARTIAL_PRIM= 0x00000080, "No partial begin/ends in display list.  Do not assume calls must be ignored after callList"
            DISABLE_ALL_OPTIMIZATIONS,DISABLE = 0, "Disable all optimizations"
            ENABLE_ALL               = 0x000000FF, "Enable all threading optimizations"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

