BEGIN_KEY OGL_UNSUPPORTED_COMPRESSED_TEXTURES
    DefinedWhen:    1
    BinaryID:       0x62a81d
    RemappedName:   OGL_62a81d
    Type:           dword
    Documentation:  "Compressed texture settings."
    Values:             Bitfields
        BEGIN_ENUM_LIST
            KEEP_HOSTCOPY_COMPRESSED        = 0x00000001, "Keep texture host copy compressed (required to pass OpenGL CTS for ES 3.2)."
            ADVERTISE_ASTC                  = 0x00000002, "Advertise ASTC LDR extensions."
            ADVERTISE_ASTC_ES_ONLY          = 0x00000004, "Advertise ASTC LDR extensions only on OpenGL ES contexts (required to pass OpenGL CTS for ES 3.2)."
            FORCE_FP16_ASTC                 = 0x00000008, "Use always FP16 texture for ASTC."
            ADVERTISE_ASTC_HDR              = 0x00000010, "Advertise ASTC HDR extension (includes EMULATE_ASTC_HDR)."
            ADVERTISE_ASTC_HDR_ES_ONLY      = 0x00000020, "Advertise ASTC HDR extension only on OpenGL ES contexts (includes EMULATE_ASTC_HDR_ES_ONLY)."
            ADVERTISE_ASTC_HDR_ON_LDR_HW    = 0x00000040, "Advertise ASTC HDR extension on hw which supports ASTC LDR (includes EMULATE_ASTC_HDR_ON_LDR_HW)."
            EMULATE_ASTC_HDR                = 0x00000080, "Emulate ASTC HDR (regardless of advertising extension)."
            EMULATE_ASTC_HDR_ES_ONLY        = 0x00000100, "Emulate ASTC HDR only on OpenGL ES contexts (regardless of advertising extension)."
            EMULATE_ASTC_HDR_ON_LDR_HW      = 0x00000200, "Emulate ASTC HDR on hw which supports ASTC LDR (regardless of advertising extension)."
        END_ENUM_LIST
    Default: KEEP_HOSTCOPY_COMPRESSED | ADVERTISE_ASTC_ES_ONLY | ADVERTISE_ASTC_HDR_ES_ONLY
END_KEY

