BEGIN_KEY OGL_SHADOWPLAY_FLAGS
    DefinedWhen:    1
    BinaryID:       0x5a2b0a
    RemappedName:   OGL_5a2b0a
    Type:           dword
    Documentation:  "Controls OGL/VK Shadowplay behaviour"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            DISABLE_IN_DX_PRESENT          = 0x00000001, "When doing DX present - disable OGL Shadowplay and let DX handle everything"
            USE_2D_OVERLAY                 = 0x00000002, "Use 2D to render overlays"
        END_ENUM_LIST
    // Default disable nvfbc/shadowplay handling when doing DX present
    // DX is better positioned to handle capture then, since don't know enough about vidpn ownership to properly 
    // handle non-PID capture mode
    Default:    DISABLE_IN_DX_PRESENT | USE_2D_OVERLAY
END_KEY

BEGIN_KEY OGL_USE_ONLINE_GENERATED_CODE
    DefinedWhen:        1
    BinaryID:           0x6e68b5
    RemappedName:       OGL_6e68b5
    Type:               dword
    Documentation:      "Enables driver to use online-generated code. Disable it to avoid driver allocating exec memory for example. Note that right now it only works on ARM but not on x86, because some x86 paths don't have fall-back code when OG fails."
    // bug 1866361 tracks the missing x86 support
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLE     = 1, "Enable"
            DISABLE    = 0, "Disable"
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

