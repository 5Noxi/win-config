    DefinedWhen:    1
    BinaryID:           0x348243
    RemappedName:   OGL_CopyBufferMethod
    Type:   dword
    Documentation:  "Selects between P2H2P and CPU memcpy to copy buffer between GPU's"
    Values: Samples
        BEGIN_ENUM_LIST
            P2H2P            = 0, "copy via P2H2P"
            CPU              = 1, "copy via CPU"
            COPY_ENGINE      = 2, "copy via copy engine"
        END_ENUM_LIST
    Default:    P2H2P
END_KEY

BEGIN_KEY OGL_SHADER_MEMORY_ACCESS_BOUNDS_CHECK
    DefinedWhen:    1
    BinaryID:           0x1aa483
    RemappedName:   OGL_0x1aa483
    Type:   dword
    Documentation:  "Control software bounds checking preventing faults on accesses to out-of-bounds or unpopulated buffer memory bindings."
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE_SSBO = 0x1,    "Disable bounds checks on SSBO accesses."
            DISABLE_ATOMCTR = 0x2, "Disable bounds checks on atomic counter accesses."
            DISABLE_UBO = 0x4,     "Disable bounds checks on UBO accesses not using hardware constant buffer bindings."
            DISABLE_ALL = 0x7,     "Disable all software bounds checks."
            CLAMP = 0x8,           "Clamp the coordinate to zero rather than branching over the access."
        END_ENUM_LIST
    Default:    0
END_KEY

BEGIN_KEY OGL_SHADER_KILL_BEHAVIOR
    DefinedWhen:    1
    BinaryID:           0xb0b348
    RemappedName:   OGL_0xb0b348
    Type:   dword
    Documentation:  "Control the behavior of fragment shader KIL instructions."
