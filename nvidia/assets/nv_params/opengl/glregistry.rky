/* The following three reg keys enable and configure a OpenGL Mosaic SFR style clipping
   optimization which is disabled by default.  It has known visual side effect and should
   only be enabled with select applications confirmed to work with this mode.

   The CLIP_FBO setting extends clipping to FBOs that match the current GLS device
   dimensions (e.g. fullscreen) and are assumed to be eventually targeted for display
   as a full screen image.

   The two overlap reg keys provide addition padding in (pixels) to the horizontal
   and vertical clip limits.  By default they are set to zero and OGL rendering is
   clipped to each subdev's visible region.  Positive overlap values can be set to
   increase the clip region and allow for access of FB data beyond the visible area
   (which can occur when warp and blend is enabled).
*/
BEGIN_KEY OGL_SLI_MOSAIC_CLIP_TO_SUBDEV
    DefinedWhen:    1
    BinaryID:           0x0f32d8
    RemappedName:   OGL_MOSAIC_CLIP_TO_SUBDEV
    Type:   dword
    Documentation:  "Enables SLI Mosaic clipping to each sub-device to improve performance"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE  = 0x0, "Disable Setting"
            CLIP_WINDOW = 0x1, "Enable clipping of onscreen windows"
            CLIP_FBO = 0x2, "Enable clipping of desktop size FBOs"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_MOSAIC_CLIP_TO_SUBDEV_H_OVERLAP
    DefinedWhen:    1
    BinaryID:           0x0f32d9
    RemappedName:   OGL_MOSAIC_CLIP_TO_SUBDEV_H_OVERLAP
    Type:   dword
    Documentation:  "Horizontal Overlap when SLI Mosaic clipping to each sub-device is enabled"
    Default:    0
END_KEY

BEGIN_KEY OGL_SLI_MOSAIC_CLIP_TO_SUBDEV_V_OVERLAP
    DefinedWhen:    1
    BinaryID:           0x0f32da
    RemappedName:   OGL_MOSAIC_CLIP_TO_SUBDEV_V_OVERLAP
    Type:   dword
    Documentation:  "Vertical Overlap when SLI Mosaic clipping to each sub-device is enabled"
    Default:    0
END_KEY

/* Selection of default rendering GPU
 *
 * The next group of settings controls the selection of the GPU on which OGL
 * rendering occurrs.
 */

BEGIN_KEY OGL_IMPLICIT_GPU_AFFINITY
    DefinedWhen:    1
    BinaryID:           0xd0f3e6
    RemappedName:   OGL_ImplicitGpuAffinity
    Type:   wstring
    UserVisibleName: "Preferred OpenGL GPU"
    EnvVarName: L"OGL_DEFAULT_RENDERING_GPU"
    OverInstallBehavior: MERGE
    Documentation:  "Controls selection of the default render GPU. Autoselect means the driver chooses based on a heuristic that favors the biggest quadro. This string is set by the control panel and not meant to be set directly by the user. The use of gpu_affinity always overrides the default render GPU."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            AUTOSELECT    = L"autoselect", ""
        END_ENUM_LIST
    Default:    AUTOSELECT
END_KEY

BEGIN_KEY OGL_HDC_AFFINITY
    DefinedWhen:        1
    BinaryID:           0xA84C92
    RemappedName:       OGL_A84C92
    Type:               dword
    Documentation:      "When ON, the default render GPU for same-quadro HW configs is determined by position of the window associated with the HDC passed to SetPixelFormat. When OFF, or when not a same-quadro HW config, the default is determined by OGL_IMPLICIT_GPU_AFFINITY. The use of gpu_affinity always overrides the default. This feature is exposed on vista and newer."
    Values: Samples
        BEGIN_ENUM_LIST
            OFF      = 0, "Use a heuristic to select the default render GPU."
            ON       = 1, "Use HDC-based selection of the default render GPU on supported HW configs."
            FORCE_ON = 2, "Use HDC-based selection of the default render GPU for any HW config."
        END_ENUM_LIST
    Default: ON
END_KEY

BEGIN_KEY OGL_LUID_ADAPTER_SELECTION
    DefinedWhen:        1
    BinaryID:           0x559D55
    RemappedName:       OGL_559D55
    Type:               dword
    EnvVarName: L"GL_NV_RENDER_GPU_LUID"
    Documentation:      "When enabled, allow override of the default rendering GPU via environment\nvariable.  Note that vsync is not guaranteed with this, especially with GPUs\nlacking a display.\n\nThe environment variable must be set as follows:\n\n        GL_NV_RENDER_GPU_LUID=[LowPart] [HighPart]\n\nGiven the LUID of the desired adapter to use for OpenGL rendering, LowPart is an\nunsigned 32-bit integer matching LUID.LowPart and HighPart is a signed 32-bit\ninteger matching LUID.HighPart.  The numbers are separated by a single space.\n\nThe syntax expected for each number matches that accepted by strtol with base\nequal to zero:\n\n    [{+|-}][0[{x|X}]][digits]\n\nThe sign is optional.  Note that the number is assumed decimal unless one of the\nfollowing prefixes are used:\n1. a 0x or 0X prefix indicates a hexadecimal number.\n2. a 0-prefix indicates an octal number (so don't zero pad if using decimal)."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE         = 0x00000000, "Ignore environment variable"
            ENABLE          = 0x00000001, "Respect environment variable"
        END_ENUM_LIST
    Default: ENABLE
END_KEY

BEGIN_KEY OGL_OVERRIDE_DEFAULT_RENDERING_GPU
    DefinedWhen:    1
    BinaryID:       0xe19453
    RemappedName:   OGL_7598305892
    Type:           dword
    Documentation:  "Override the default render GPU. The value is a zero-based index in the EnumDisplayDevices iteration space (same index as global {gls,win}device array). Affects both win7 and winxp-MMB."
    Values: Samples
        BEGIN_ENUM_LIST
            OFF     = 0xffffffff, "do not override"
            PRIMARY = 0xfffffffe, "use primary display GPU for rendering"
        END_ENUM_LIST
    Default:        OFF
END_KEY

BEGIN_KEY OGL_ENUM_ADAPTERS_CONFIG
    DefinedWhen:    1
    BinaryID:       0x28fc66
    RemappedName:   OGL_4324108480
    Type:   dword
    Documentation:  "Configure adapter enumeration.  By default, OpenAdapterFromDeviceName is tried before OpenAdapterFromLocationInformation."
    Values: Samples
       BEGIN_ENUM_LIST
            TRY_ALL                                     = 0x00000000, "try all until one succeeds or all fail"
            SKIP_TRY_OpenAdapterFromDeviceName          = 0x00000001, "do not try OpenAdapterFromDeviceName"
            SKIP_TRY_OpenAdapterFromLocationInformation = 0x00000002, "do not try OpenAdapterFromLocationInformation"
        END_ENUM_LIST
    Default: TRY_ALL
END_KEY

/*
 * End of section controlling selection of rendering GPU.
 */

