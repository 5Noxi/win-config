    DefinedWhen:        1
    BinaryID:           0x915e56
    RemappedName:       OGL_915e56
    Type:               dword
    Documentation:      "Toggles our on screen display information, with VSYNC, FLIP and MMB."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE     = 0, "Disable the on-screen display information"
            ENABLE      = 1, "Enable the on-screen display information"
            ENABLE_USER = 2, "Display the user facing information only"
        END_ENUM_LIST
    Default:            DISABLE
END_KEY

BEGIN_KEY OGL_CLEAR_DATA_STORE_VIDMEM
    DefinedWhen:        1
    BinaryID:           0x696a61
    RemappedName:       OGL_ClearDataStoreVidmem
    Type:               dword
    Documentation:      "Clear video memory allocations that may be used as part of a buffer object's data store."
    Values: Samples
        BEGIN_ENUM_LIST
            ENABLE     = 1, "Enable vidmem data store clears"
            DISABLE    = 0, "Disable vidmem data store clears"
        END_ENUM_LIST
    Default:            DISABLE
END_KEY

BEGIN_KEY OGL_RECOVER_FROM_CG_OOM
    DefinedWhen:        1
    BinaryID:           0xf00f19
    RemappedName:       OGL_F00F1938
    Type:               dword
    Documentation:      "Controls whether we enable code which allows the driver to recover from certain GLSL compiler failures without crashing. This code may affect driver stability."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE    = 0, "Disable compiler recovery code."
            ENABLE     = 1, "Enable compiler recovery code."
        END_ENUM_LIST
    Default:           ENABLE
END_KEY

BEGIN_KEY OGL_INVALIDATE_CONTEXT_ON_OOM
    DefinedWhen:        1
    BinaryID:           0x616627
    RemappedName:       OGL_616627AA
    Type:               dword
    Documentation:      "Controls whether a GL_OUT_OF_MEMORY error will invalidate use of the corresponding OpenGL context."
    Values: Samples
        BEGIN_ENUM_LIST
