    DefinedWhen:    1
    BinaryID:       0xc0def5
    RemappedName:   OGL_0xc0def5
    Type:           float
    Documentation:  "Minimum percentage of validation attempts that must fail before optimization is aborted and tracking begins again"
    Default: 0.5f
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_MIN_UNIFORM_COUNT
    DefinedWhen:    1
    BinaryID:       0xc0def6
    RemappedName:   OGL_0xc0def6
    Type:           dword
    Documentation:  "Minimum number of uniforms a shader must have for it to be analyzed for optimization"
    Default: 8
END_KEY

BEGIN_KEY VK_CONSTANT_FOLDING_VALIDATION_FAILURE_DECAY_RATE
    DefinedWhen:    1
    BinaryID:       0xc0defa
    RemappedName:   OGL_0xc0defa
    Type:           float
    Documentation:  "Exponential decay rate for constant folding validation failure tracking. The validation failure rate is tracked across multiple frames; set this closer to 1 to require validation to fail over more frames before bailing on the optimization."
    Default: 0.85f
END_KEY

/* GPU family based enablement for constant folding. Default to GP10x+ since we can use single-node SCG there */
BEGIN_KEY VK_CONSTANT_FOLDING_ARCH
    DefinedWhen:    1
    BinaryID:       0xc0defb
    RemappedName:   OGL_0xc0defb
    Type:           dword
    Documentation:  "Mask controlling enablement of constant folding based on GPU family"
    Values: Bitfields
        BEGIN_ENUM_LIST
            GP10X          =    0x00000001, "Enable constant folding for GP10X+"
            TU10X          =    0x00000002, "Enable constant folding for TU10X+"
            ALL            =    0xffffffff, "Enable constant folding on all gpus"
        END_ENUM_LIST
    Default:    GP10X
END_KEY

BEGIN_KEY VK_COPY_QUERY_POOL_PREFETCH_SYNC
    DefinedWhen:    1
    BinaryID:       0xc0def7
    RemappedName:   OGL_0xc0def7
