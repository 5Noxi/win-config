            NONE                     = 0x00000000, "No WAR, all allocations are writable (poor perf possible)."
            DUMMY_UNICAST_RENDER     = 0x00000001, "Submit unicast no-op renders in SwapFlip for bug 922865."
            READONLY_SCANOUT_SURF    = 0x00000002, "Set scanout allocations read-only for bug 416652 (corruption possible). Forced on Vista."
        END_ENUM_LIST
