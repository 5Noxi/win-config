        BEGIN_ENUM_LIST
            ENABLE     = 1, "Enable the small block heap allocator"
            DISABLE    = 0, "Disable the small block heap allocator, use the CRT default heap"
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

