            ENABLE  = 0x01, "enable addition split line indicator info"
            SPLIT_SLIAA = 0x02, "only sliaa blend top half of window (vista p2h2p only)"
            AFR_DISPLAY = 0x04, "enable afr visible/render gpu/buffer printout"
            AA_DISPLAY  = 0x08, "enable aa mode and aniso filter level printout"
            RESOLUTION_DISPLAY  = 0x10, "enable window resolution printout"
            AFR_HISTORY = 0x20, "enable afrGpu history chart"
            P2P_CONNECTIVITY = 0x40, "enable P2P info"
            LOAD_INDICATOR  = 0x10000, "enable a scaling accurate load indicator for n-way AFR"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_MULTICAST
    DefinedWhen:    1
    BinaryID:           0x92d3be
    RemappedName:   OGL_19322299
    Type:   dword
    UserVisibleName: "Enable NV_gpu_multicast extension"
    Documentation:  "Controls whether NV_gpu_multicast operation is supported or not"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE = 0x00, "disable multicast"
            ENABLE  = 0x01, "enable multicast (overrides afr/sfr)"
            FORCE_DISABLE = 0x02, "disable multicast (overrides environment variable)"
            ALLOW_MOSAIC = 0x04, "allow multicast + mosaic (requires enable bit or env var)"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_CFR_MODE
    DefinedWhen:    1
    BinaryID:           0x343843
    RemappedName:   OGL_4585349
    Type:   dword
    UserVisibleName: "Set CFR mode"
    Documentation:  "Controls CFR modes and options"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE = 0x00, "disable CFR"
            ENABLE = 0x01, "enable CFR"
            CLASSIC_SFR = 0x02, "enable classic split line SFR"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_CFR_DEBUG
    DefinedWhen:    1
    BinaryID:           0x343844
    RemappedName:   OGL_4585350
    Type:   dword
    Documentation:  ""
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE = 0x00, "clear all debug bits"
            INDICATOR_GPU_RECT      = 0x01, "display render gpu and clip rect id in indicator"
            ENABLE_ALL_GPUS         = 0x02, "enable CFR on all GPU's, not just Turing and above"
            SKIP_PRESENT_RESOLVE    = 0x04, "skip secondary to primary blit on present"
            SKIP_REMOTE_MAPPING     = 0x08, "skip setting up remote GPU VA mapping"
            DISABLE_FBO_CFR         = 0x10, "disable CFR processing of FBO's"
            DISABLE_FBO_SYNC        = 0x20, "disable present resolve and fbo lock/unlock sync'ing"
            DISABLE_PRESENT_SYNC    = 0x40,"disable present resolve and fbo lock/unlock sync'ing"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_TEST
    DefinedWhen:    1
    BinaryID:           0x39fb2c
    RemappedName:   OGL_38764295
    Type:   dword
    Documentation:  ""
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLE = 0x00, "disable all debug support modes"
            DISABLE_HW_SLIAA    = 0x01, "disable hw blend scanout, force p2p or p2h2p blend path"
            FORCE_P2H2P = 0x02, "force p2h2p path (disable p2p, must also set disable_hw_sliaa)"
            FORCE_BRIDGELESS_WAFR   = 0x04, "force use of the WAFR path, even in fullscreen"
            DISABLE_VIDEO_BRIDGE    = 0x08, "disable video bridge even if it exists"
            P2H2P_SYSMEM    = 0x10, "if p2h2p then use sysmem staging buffer instead of vidmem"
            BRIDGE_INCAPABLE = 0x20, "act as if the video bridge does not support the current mode (e.g. 4k)"
            FORCE_DISABLE_WDDM2_AFR = 0x40, "disable AFR on WDDM2"
            FORCE_DISABLE_WDDM2_P2P = 0x80, "disable P2P support on WDDM2"
            FORCE_DISABLE_WDDM2_MOSAIC = 0x100, "disable SLI Mosaic and Surroud on WDDM2"
            FORCE_DISABLE_WDDM2_SLIAA = 0x200, "disable SLIAA on WDDM2"
            FORCE_DISABLE_WDDM2_SURROUND_AFR = 0x400, "disable surround + AFR on WDDM2"
            FORCE_DISABLE_WDDM2_ASYNC_BLIT = 0x800, "disable async blit on WDDM2"
        END_ENUM_LIST
    Default:    DISABLE
END_KEY

BEGIN_KEY OGL_SLI_ASYNC_P2P_MODE
    DefinedWhen:    1
    BinaryID:           0x81e3f1
    RemappedName:   OGL_92920143
    Type:   dword
    Documentation:  "Controls mode used for Async P2P transfers"
    Values: Samples
        BEGIN_ENUM_LIST
            GRCE_READ = 0x0, "Use GRCE reads for Async P2P transfers (safe default)"
            2D_READ = 0x1, "Use 2D reads for Async P2P transfers (doesn't support NVLINK)"
            // ASYNCBLIT modes are capable of copying dependencies to a GPU for frame i while that
            // GPU is still working on frame i-N (for N-way SLI).  If that GPU is still using the
            // frame i-N version of the resource this could cause corruption.  To avoid this,
            // ASYNCBLIT modes should not be used for appications that can have > N frames in
            // flight, unless the driver is modified to limit pre-rendered frames appropriately.
            ASYNCBLIT_READ = 0x2, "Use ASYNCBLIT reads for Async P2P transfers"
            ASYNCBLIT_WRITE = 0x3, "Use ASYNCBLIT writes for Async P2P transfers"
            ASYNCBLIT_SECONDARY_READ = 0x4, "Use ASYNCBLIT reads on secondary GPUs, GRCE on primary"
            ASYNCBLIT_SECONDARY_ALWAYS = 0x5, "Always use secondary ASYNCBLIT read/write"
            ASYNCBLIT_FASTEST = 0x6, "Pick the fastest mode based on the SLI mode"
        END_ENUM_LIST
    Default:    GRCE_READ
END_KEY

