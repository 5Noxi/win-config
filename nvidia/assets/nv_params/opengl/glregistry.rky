    BinaryID:           0xfa572b
    RemappedName:   OGL_TexturePrecache
    Type:   dword
    Documentation:  ""
    Values: Samples
        BEGIN_ENUM_LIST
        END_ENUM_LIST
    Default:    1
END_KEY

