BEGIN_KEY OGL_DRR_YIELD_POLICY
    DefinedWhen:    1
    BinaryID:       0x420bd4
    RemappedName:   OGL_420bd4
    Type:   dword
    Documentation:  "This is the policy for __glNVDelayRegisterReads to change how we yield/sleep for perf/power tuning"
    Values: Samples
        BEGIN_ENUM_LIST
            WAIT_FOR_GPU         = 0, "Yield with the WAIT_FOR_GPU hint"
            SLEEP_INCREASING_TIME = 1, "Delay (via yield hint) for at first a short time each iteration, than longer"
        END_ENUM_LIST
    Default:    SLEEP_INCREASING_TIME
END_KEY

BEGIN_KEY OGL_DRR_LONG_SLEEP_START_TIME_US
    DefinedWhen:    1
    BinaryID:       0x959b1f
    RemappedName:   OGL_959b1f
    Type:           dword
