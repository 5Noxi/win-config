            USAGE_TRANSFER_DST             = 0x00000002, "VK_IMAGE_USAGE_TRANSFER_DST_BIT"
            USAGE_SAMPLED                  = 0x00000004, "VK_IMAGE_USAGE_SAMPLED_BIT"
            USAGE_STORAGE                  = 0x00000008, "VK_IMAGE_USAGE_STORAGE_BIT"
            USAGE_COLOR_ATTACHMENT         = 0x00000010, "VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT"
            USAGE_DEPTH_STENCIL_ATTACHMENT = 0x00000020, "VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT"
            USAGE_TRANSIENT_ATTACHMENT     = 0x00000040, "VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT"
            USAGE_INPUT_ATTACHMENT         = 0x00000080, "VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT"
            ALWAYS                         = 0xFFFFFFFF, "Always compressed"
