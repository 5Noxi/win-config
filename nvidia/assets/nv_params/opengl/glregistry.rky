// Affects driver teardown behavior when (lpReserved != NULL), which indicates
// that one or more thread may have been terminated prior to
// PROCESS_DETACH. In this case attempting to clean up has undefined results,
// including the possibility of a hang or a crash.
//
// When ExitProcess is called, threads may have been terminated (not exited
// cleanly), and therefore the process may be in an inconsistent state. E.g.,
// a thread may have been terminated while it owned a critical resource. In
// one case it was observed that cleaning up FBOs can fail if the thread
// associated with the dummy window was already terminated (taking the dummy
// window with it).
//
// Setting this key to ENABLED forces execution of teardown code during
// PROCESS_DETACH enven though Microsoft advises not to do that. It's really
// so we can run nvdbgMemReport. See http://nvbugs/498985
//
// For reference, see also:
//   http://msdn.microsoft.com/en-us/library/ms682583.aspx
//   http://blogs.msdn.com/oldnewthing/archive/2007/05/03/2383346.aspx
//
BEGIN_KEY OGL_FORCE_EXIT_PROCESS_DETACH
    DefinedWhen:    1
    BinaryID:           0xfbf134
    RemappedName:   OGL_ForceExitProcessDetach
    Type:   dword
    Documentation:  "Affects driver teardown behavior when (lpReserved != NULL), which\nindicates that one or more thread may have been terminated prior to\nPROCESS_DETACH. In this case attempting to clean up has undefined\nresults, including the possibility of a hang or a crash."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLED = 0x00000000, "Don't attempt process teardown if lpReserved != NULL, unless CycleStats is enabled"
            ENABLED  = 0x00000001, "Attempt process teardown"
            NEVER    = 0x00000002,   "Never call teardown process"
        END_ENUM_LIST
    Default:    DISABLED
END_KEY


BEGIN_KEY OGL_IGNORE_WINDOW_DESTROY_DURING_DETACH
    DefinedWhen:    1
    BinaryID:       0x5e09fa
    RemappedName:   OGL_IgnoreWindowDestroyDuringDetach
    Type:   dword
    Documentation:  "Ignore window destroy while threads are being detached. Resolves potential deadlocks."
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLED = 0x00000000, "Normal processing during thread detach"
            THREAD   = 0x00000001, "Ignore destroy during thread detach"
            PROCESS  = 0x00000002, "Ingore destroy during process detach"
        END_ENUM_LIST
    Default:    DISABLED
END_KEY

