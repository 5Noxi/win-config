            DISABLED                = 0,    "Use traditional NV2080_CTRL_CMD_PERF_SET_MODE"
            ENABLED                 = 1,    "Use modern boost rmctrl NV2080_CTRL_CMD_PERF_BOOST (2s boost)"
        END_ENUM_LIST
    Default: ENABLED
