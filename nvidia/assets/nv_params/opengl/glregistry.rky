            FORCE_FP16_ASTC                 = 0x00000002, "Use always FP16 texture for ASTC."
            ADVERTISE_ASTC_HDR              = 0x00000004, "Advertise ASTC HDR."
        END_ENUM_LIST
    Default: 0
END_KEY

