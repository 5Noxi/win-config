    Values:         Samples
        BEGIN_ENUM_LIST
            ENABLE                  = 1,      "Enable deferred downsampling/upsampling behavior"
            DISABLE                 = 0,      "Disable deferred downsampling/upsampling behavior"
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

BEGIN_KEY VK_DIRECT_GSYNC_COMPATIBLE_MODE
    BinaryID:       0xda2053
    RemappedName:   OGL_0xda2053
    Type:           dword
    Documentation:  "Control whether G-SYNC Compatible monitors enable VRR at modeset time for Vulkan direct-to-display"
    Values:         Samples
        BEGIN_ENUM_LIST
            DISABLED                = 0,      "Disable VRR on all G-SYNC Compatible monitors"
            ALLOWLISTED_ONLY        = 1,      "Enable VRR only on Allowlisted G-SYNC Compatible monitors"
            ENABLED                 = 2,      "Enable VRR on Allowlisted and non-validated G-SYNC Compatible monitors"
        END_ENUM_LIST
