END_KEY

// Threshold size to allow link-instanced allocations for shared allocations (used for DX present) with SLI.
// Otherwise force the link-mirrored paging scheme to WAR virtual address space exhaustion issue, found in bug
// 1423307.  Defaults to off to avoid corruption.  Only applies to shared render target allocations in 32-bit
// applications.
BEGIN_KEY OGL_LDDM_SLI_SHARED_LINKINSTANCED_LIMIT
    DefinedWhen:    1
    BinaryID:           0x83a938
    RemappedName:   OGL_92920192
    Type:   dword
    Documentation:  "Limit in MB <= which we allow shared render targets to use the link-instanced SLI allocation scheme."
    Values: Samples
        BEGIN_ENUM_LIST
            NO_LIMIT   = 0xFFFFFFFF, ""
        END_ENUM_LIST
    Default:    NO_LIMIT
END_KEY

BEGIN_KEY OGL_LDDM_ASYNC_BLIT_STATE_LIMIT
    DefinedWhen:    1
    BinaryID:           0xbd092b
    RemappedName:   OGL_bd092b
    Type:   dword
    Documentation:  "Threshold of allocated state handles where we allow async blit to be initialized."
    Values: Samples
        BEGIN_ENUM_LIST
            NO_LIMIT   = 0xFFFFFFFF, ""
            // Allow ASYNC BLIT context creation on what amounts to the first two devices. 
            // It prevents waste and StateAllocHandleIndex failures in Vulkan CTS max_concurrent.device.
            TWENTY     = 0x00000014, "Allow async blit when there are <= 20 state handles."
        END_ENUM_LIST
    Default:    TWENTY
END_KEY

