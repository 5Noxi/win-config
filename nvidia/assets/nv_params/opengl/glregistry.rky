/*
 *  This key is set to
 *  - ENABLE to promote the primary and the DP scanout to 10bpc when a 10bpc
 *    application launches.
 *    Additionally, on Vista this causes 10bpc pixelformats to be exported without
 *    SUPPORTS_COMPOSITION, which disables DWM because the DX9 driver used on
 *    Vista for DWM doesn't support 10bpc scanout (the DX10/11 driver used for DWM
 *    on Win7/Win8 does support 10bpc scanout).
 *
 *  - DISABLE causes not to promote the primary and the DP scanout to 10bpc.
 *    - On Vista the rendering is then downgraded to 8bpc at present time. This
 *      allows to leave DWM enabled at the expense of not scanning out 10bpc
 *      (DWM on Vista doesn't support 10bpc scanout).
 *    - On Win7/8 the rendering is downgraded to 8bpc at scanout time (DWM enabled)
 *      or at present time (DWM disabled).
 *
 */
BEGIN_KEY OGL_DEEP_COLOR_SCANOUT
    DefinedWhen:    1
    BinaryID:           0x97c2f6
    RemappedName:   OGL_DeepColorScanout
    Type:   dword
    UserVisibleName: "Deep color for 3D applications"
    OverInstallBehavior: MERGE
    Documentation:  ""
    Values: Samples
        BEGIN_ENUM_LIST
            DISABLE = 0, "Disable 10bpc displayport scanout when a 10bpc application launches, this causes the 10bpc rendering to be downgraded at present or scanout time, but keeps DWM enabled on Vista (this is irrelevant to Win7, because DWM supports 10bpc scanout on win7)"
            ENABLE  = 1, "Enable 10bpc displayport scanout when a 10bpc application launches. This causes DWM to be disabled on Vista, but not on Win7."
        END_ENUM_LIST
    Default:    ENABLE
END_KEY

