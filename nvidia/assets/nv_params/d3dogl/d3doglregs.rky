BEGIN_KEY FERMI_SET_L2_CACHE_CONTROL
    DefinedWhen:    PERF_STRATEGY_REGKEYS
    BinaryID:       0x1fd3
    Type:           dword
    Documentation:  "Each nibble controls the L2 cache policy for particular operations on the VAF and ROP clients. Starting Ada+ the ROP bits of this regkey maybe overidden by the CROP_L2_CACHE_CONTROL and/or ZROP_L2_CACHE_CONTROL regkeys"
    Values: Bitfields
    BEGIN_ENUM_LIST
        VAF_EVICT_FIRST                                                             = 0x00000000, ""
        VAF_EVICT_NORMAL                                                            = 0x00000001, ""
        VAF_EVICT_LAST                                                              = 0x00000002, ""
        VAF_SHIFT                                                                   = 0, ""
        ROP_NONINTERLOCKED_READ_EVICT_FIRST                                         = 0x00000000, ""
        ROP_NONINTERLOCKED_READ_EVICT_NORMAL                                        = 0x00000010, ""
        ROP_NONINTERLOCKED_READ_EVICT_LAST                                          = 0x00000020, ""
        ROP_NONINTERLOCKED_READ_SHIFT                                               = 4, ""
        ROP_INTERLOCKED_READ_EVICT_FIRST                                            = 0x00000000, ""
        ROP_INTERLOCKED_READ_EVICT_NORMAL                                           = 0x00000100, ""
        ROP_INTERLOCKED_READ_EVICT_LAST                                             = 0x00000200, ""
        ROP_INTERLOCKED_READ_SHIFT                                                  = 8, ""
        ROP_PREFETCH_READ_EVICT_FIRST                                               = 0x00000000, ""
        ROP_PREFETCH_READ_EVICT_NORMAL                                              = 0x00001000, ""
        ROP_PREFETCH_READ_EVICT_LAST                                                = 0x00002000, ""
        ROP_PREFETCH_READ_SHIFT                                                     = 12, ""
        ROP_NONINTERLOCKED_WRITE_EVICT_FIRST                                        = 0x00000000, ""
        ROP_NONINTERLOCKED_WRITE_EVICT_NORMAL                                       = 0x00010000, ""
        ROP_NONINTERLOCKED_WRITE_EVICT_LAST                                         = 0x00020000, ""
        ROP_NONINTERLOCKED_WRITE_SHIFT                                              = 16, ""
        ROP_INTERLOCKED_WRITE_EVICT_FIRST                                           = 0x00000000, ""
        ROP_INTERLOCKED_WRITE_EVICT_NORMAL                                          = 0x00100000, ""
        ROP_INTERLOCKED_WRITE_EVICT_LAST                                            = 0x00200000, ""
        ROP_INTERLOCKED_WRITE_SHIFT                                                 = 20, ""
        CLASS_DEFAULT                                                               = 0x00101001, ""
        DX10_DEFAULT                                                                = 0x00001000, ""
        OGL_DEFAULT                                                                 = 0x00111111, "OGL default for perf, see bugs 589224 and 1163844"
    END_ENUM_LIST
    Default:        CLASS_DEFAULT
END_KEY

