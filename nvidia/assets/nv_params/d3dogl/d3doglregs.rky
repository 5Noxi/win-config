    Documentation:      "RTcore profiling buffer allocation size. Defaults to 4MiB."
    Default:            4194304
END_KEY

BEGIN_KEY RTCORE_PROFILING_DUMP_MODE
    DefinedWhen:        defined(DEBUG) || defined(DEVELOP)
    BinaryID:           0xbda13e
    RemappedName:       D3D_0xbda13e
    Type:               dword
    Documentation:      "Specify how frequently profiling data is written to file."
    Values: Bitfields
        BEGIN_ENUM_LIST
            CONTINUOUS  = 0x00000000, "Continuously dump to file"
            HOTKEY      = 0x00000001, "Trigger profile dump using a hotkey (Can be changed with RTCORE_PROFILING_DUMP_HOTKEY)"
        END_ENUM_LIST
    Default: CONTINUOUS
END_KEY

