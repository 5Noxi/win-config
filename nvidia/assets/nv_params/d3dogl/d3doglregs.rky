            ON,  1, TRUE,  REQUEST_ENABLED   = 1, "Request Enable"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY D3DOGL_SANDBAG_DEVICEID
    DefinedWhen:    1
    BinaryID:       0x054eeb
    RemappedName:   OGL_0x054eeb
    Type:           dword
    Documentation:  "Treat given devId as being part of the sandbag devId list.  All follow-on allow/deny mechanisms still apply.  Intended to test new sandbag allow/deny mechanisms on any GPU."
    Values:         Samples
        BEGIN_ENUM_LIST
            DEVID_MASK              = 0x00ffffff, "mask for devId to be sandbagged"
            DEVID_ANY               = 0x00ffffff, "use this pseudo devId to sandbag all devIds"
            IGNORE_ALLOW_LIST       = 0x01000000, "If devId is sandbagged by this key, then it controls whether allowlist should be ignored."
        END_ENUM_LIST
    Default: 0
END_KEY

BEGIN_KEY D3DOGL_UNSANDBAG_VIEWPERF
    DefinedWhen:    1
    BinaryID:       0x749c79
    RemappedName:   OGL_0x749c79
    Type:           dword
    Documentation:  "Unsandbag Viewperf."
    Values:         Samples
        BEGIN_ENUM_LIST
            DISABLE = 0,          "No special handling for Viewperf."
            ENABLE  = 0xe25aba79, "unsandbag Viewperf"
        END_ENUM_LIST
    Default: DISABLE
END_KEY

BEGIN_KEY WKS_DISPLAY_REARRANGEMENT_WITHIN16K
    DefinedWhen:        1
    BinaryID:           0xd91a4c
    RemappedName:       D3DOGL_DisplayRearrangement
    Type:               dword
    UserVisible
    UserVisibleName:    "Control Display Rearrangement"
    NvInternalSetting
    Documentation:      "Displays rearrangement when crossed overall 16K resolution limit enabled or not"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF                  = 0x0, "Displays rearrangement off"
            ON                   = 0x1, "Display rearrangement on"
        END_ENUM_LIST
    Default:            ON
END_KEY

BEGIN_KEY D3DOGL_DEFAULT_SHADER_DISK_CACHE_LOCATION
    DefinedWhen:    1
    BinaryID:       0xc9d12c
    RemappedName:   OGL_c9d12c
    Type:           dword
    Documentation:  "Control where OGL driver should store the shader disk cache files"
    Values:         Bitfields
        BEGIN_ENUM_LIST
            AUTOSELECT                    = 0x00000000, "Let driver decide the shader cache location based on process integrity levels"
            LOCAL                         = 0x00000001, "Force to use LOCAL folder (only for debug and make sure untrusty process cannot create cache)"
            LOCAL_LOW                     = 0x00000002, "Force to use LOCALLOW folder (only for debug and make sure trusty process can still create cache)"
        END_ENUM_LIST
    Default:    AUTOSELECT
END_KEY
