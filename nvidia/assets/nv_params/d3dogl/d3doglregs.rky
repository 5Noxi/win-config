BEGIN_KEY PS_ALPHABETA
    DefinedWhen:        1
    BinaryID:           0x6044ce
    RemappedName:       D3DOGL_39867584
    Type:               dword
    Documentation:      "Set the behavior for Alpha/Beta performance strategy (static or dynamic)"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            STATIC         = 0x00000000, "The driver always uses Alpha fraction set via PS_ALPHABETA_FRACTION regkey"
            DYNAMIC_SHADER = 0x00000001, "The driver adjusts a shader unique Alpha fraction via AlphaBeta clocks" 
            DYNAMIC_VBIB   = 0x00000002, "The driver adjusts a vb/ib ID unique Alpha fraction via AlphaBeta clocks"
        END_ENUM_LIST
    Default:            STATIC
END_KEY

