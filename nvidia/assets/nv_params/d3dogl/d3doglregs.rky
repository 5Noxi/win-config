BEGIN_KEY QMD_OCC_THRESHOLD_NON_RT
    DefinedWhen:        1
    BinaryID:           0x1b1045
    RemappedName:       D3DOGL_0x1b1045
    Type:               dword
    Documentation:      "Set Occupancy fields in the QMD to program the Low Occupancy Watermark for each resource.  GA10x+ SMSCC feature. See http://nvbugs/2509750 for further details and FD link.  Regkey has 8 bits each for warp threshold, RF threshold, and ShM threshold respectively (ShM being the LSB).  Clamped to 128 by HW. Overrides default regkeys set for sync/async compute work"
    Default:            0xF0F00
END_KEY

BEGIN_KEY QMD_OCC_MAX_NON_RT
    DefinedWhen:        1
    BinaryID:           0x1c1045
    RemappedName:       D3DOGL_0x1c1045
    Type:               dword
    Documentation:      "Set Occupancy fields in the QMD to program the High Occupancy Watermark for resources.  GA10x+ SMSCC feature. See http://nvbugs/2509750 for further details and FD link.  Regkey has 8 bits each for warp threshold, RF threshold, and ShM threshold respectively (ShM being the LSB).  Clamped to 128 by HW. Overrides default regkeys set for sync/async compute work"
    Default:            0xFFFFFF
END_KEY

