        END_ENUM_LIST
    Default: 100
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_CPU_RENDER_MARGIN
    DefinedWhen:    1
    BinaryID:       0x83500b
    RemappedName:   D3DOGL_00008623
    Type:           dword
    Documentation:  "Reflex's CPU Render Thread Bound Optimization settings."
    Values: Bitfields
        BEGIN_ENUM_LIST
            MASK_US                     = 0x000003ff, "Mask for margin in microseconds"
            EXCLUDE_OVERLAP             = 0x10000000, "Exclude overlap between sim and render"
            TEST_ENABLE                 = 0x08000000, "Enable test mode"
        END_ENUM_LIST
    Default: 0x0000012c
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_RTBO_TARGET
    DefinedWhen:    1
    BinaryID:       0x83501d
    RemappedName:   D3DOGL_00008645
    Type:           dword
    Documentation:  "Render Thread Bound Optimization (RTBO) target gap time in microseconds."
    Default:        100
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_SMALL_BUFFER_BLEND_FACTOR
    DefinedWhen:    1
    BinaryID:       0x83501c
    RemappedName:   D3DOGL_00008644
    Type:           dword
    Documentation:  "Overlap calculations take average of first trivial buffer and first significant buffer. 0 == large buffer only and 100 == small buffer only.  Value is a percentage from 0 to 100 because app profiles do not support floats."
    Default:        0
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_USE_PRESENT_MARKER_OVERLAP
    DefinedWhen:    1
    BinaryID:       0x835ffc
    RemappedName:   D3DOGL_0000aa44
    Type:           dword
    Documentation:  "Calculate overlap with the lesser of the first submit timestamp and the present marker timestamp.  Helpful for apps that only have one buffer at present time blocked by the OS."
    Values: Samples:LimitValuesToList
       BEGIN_ENUM_LIST
           DISABLED, OFF, 0, FALSE  = 0x0, "Do not consider present markers."
           ENABLED, ON,  1, TRUE   = 0x1, "Use present marker when it comes before 3d submit."
       END_ENUM_LIST
    Default:            DISABLED
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_MAX_SLEEP_PCT
    DefinedWhen:    1
    BinaryID:       0x83501e
    RemappedName:   D3DOGL_00008646
    Type:           dword
    Documentation:  "Maximum percentage of sleep for Reflex. 0 == just spinloop and 100 == no limit"
    Default:        48
END_KEY

BEGIN_KEY PS_FRAMERATE_LIMITER_2_CONTROL
    DefinedWhen:    1
    BinaryID:       0x834fff
    RemappedName:   D3DOGL_00008602
    Type:           dword
    UserVisible
    NvInternalSetting
    UserVisibleName:    "Frame Rate Limiter 2 Control"
    Documentation:  "Framerate Limiter 2 controls (deprecated)"
    Values: Bitfields
       BEGIN_ENUM_LIST
            DELAY_CE                    = 0x00000000, "Always block CE"
            DELAY_3D                    = 0x00000001, "Always block 3D"
            AVOID_NOOP                  = 0x00000002, "Avoid the noop buffer. Block CE when CE is used and 3D when 3D is used"
            DELAY_CE_PRESENT_3D         = 0x00000008, "For All, FRL delay buffer on CE And For discrete, Present on 3D"
            ALLOW_ALL_MAXWELL           = 0x00000010, "Do not restrict to Maxwell_b, but allow on all maxwell chips"
            ALLOW_ALL                   = 0x00000020, "Allow on all chips"
            FORCE_OFF                   = 0x00000040, "Force off on all chips"
            ENABLE_VCE                  = 0x00000080, "Delay on Virtual CE node if DELAY_CE is set for Mshybrid"
            DEFAULT_FOR_GM10X           = 0x00000011, "Default setting for GM10X"
       END_ENUM_LIST
    Default: ENABLE_VCE | DELAY_CE_PRESENT_3D
END_KEY

BEGIN_KEY PS_FRAMERATE_LIMITER
    DefinedWhen:    1
    BinaryID:       0x834fee
    RemappedName:   D3DOGL_00008600
    Type:           dword
    UserVisible
    NvInternalSetting
    UserVisibleName:    "Frame Rate Limiter"
    Documentation:  "Framerate Limiter parameters, bit 31 to enable and LOWBYTE set to frames/sec"
    Values: Bitfields
       BEGIN_ENUM_LIST
            DISABLED                    = 0x00000000, "Disabled"
            FPS_20                      = 0x00000014, "Framerate set to 20 frames per sec"
            FPS_30                      = 0x0000001e, "Framerate set to 30 frames per sec"
            FPS_40                      = 0x00000028, "Framerate set to 40 frames per sec"
            FPSMASK                     = 0x000003ff, "Frames per sec mask"
            ALLOW_DYNAMIC               = 0x00001000, "Allow limit to be set dynamically"
            YIELD_PROCESSOR             = 0x00002000, "Use YieldProcessor() for accurate CPU wait, instead of Sleep(0)"
            FORCE_VSYNC_OFF             = 0x00040000, "Force VSYNC OFF if this bit is set."
            DISALLOWED                  = 0x00200000, "Per app disable bit"
            NO_LAG_OFFSET               = 0x00800000, "Do not apply offset to account for observed lag"
            ALLOW_SLEEP_WITH_REFLEX     = 0x02000000, "Allow sleep with Reflex"
            ACCURATE                    = 0x10000000, "Accurate setting of fps but higer CPU usage"
            ALLOW_WINDOWED              = 0x20000000, "Allow limiting of windowed applications"
            FORCEON                     = 0x40000000, "Force enable, ignore AC/DC status"
            ENABLED                     = 0x80000000, "Enabled"
            OPENGL_REMOTE_DESKTOP       = 0xe000003c, "Setting used for OpenGL Remote Desktop Sessions"
            LOW_LATENCY_DEFAULT         = 0xb0802000, "Setting used for low latency"
            MFR_FLAGS                   = 0xf0802000, "Setting used for max frame rate"
            GFN_FLAGS                   = 0xf2803000, "Setting used for GFN"
            MASK                        = 0xf2a433ff, "Mask of all bits used"
       END_ENUM_LIST
    Default: LOW_LATENCY_DEFAULT
END_KEY

BEGIN_KEY PS_FRAMERATE_LIMITER_GPS_CTRL
    DefinedWhen:    1
    BinaryID:       0x834f01
    RemappedName:   D3DOGL_70008600
    Type:           dword
    UserVisible
    NvInternalSetting
    UserVisibleName:    "Frame Rate Monitor"
    Documentation:      "FRM parameters (deprecated)"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED                    = 0x00000000, "Disabled"
            DECREASE_FILTER_MASK        = 0x000001FF, "*8 milliseconds"
            PAUSE_TIME_MASK             = 0x0000FE00, "*4 milliseconds"
            PAUSE_TIME_SHIFT            = 9, ""
            TARGET_RENDER_TIME_MASK     = 0x00FF0000, "percentage"
            TARGET_RENDER_TIME_SHIFT    = 16, ""
            PERF_STEP_SIZE_MASK         = 0x1F000000, "percentage"
            PERF_STEP_SIZE_SHIFT        = 24, ""
            INCREASE_FILTER_MASK        = 0xE0000000, "frames"
            INCREASE_FILTER_SHIFT       = 29, ""
            OPTIMAL_SETTING             = 0x4A5A3219, "Current optimal settings"
        END_ENUM_LIST
    Default: DISABLED
END_KEY

BEGIN_KEY PS_FRAMERATE_MONITOR_CTRL
    DefinedWhen:    1
    BinaryID:       0x834f05
    RemappedName:   D3DOGL_B0008600
    Type:           dword
    UserVisible
    NvInternalSetting
    UserVisibleName:    "Frame Rate Monitor Control"
    Documentation:      "FRM control parameters"
    Values: Bitfields
        BEGIN_ENUM_LIST
            DISABLED                   = 0x00000000, "Disabled"
            THRESHOLD_PCT_MASK         = 0x000000FF, "Trigger threshold in 0.01%"
            MOVING_AVG_X_MASK          = 0x00000F00, "Number of frames to apply moving average over"
            MOVING_AVG_X_SHIFT         = 8, ""
            VSYNC_OFFSET_MASK          = 0x0000F000, "offset to target in 0.25ms for VSYNC mode"
            VSYNC_OFFSET_SHIFT         = 12, ""
            FRL_OFFSET_MASK            = 0x000F0000, "offset to target in 0.25ms for FRL mode"
            FRL_OFFSET_SHIFT           = 16, ""
            FPS_USE_FRL                = 0x00000000, "Enable FRM only when FRL is enabled (default)"
            LOW_LATENCY_LOG            = 0x00100000, "Enable data collection for low latency."
            ALLOW_AUTOFL_WITH_REFLEX   = 0x00200000, "Allow AutoFL with Reflex"
            DISABLE_MAP_GPU_TIMER      = 0x00400000, "Use GPU Timer registers to get GPU timestamps"
            ENABLE_ON_VSYNC            = 0x00800000, "Enable FRM when (adaptive) VSYNC is ON"
            FPS_30                     = 0x1E000000, "Enable FRM at 30 FPS regardless of FRL"
            FPS_60                     = 0x3C000000, "Enable FRM at 60 FPS regardless of FRL"
            FPS_MASK                   = 0xFF000000, "Enable FRM at target FPS"
            FPS_SHIFT                  = 24, ""
            OPTIMAL_SETTING            = 0x00600364, "Optimal settings (no VSYNC mode)"
            OPTIMAL_SETTING_V2         = 0x00680364, "Optimal settings (no VSYNC mode) V2"
            VSYNC_OPTIMAL_SETTING      = 0x00E0f364, "Optimal settings (with VSYNC mode)"
            VSYNC_OPTIMAL_SETTING_V2   = 0x00E8f364, "Optimal settings (with VSYNC mode) V2"
        END_ENUM_LIST
    Default: OPTIMAL_SETTING
END_KEY

