            DISABLE_BLITS_ON_ASYNC_COMPUTE                       = 0x00000010, "Disable promoting blits to async compute stream for legacy apps SCG"
            FORCE_I2M_FOR_ASYNC_COMPUTE_BLITS                    = 0x00000020, "Force usage of in-compute class i2m for all async compute blits (Maxwell default)"
            FORCE_CE_FOR_ASYNC_COMPUTE_BLITS                     = 0x00000040, "Force usage of in-compute class CE for all async compute blits (Pascal+ default)"
            USE_HELPER_CH_FOR_PROGRESS_FORWARD                 = 0x00000080, "GR/CS reports thier own progress fences. Use this regkey to force legacy helper channel use" 
