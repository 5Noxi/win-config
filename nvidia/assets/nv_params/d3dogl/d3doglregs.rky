BEGIN_KEY WKS_MEMORY_ALLOCATION_POLICY
    DefinedWhen:           1
    BinaryID:              0x112233
    RemappedName:          D3DOGL_11223344
    Type:                  dword
    Documentation:         ""
    AppProfile
    UserVisible
    UserVisibleName:       "Memory Allocation Policy"
    OverInstallBehavior:   MERGE
    NeedsKernelNotification: 1
    Values: Samples:LimitValuesToList
    BEGIN_ENUM_LIST
        AS_NEEDED                                                                   = 0x0, "As Needed"
        MODERATE_PRE_ALLOCATION                                                     = 0x1, "Moderate pre-allocation"
        AGGRESSIVE_PRE_ALLOCATION                                                   = 0x2, "Aggressive pre-allocation"
    END_ENUM_LIST
    Default:            AS_NEEDED
END_KEY

BEGIN_KEY WKS_SCANOUT_COMPOSITION_CONTROL
    DefinedWhen:           1
    BinaryID:              0x112255
    RemappedName:          D3DOGL_WksScanoutCompositionControl
    Type:                  dword
    Documentation:         "NV private interface to enable/disable scanoutComposition features"
    OverInstallBehavior:   MERGE
    NeedsKernelNotification: 1
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF                                                   = 0x00000000, "No specific adjustments for scanoutComposition backend are selected"
            MULTIGPU_MOSAIC_UNICAST                               = 0x00000001, "If bit is set, scanoutComposition performs composition in unicast manner"
            MULTIGPU_MOSAIC_ALLOC_PACKING                         = 0x00000002, "If bit is set, scanoutComposition allocation is packed to save memory usage and unicasting is required (for RID 52174)"
            ENABLE_GAMMA_FOR_PER_PIXEL_INTENSITY                  = 0x00000004, "If bit is set, per pixel intensity operations on non-float allocations are performed in linear space by doing a de-gamma on reads and re-gamma on writes."
        END_ENUM_LIST
    Default:                                                        0x00000003, "MULTIGPU_MOSAIC_UNICAST + MULTIGPU_MOSAIC_ALLOC_PACKING"
END_KEY

BEGIN_KEY WKS_POST_PROCESSING_ENGINE_CONTROL
    DefinedWhen:           1
    BinaryID:              0x112256
    RemappedName:          D3DOGL_WksPostProcessingEngineControl
    Type:                  dword
    Documentation:         "NV private interface to adjust the behavior of the post processing engine"
    UserVisible
    UserVisibleName:       "Overlay Indicator"
    OverInstallBehavior:   MERGE
	NvInternalSetting
    NeedsKernelNotification: 1
    Values: Bitfields
        BEGIN_ENUM_LIST
            OFF                                                   = 0x00000000, "No specific adjustments for the post processing engine are selected"
            EXECUTE_ON_DWM                                        = 0x00000001, "If bit is set, post processing engine operations are executed on desktop compositor owned fullscreen buffers."
            EXECUTE_ON_NON_DWM                                    = 0x00000002, "If bit is set, post processing engine operations are executed fullscreen buffers no owned by the desktop compositor."
            USE_SCRATCH_MEMORY_AS_GPU_PROGRAM_STORAGE             = 0x00000004, "If bit is set, a global os hidden scratch framebuffer portion is used as gpu storage instead of context allocations."
            DRAW_ON_SCREEN_INDICATOR_DLDSR                        = 0x00000008, "If bit is set, an on screen indicator should be rendered for DLDSR on top of the executed post processing engine gpu program output."
            USE_DEVICE_RENDER_CHANNEL                             = 0x00000010, "If bit is set, 'If bit is set, the UMDs are instructed to schedule kernel assisted ppe work on the standard 3d render channel (this might not be supported by all umds)."
            USE_UMD_SHADER_RESOURCE                               = 0x00000020, "If bit is set, use shader resource allocated by UMD for gpu program storage. This overrides the USE_SCRATCH_MEMORY_AS_GPU_PROGRAM_STORAGE bit."
            DRAW_ON_SCREEN_INDICATOR_UPSCALE                      = 0x00000040, "If bit is set, draw an on-screen indicator for Upscale."
            MASK_FOR_ALL_CONTROLLED_BITS                          = 0xFFFF0000, "Combined mask bits for all potential mask bit controlled entries."
            MASK_FOR_EXECUTE_ON_DWM                               = 0x00010000, "EXECUTE_ON_DWM settings are just modified in case this mask bit is also set."
            MASK_FOR_EXECUTE_ON_NON_DWM                           = 0x00020000, "EXECUTE_ON_NON_DWM settings are just modified in case this mask bit is also set."
            MASK_FOR_USE_SCRATCH_MEMORY_AS_GPU_PROGRAM_STORAGE    = 0x00040000, "USE_SCRATCH_MEMORY_AS_GPU_PROGRAM_STORAGE settings are just modified in case this mask bit is also set."
            MASK_FOR_DRAW_ON_SCREEN_INDICATOR_DLDSR               = 0x00080000, "DRAW_ON_SCREEN_INDICATOR_DLDSR settings are just modified in case this mask bit is also set."
            MASK_FOR_USE_DEVICE_RENDER_CHANNEL                    = 0x00100000, "USE_DEVICE_RENDER_CHANNEL settings are just modified in case this mask bit is also set."
            MASK_FOR_USE_UMD_SHADER_RESOURCE                      = 0x00200000, "USE_UMD_SHADER_RESOURCE settings are just modified in case this mask bit is also set."
            MASK_FOR_DRAW_ON_SCREEN_INDICATOR_UPSCALE             = 0x00400000, "DRAW_ON_SCREEN_INDICATOR_UPSCALE settings are just modified in case this mask bit is also set."
        END_ENUM_LIST
    Default:                                                        0x00000033, "EXECUTE_ON_DWM + EXECUTE_ON_NON_DWM + USE_DEVICE_RENDER_CHANNEL + USE_UMD_SHADER_RESOURCE"
END_KEY

