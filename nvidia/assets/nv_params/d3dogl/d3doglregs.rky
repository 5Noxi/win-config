        BEGIN_ENUM_LIST
            OFF         = 0x00000000, "Feature disabled"
            CONTINUOUS  = 0x00000001, "Continuously dump BVHs"
            HOTKEY      = 0x00000002, "Trigger BVH dump using a hotkey (Can be changed with RTCORE_BVH_DUMP_HOTKEY. Default is ctrl+home)"
            SAVE_SYNC_CACHE = 0x00000003, "Save a BLAS-cache from a determinisic synchronous program."
            LOAD_SYNC_CACHE = 0x00000004, "Load a BLAS-cache in a determinisic synchronous program."
        END_ENUM_LIST
    Default: OFF
END_KEY

