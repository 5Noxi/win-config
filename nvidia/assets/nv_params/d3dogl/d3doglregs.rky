            YES, 1, ON,  ENABLED  = 1, "CUDA is used as the backend for RTCORE"
       END_ENUM_LIST
    Default:            YES
END_KEY

BEGIN_KEY RTCORE_EXCEPTION_FLAGS
    DefinedWhen:        1
    BinaryID:           0x001572
    RemappedName:       D3DOGL_0x001572
    Type:               dword
    Documentation:      "Override RTCORE default exception flags"
