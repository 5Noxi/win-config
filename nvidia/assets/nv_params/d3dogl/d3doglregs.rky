END_KEY

BEGIN_KEY FRL_LOW_LATENCY_PROACTIVE_FLUSH
    DefinedWhen:    1
    BinaryID:       0x835015
    RemappedName:   D3DOGL_00008618
    Type:           bool
    Documentation:  "Proactively flush the 3d pushbuffer once per frame to ensure a pre-present kickoff."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF,0,FALSE,DISABLED        = 0, "Disabled"
            ON,1,TRUE,ENABLED           = 1, "Enabled"
        END_ENUM_LIST
    Default:        FALSE
END_KEY

