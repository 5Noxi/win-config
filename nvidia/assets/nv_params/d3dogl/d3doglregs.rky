    RemappedName:       D3DOGL_24189123
    Type:               dword
    Documentation:      "aniso quality on tesla (aka NV50TexPerfSetting)"
    Values: Range
        BEGIN_ENUM_LIST
            MIN                                                             = 0x00000000, ""
            tpsNV30                                                         = 0x00000000, ""
            tpsNV40                                                         = 0x00000001, ""
            tpsDefault                                                      = 0x00000002, ""
            tpsAssertive                                                    = 0x00000003, ""
            tpsAggressive                                                   = 0x00000004, ""
            tpsFerocious                                                    = 0x00000005, ""
            tpsNSettings                                                    = 0x6, ""  // derived from an enum in nv50texperf.h
