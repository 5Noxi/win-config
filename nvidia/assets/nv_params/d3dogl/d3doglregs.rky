    RemappedName:       D3DOGL_0x001567
    Type:               string
    Documentation:      "String containing multiple knobs passed to RTcore. The format is JSON, with the following differences:  1) the enclosing '{' and '}' are omitted.  2) key identifiers don't have to be in quotes.  3) objects ('{','}') are not supported.  4) C and C++ style comments are supported. Example: 'pipeline.logLaunchDetails:true'"
    Default:            ""
END_KEY

