/*
    Three monitor technology modes - GSync, ULMB, Fixed Refrsh are mapped to ALLOW, ULMB and FIXED_REFRESH respectively.
*/
BEGIN_KEY VRR_APP_OVERRIDE
    DefinedWhen:        1
    BinaryID:           0xa879cf
    RemappedName:       D3DOGL_60461793
    Type:               dword
    Documentation:      "Profile-specific override. Overrides the VRR_MODE global setting"
    AppProfile
    UserVisible
    UserVisibleName:    "G-SYNC"
    OverInstallBehavior: MERGE
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            ALLOW                    = 0, "Honor the VRR_MODE setting,G-SYNC On"
            FORCE_OFF                = 1, "G-SYNC cannot be enabled for this app"
            DISALLOW                 = 2, "VRR off"
            ULMB                     = 3, "ULMB On"
            FIXED_REFRESH            = 4, "Fixed Refresh mode"
        END_ENUM_LIST
    Default: ALLOW
END_KEY

BEGIN_KEY VRR_WINDOWED_APP_OVERRIDE
    DefinedWhen:        1
    BinaryID:           0xa879ef
    RemappedName:       D3DOGL_60461797
    Type:               dword
    Documentation:      "Profile-specific override for windowed mode G-SYNC. Overrides the VRR_MODE global setting"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            ALLOW                    = 0, "Honor the VRR_MODE setting, windowed G-SYNC On"
            FORCE_OFF                = 1, "Winowed G-SYNC cannot be enabled for this app"
        END_ENUM_LIST
    Default: ALLOW
END_KEY

