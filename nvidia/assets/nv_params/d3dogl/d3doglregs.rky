BEGIN_KEY  QMD_OCC_THRESHOLD_SYNC
    DefinedWhen:        1
    BinaryID:           0x1e1068
    RemappedName:       D3DOGL_0x1e1068
    Type:               dword
    Documentation:      "Set Occupancy fields in the QMD to program the Low Occupancy Watermark for each resource specific to sync queue dispatches (VEID==0).  GA10x+ SMSCC feature. See http://nvbugs/2509750 for further details and FD link.  Regkey has 8 bits each for warp threshold, RF threshold, and ShM threshold respectively (ShM being the LSB).  Clamped to 128 by HW"
    Default:    0x104000
END_KEY

