BEGIN_KEY WKS_4PLUSGPUS_RESTRICT_SOURCES_IN_EXTENDEDVIEW
    DefinedWhen:        1
    BinaryID:           0xfbdf11
    RemappedName:       D3DOGL_0xfbdf11
    Type:               dword
    NeedsKernelNotification: 1
    UserVisible
