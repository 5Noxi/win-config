    NvInternalSetting
    Documentation:      "Number of Sources we can extend on Single GPU"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            SOURCE_ONE                  = 0x1, "One Source per GPU"
            SOURCE_TWO                  = 0x2, "Two Sources per GPU"
            SOURCE_THREE                = 0x3, "Three Sources per GPU"
            SOURCE_FOUR                 = 0x4, "Four Sources per GPU"
        END_ENUM_LIST
    Default:            SOURCE_ONE
END_KEY

BEGIN_KEY PS_REDUCTION_HACK_HASH_LIST
    DefinedWhen:        1
    BinaryID:           0xfa5840
    RemappedName:       D3DOGL_fa5840
    Type:               string
    Documentation:      "String for passing list of appHashes to turn reduction hack on for. '0x' 'delimited' eg: '0xbadcf00d0xdeadbeef'"
    Default: ""
END_KEY

BEGIN_KEY PS_REDUCTION_KNOBS_LIST
    DefinedWhen:        1
    BinaryID:           0xfa6640
    RemappedName:       D3DOGL_fa6640
    Type:               string
    Documentation:      "String for passing a list of per-shaderHash entries to control knobs related to reduction. ':' delimits each value, ';' delimits each entry. The entry format is 'ShaderHash:warpsPerSubtile:applyReductionHack:schedMaxRTarget;', with no space inbetween entries. All values must be 0x formatted hexadecimal e.g. 0x195f7f6c093b396b:0x8:0x1:0x0;0x2fa5375360b0cf54:0x8:0x1:0x0; (see NvShaderSpecificReduction12 for more details)"
    Default: ""
END_KEY

