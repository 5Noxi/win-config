            OFF, 0, FALSE, DISABLED  = 0, "off"
            ON,  1, TRUE,  ENABLED   = 1, "on"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY RTCORE_DISABLE_SMEM_SPILLS
    DefinedWhen:        1
    BinaryID:           0x001570
    RemappedName:       D3DOGL_0x001570
    Type:               bool
    Documentation:      "RTcore SMEM spilling policy. OFF = allow spills to SMEM, ON = disable spills to SMEM"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0x00000000, "Allow spills to SMEM"
            ON,  1, TRUE,  ENABLED   = 0x00000001, "Disable spills to SMEM"
        END_ENUM_LIST
    Default:            OFF
END_KEY

BEGIN_KEY RTCORE_USE_CUDA
    DefinedWhen:        1
    BinaryID:           0x001571
    RemappedName:       D3DOGL_0x001571
    Type:               bool
    Documentation:      "Use CUDA as the backend for rtcore"
