            NGX_DLSS_OVERRIDE_OPTIMAL_SETTINGS_NONE       = 0x0000, "No change to optimal rendering resolution."
            NGX_DLSS_OVERRIDE_OPTIMAL_SETTINGS_PERF_TO_9X = 0x0001, "Force DLSS to return 9X optimal rendering resolution instead of 4X in Perf mode."
        END_ENUM_LIST
    Default: NGX_DLSS_OVERRIDE_OPTIMAL_SETTINGS_NONE
END_KEY

