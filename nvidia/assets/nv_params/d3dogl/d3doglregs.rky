            NGX_DLSS_MODE_PERFORMANCE           = 0x0000, "Force DLSS to use perfomance mode."
            NGX_DLSS_MODE_BALANCED              = 0x0001, "Force DLSS to use balanced mode."
            NGX_DLSS_MODE_QUALITY               = 0x0002, "Force DLSS to use quality mode."
            NGX_DLSS_MODE_SNIPPET_CONTROLLED    = 0x0003, "Allow snippet to control DLSS mode. Default setting." 
        END_ENUM_LIST
