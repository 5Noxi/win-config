BEGIN_KEY RTCORE_PROFILING
    DefinedWhen:        defined(DEBUG) || defined(DEVELOP)
    BinaryID:           0x00156b
    RemappedName:       D3DOGL_0x00156b
    Type:               dword
    Documentation:      "RTcore profiling mode. Change dumping behavior using RTCORE_PROFILING_DUMP_MODE and RTCORE_PROFILING_DUMP_HOTKEY"
    Values: Bitfields
        BEGIN_ENUM_LIST
            NONE            = 0x00000000, "Feature disabled"
            STATEFUNC       = 0x00000001, "Dump state function profile to file"
            RAYS            = 0x00000002, "Dump ray data to file"
            LAUNCHBUFFER    = 0x00000004, "Dump launch buffer to file"
        END_ENUM_LIST
    Default: NONE
END_KEY

BEGIN_KEY RTCORE_PROFILING_ALLOCATION_SIZE
    DefinedWhen:        defined(DEBUG) || defined(DEVELOP)
    BinaryID:           0xe6cd57
    RemappedName:       D3DOGL_0xe6cd57
