            NINE_SECONDS         =    9,  "The popup will appear for 9 seconds"
            FIFTEEN_SECONDS      =   15,  "The popup will appear for 15 seconds"
            THIRTY_SECONDS       =   30,  "The popup will appear for 30 seconds"
            ONE_MINUTE           =   60,  "The popup will appear for 1 minute"
            TWO_MINUTES          =  120,  "The popup will appear for 2 minutes"
        END_ENUM_LIST
    Default:            DISABLED
END_KEY

