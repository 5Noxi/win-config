BEGIN_KEY EARLYZHYSTERESIS
    DefinedWhen:        PERF_STRATEGY_REGKEYS
    BinaryID:           0x73e558
    RemappedName:       D3DOGL_74095215
    Type:               dword
    Documentation:      "Tesla: value set directly in the NV5097_SET_EARLY_Z_HYSTERESIS method (sets hysteresis values for transitioning from LateZ mode to EarlyZ mode)\nFermi+\\DX10+: disables EarlyZ when LATEZ_ALWAYS is set"
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            INSTANTANEOUS       = 0x0, "Hardware makes instantaneous EarlyZ/LateZ decision based on current state"
            _16                 = 0x1, "Hardware waits 16 nvclk cycles before enabling EarlyZ mode"
            _32                 = 0x2, ""
            _64                 = 0x3, ""
            _128                = 0x4, ""
            _256                = 0x5, ""
            _512                = 0x6, ""
            _1024               = 0x7, ""
            _2048               = 0x8, ""
            _4096               = 0x9, ""
            _8192               = 0xa, ""
            _16384              = 0xb, ""
            _32768              = 0xc, ""
            _65536              = 0xd, ""
            LATEZ_INFINITE      = 0xe, "If mode settings force LateZ mode stay in LateZ mode forever"
            LATEZ_ALWAYS        = 0xf, "Always operate in LateZ mode"
        END_ENUM_LIST
END_KEY

