BEGIN_KEY FRL_LOW_LATENCY
    DefinedWhen:    1
    BinaryID:       0x835000
    RemappedName:   D3DOGL_00008603
    Type:           bool
    UserVisible
    UserVisibleName:    "FRL Low Latency"
    NvInternalSetting
    Documentation:  "Cap FPS just below GPU render time to reduce latency. DX9+DX11 supported."
    OverInstallBehavior: MERGE
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED, PASSIVE = 0x00000000, ""
            ON,  1, TRUE,  ENABLED           = 0x00000001, ""
        END_ENUM_LIST
    Default: OFF
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_BUFFER
    DefinedWhen:    1
    BinaryID:       0x835001
    RemappedName:   D3DOGL_00008604
    Type:           dword
    Documentation:  "Buffer time above GPU render time to limit FPS in microseconds. Default 800 (0.8ms)."
    Default: 800
END_KEY

BEGIN_KEY FRL_LOW_LATENCY_BUFFER_MAX
    DefinedWhen:    1
    BinaryID:       0x83501f
    RemappedName:   D3DOGL_00008647
    Type:           dword
    Documentation:  "Maximum buffer time in microseconds. Default 1500 (1.5ms)"
    Default:        1500
END_KEY

