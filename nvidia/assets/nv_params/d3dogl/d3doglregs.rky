BEGIN_KEY RTCORE_DEFAULT_CACHE_CONFIG
    DefinedWhen:        1
    BinaryID:           0x00156d
    RemappedName:       D3DOGL_0x00156d
    Type:               dword
    Documentation:      "RTcore default L1/SMEM cache configuration. Does not work with Turing SM-SCG. Individual kernels may override this."
    Values:             Samples:LimitValuesToList
    BEGIN_ENUM_LIST
        PREFER_NONE     = 0x00000000, "No preference for shared memory or L1"
        PREFER_SHARED   = 0x00000001, "Prefer larger shared memory and smaller L1 cache"
        PREFER_L1       = 0x00000002, "Prefer larger L1 cache and smaller shared memory"
        PREFER_EQUAL    = 0x00000003, "Prefer equal sized L1 cache and shared memory"
    END_ENUM_LIST
    Default:            PREFER_NONE
END_KEY

BEGIN_KEY RTCORE_DUMP_MODULE_CUBINS
    DefinedWhen:        1
    BinaryID:           0x00156e
    RemappedName:       D3DOGL_0x00156e
    Type:               bool
    Documentation:      "Dump CUBINs of compiled raytracing shaders to file. Will not dump internal modules such as traversers or schedulers."
    Values: Samples:LimitValuesToList
        BEGIN_ENUM_LIST
            OFF, 0, FALSE, DISABLED  = 0, "off"
            ON,  1, TRUE,  ENABLED   = 1, "on"
        END_ENUM_LIST
    Default:            OFF
END_KEY

